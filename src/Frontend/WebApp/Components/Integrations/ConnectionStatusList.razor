@using BuildingBlocks.Domain.Primitives
@using global::Integrations.Application.OAuth.DTOs
@using WebApp.Services
@inject IOAuthIntegrationsClientService OAuthClient

<div class="connection-status-panel" data-testid="connection-status-panel">
    <div class="panel-header">
        <div>
            <h3 class="panel-title">Conexões de Mídia & Saúde das Credenciais</h3>
            <p class="panel-subtitle">Monitoramento de integridade dos tokens OAuth2 das redes de anúncios conectadas ao workspace.</p>
        </div>
        <div class="panel-actions">
            <button class="btn btn-outline-primary"
                    data-testid="btn-refresh-tokens"
                    @onclick="HandleRefreshExpiringTokens"
                    disabled="@_isRefreshing">
                @if (_isRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Renovando...</span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <span>Renovar Credenciais Imediatamente</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="alert @(_isSuccessFeedback ? "alert-success" : "alert-danger") alert-dismissible fade show mt-3" role="alert" data-testid="feedback-alert">
            <span>@_feedbackMessage</span>
            <button type="button" class="btn-close" @onclick="() => _feedbackMessage = null" aria-label="Fechar"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading-state text-center py-5" data-testid="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando conexões...</span>
            </div>
            <p class="mt-2 text-muted">Consultando status das redes conectadas...</p>
        </div>
    }
    else
    {
        <div class="platforms-grid mt-4">
            @foreach (var platform in _standardPlatforms)
            {
                var connection = _connections.FirstOrDefault(c => c.Platform.Equals(platform.Key, StringComparison.OrdinalIgnoreCase));
                var statusInfo = ResolveStatus(connection);

                <div class="platform-card card @statusInfo.CardClass" data-testid="platform-card-@platform.Key.ToLowerInvariant()">
                    <div class="card-body">
                        <div class="platform-header d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="platform-icon @platform.Key.ToLowerInvariant()">
                                    <i class="@platform.Value.IconClass"></i>
                                </span>
                                <h5 class="platform-name mb-0">@platform.Value.DisplayName</h5>
                            </div>
                            <span class="badge @statusInfo.BadgeClass" data-testid="badge-status">
                                @statusInfo.Label
                            </span>
                        </div>

                        <div class="platform-details mt-3">
                            @if (connection != null && !string.IsNullOrWhiteSpace(connection.Status))
                            {
                                <div class="detail-row">
                                    <span class="detail-label">Conta:</span>
                                    <span class="detail-value text-truncate">@(connection.ExternalAccountName ?? connection.ExternalAccountId ?? "Vinculada")</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Expiração:</span>
                                    <span class="detail-value">
                                        @if (connection.AccessTokenExpiresAtUtc.HasValue)
                                        {
                                            @connection.AccessTokenExpiresAtUtc.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span>Sem expiração definida</span>
                                        }
                                    </span>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Rede não configurada para este workspace.</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    private bool _isLoading = true;
    private bool _isRefreshing = false;
    private string? _feedbackMessage;
    private bool _isSuccessFeedback;
    private List<OAuthConnectionStatusDto> _connections = new();

    private readonly Dictionary<string, (string DisplayName, string IconClass)> _standardPlatforms = new(StringComparer.OrdinalIgnoreCase)
    {
        ["MetaAds"] = ("Meta Ads", "bi bi-facebook"),
        ["GoogleAds"] = ("Google Ads", "bi bi-google"),
        ["TikTokAds"] = ("TikTok Ads", "bi bi-tiktok"),
        ["BingAds"] = ("Microsoft Advertising", "bi bi-microsoft")
    };

    protected override async Task OnParametersSetAsync()
    {
        await LoadConnectionsStatusAsync();
    }

    private async Task LoadConnectionsStatusAsync()
    {
        if (WorkspaceId == Guid.Empty)
        {
            _isLoading = false;
            return;
        }

        _isLoading = true;
        var result = await OAuthClient.GetConnectionsStatusAsync(WorkspaceId);
        if (result.IsSuccess)
        {
            _connections = result.Value.ToList();
        }
        else
        {
            _feedbackMessage = result.Error.Description;
            _isSuccessFeedback = false;
        }
        _isLoading = false;
    }

    private async Task HandleRefreshExpiringTokens()
    {
        _isRefreshing = true;
        _feedbackMessage = null;

        var result = await OAuthClient.RefreshExpiringTokensAsync();
        if (result.IsSuccess)
        {
            _feedbackMessage = $"Credenciais renovadas com sucesso! {result.Value} token(s) atualizado(s).";
            _isSuccessFeedback = true;
            await LoadConnectionsStatusAsync();
        }
        else
        {
            _feedbackMessage = $"Falha na renovação: {result.Error.Description}";
            _isSuccessFeedback = false;
        }

        _isRefreshing = false;
    }

    private static (string Label, string BadgeClass, string CardClass) ResolveStatus(OAuthConnectionStatusDto? connection)
    {
        if (connection == null || string.IsNullOrWhiteSpace(connection.Status))
        {
            return ("Não Conectado", "bg-secondary text-light", "border-secondary-subtle");
        }

        if (string.Equals(connection.Status, "Expired", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(connection.Status, "Revoked", StringComparison.OrdinalIgnoreCase))
        {
            return ("Expirado / Inválido", "bg-danger text-light", "border-danger");
        }

        if (connection.IsExpiringSoon)
        {
            return ("Expira em Breve", "bg-warning text-dark", "border-warning");
        }

        return ("Válido & Ativo", "bg-success text-light", "border-success");
    }
}
