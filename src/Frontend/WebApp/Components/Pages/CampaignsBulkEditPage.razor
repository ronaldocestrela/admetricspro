@page "/campaigns/bulk"
@page "/workspaces/{WorkspaceId:guid}/campaigns/bulk"
@layout TenantMainLayout
@using global::Integrations.Application.Campaigns.DTOs
@using WebApp.Components.Campaigns
@using WebApp.Components.Layout
@using WebApp.Services
@using WebApp.State
@implements IDisposable

<PageTitle>Operações em Massa — AdMetricsPro</PageTitle>

<div class="bulk-page-container">
    <div class="page-top-bar">
        <a href="/workspaces" class="btn-back"><i class="bi bi-arrow-left"></i> Voltar aos Workspaces</a>
    </div>

    @if (IsLoading)
    {
        <div class="loading-state" data-testid="loading-state">
            <div class="spinner"></div>
            <span>Carregando campanhas do workspace...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-banner" data-testid="error-banner">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@ErrorMessage</span>
            <button type="button" class="btn-retry" @onclick="LoadCampaignsAsync">Tentar Novamente</button>
        </div>
    }
    else if (_activeWorkspaceId == Guid.Empty)
    {
        <div class="info-banner">
            <p>Nenhum cliente (workspace) selecionado. Por favor, selecione um cliente no cabeçalho ou cadastre um novo cliente.</p>
            <a href="/workspaces" class="btn-primary">Ir para Clientes (Workspaces)</a>
        </div>
    }
    else
    {
        <BulkCampaignEditorMatrix WorkspaceId="_activeWorkspaceId" Campaigns="CampaignsList" OnBulkOperationCompleted="LoadCampaignsAsync" />
    }
</div>

@code {
    /// <summary>
    /// Identificador do Workspace vindo da rota.
    /// </summary>
    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Inject]
    public IBulkCampaignClientService BulkClientService { get; set; } = default!;

    [Inject]
    public IWorkspaceContextStateProvider WorkspaceContextStateProvider { get; set; } = default!;

    [Inject]
    public IWorkspaceClientService WorkspaceClientService { get; set; } = default!;

    [Inject]
    public ITenantSessionStateProvider TenantSessionStateProvider { get; set; } = default!;

    private Guid _activeWorkspaceId;

    public bool IsLoading { get; set; } = true;
    public string? ErrorMessage { get; set; }
    public IReadOnlyList<CampaignHierarchyDto> CampaignsList { get; set; } = Array.Empty<CampaignHierarchyDto>();

    protected override async Task OnInitializedAsync()
    {
        TenantSessionStateProvider.OnSessionChanged += HandleSessionChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged += HandleWorkspaceChanged;
        await ResolveWorkspaceAndLoadAsync();
    }

    private async Task ResolveWorkspaceAndLoadAsync()
    {
        if (WorkspaceId != Guid.Empty)
        {
            _activeWorkspaceId = WorkspaceId;
            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(WorkspaceId, null);
        }
        else if (WorkspaceContextStateProvider.CurrentWorkspaceId.HasValue && WorkspaceContextStateProvider.CurrentWorkspaceId.Value != Guid.Empty)
        {
            _activeWorkspaceId = WorkspaceContextStateProvider.CurrentWorkspaceId.Value;
        }
        else
        {
            try
            {
                var wsRes = await WorkspaceClientService.GetWorkspacesAsync();
                if (wsRes.IsSuccess && wsRes.Value.Count > 0)
                {
                    _activeWorkspaceId = wsRes.Value[0].Id;
                    await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(_activeWorkspaceId, wsRes.Value[0].Name);
                }
            }
            catch
            {
                // Silencioso
            }
        }

        if (_activeWorkspaceId != Guid.Empty)
        {
            await LoadCampaignsAsync();
        }
        else
        {
            IsLoading = false;
        }
    }

    private void HandleWorkspaceChanged()
    {
        var contextId = WorkspaceContextStateProvider.CurrentWorkspaceId;
        if (contextId.HasValue && contextId.Value != Guid.Empty && contextId.Value != _activeWorkspaceId)
        {
            _activeWorkspaceId = contextId.Value;
            InvokeAsync(async () =>
            {
                await LoadCampaignsAsync();
                StateHasChanged();
            });
        }
    }

    public async Task LoadCampaignsAsync()
    {
        if (_activeWorkspaceId == Guid.Empty)
        {
            IsLoading = false;
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var result = await BulkClientService.GetCampaignsForBulkAsync(_activeWorkspaceId);
            if (result.IsSuccess)
            {
                CampaignsList = result.Value;
            }
            else
            {
                ErrorMessage = result.Error.Description;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro inesperado ao carregar campanhas: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(async () =>
        {
            await ResolveWorkspaceAndLoadAsync();
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public void Dispose()
    {
        TenantSessionStateProvider.OnSessionChanged -= HandleSessionChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged -= HandleWorkspaceChanged;
    }
}
