@page "/copilot"
@page "/workspaces/{WorkspaceId:guid}/copilot"
@layout TenantMainLayout
@using Analytics.Application.Copilot.DTOs
@using Tenants.Application.Workspaces.DTOs
@using WebApp.Components.Copilot
@using WebApp.Components.Layout
@using WebApp.Services
@using WebApp.Services.Copilot
@using WebApp.State
@implements IDisposable
@inject ITrafficCopilotClientService CopilotService
@inject IWorkspaceClientService WorkspaceService
@inject ITenantStateProvider TenantStateProvider
@inject ITenantSessionStateProvider TenantSessionStateProvider
@inject IWorkspaceContextStateProvider WorkspaceContextStateProvider
@inject NavigationManager Navigation

<div class="copilot-page-container">
    <div class="copilot-page-header">
        <div class="header-left">
            <h1 class="page-title">Copiloto de Otimização via IA</h1>
            <p class="page-subtitle">Auditor autônomo de tráfego pago, detecção de sobreposições, canibalização de termos e ações em 1 clique.</p>
        </div>

        <div class="header-right">
            @if (Workspaces != null && Workspaces.Count > 0)
            {
                <select class="workspace-selector" id="copilot-workspace-select" @onchange="OnWorkspaceChanged" value="@SelectedWorkspaceId">
                    @foreach (var ws in Workspaces)
                    {
                        <option value="@ws.Id">@ws.Name</option>
                    }
                </select>
            }

            <button class="btn-refresh" id="btn-refresh-copilot" @onclick="LoadDiagnosticAsync" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>🔄 Atualizar Auditoria</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" id="copilot-error-banner">
            @ErrorMessage
        </div>
    }

    @if (Workspaces != null && Workspaces.Count == 0)
    {
        <div class="empty-anomalies-state" id="copilot-no-workspaces" data-testid="copilot-empty-workspaces">
            <span class="empty-icon">📁</span>
            <h3>Nenhum cliente/workspace cadastrado</h3>
            <p>Cadastre ao menos um workspace para auditar métricas e detecção de anomalias no Copiloto.</p>
        </div>
    }

    @if (IsLoading && DiagnosticReport == null)
    {
        <div class="loading-state" id="copilot-loading-skeleton">
            <div class="spinner-border text-primary" role="status"></div>
            <p>O Copiloto está analisando leilões, segmentações e métricas...</p>
        </div>
    }
    else if (DiagnosticReport != null)
    {
        <CopilotDailySummaryCard Report="@DiagnosticReport" />

        <div class="anomalies-section">
            <div class="section-sub-header">
                <h2 class="section-title">Anomalias Operacionais & Ações Recomendadas</h2>
                <span class="anomalies-count">
                    @(DiagnosticReport.AudienceOverlapAnomalies.Count + DiagnosticReport.SearchCannibalizationAnomalies.Count) ocorrências identificadas
                </span>
            </div>

            @if (DiagnosticReport.AudienceOverlapAnomalies.Count == 0 && DiagnosticReport.SearchCannibalizationAnomalies.Count == 0)
            {
                <div class="empty-anomalies-state" id="copilot-no-anomalies">
                    <span class="empty-icon">🛡️</span>
                    <h3>Nenhum atrito de leilão ou conflito ativo detectado!</h3>
                    <p>Seus públicos e termos de busca estão devidamente isolados sem sobreposição destrutiva.</p>
                </div>
            }
            else
            {
                @foreach (var overlap in DiagnosticReport.AudienceOverlapAnomalies)
                {
                    <CopilotAnomalyCard Title="Sobreposição de Públicos (Meta Ads)"
                                        Severity="@overlap.Severity"
                                        Description="@overlap.Description"
                                        OverlapAnomaly="@overlap"
                                        Action="@overlap.SuggestedAction"
                                        OnExecuteAction="@(action => HandleExecuteActionAsync(action))" />
                }

                @foreach (var cannibalization in DiagnosticReport.SearchCannibalizationAnomalies)
                {
                    <CopilotAnomalyCard Title="Canibalização de Termos (Google Ads vs. Bing Ads)"
                                        Severity="@cannibalization.Severity"
                                        Description="@cannibalization.Description"
                                        CannibalizationAnomaly="@cannibalization"
                                        Action="@cannibalization.SuggestedAction"
                                        OnExecuteAction="@(action => HandleExecuteActionAsync(action))" />
                }
            }
        </div>
    }
</div>

<style>
    .copilot-page-container {
        padding: 24px;
        max-width: 1280px;
        margin: 0 auto;
        color: #f8fafc;
    }
    .copilot-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }
    .page-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
    }
    .page-subtitle {
        font-size: 0.95rem;
        color: #94a3b8;
        margin: 4px 0 0;
    }
    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .workspace-selector {
        background: rgba(30, 41, 59, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.2);
        color: #f8fafc;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    .btn-refresh {
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #60a5fa;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
    .btn-refresh:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.25);
    }
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        color: #94a3b8;
    }
    .section-sub-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 32px 0 16px;
    }
    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
    }
    .anomalies-count {
        font-size: 0.85rem;
        color: #94a3b8;
    }
    .empty-anomalies-state {
        text-align: center;
