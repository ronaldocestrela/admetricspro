</style>

@code {
    /// <summary>
    /// Identificador do workspace fornecido na rota.
    /// </summary>
    [Parameter]
    public Guid WorkspaceId { get; set; }

    private Guid SelectedWorkspaceId { get; set; }
    private IReadOnlyList<WorkspaceDto>? Workspaces { get; set; }
    private DailyDiagnosticReportDto? DiagnosticReport { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        TenantSessionStateProvider.OnSessionChanged += HandleSessionChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged += HandleContextWorkspaceChanged;

        await LoadWorkspacesAsync();

        if (WorkspaceId != Guid.Empty)
        {
            SelectedWorkspaceId = WorkspaceId;
            var wsName = Workspaces?.FirstOrDefault(w => w.Id == WorkspaceId)?.Name;
            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(WorkspaceId, wsName);
        }
        else if (WorkspaceContextStateProvider.CurrentWorkspaceId.HasValue && WorkspaceContextStateProvider.CurrentWorkspaceId.Value != Guid.Empty)
        {
            SelectedWorkspaceId = WorkspaceContextStateProvider.CurrentWorkspaceId.Value;
        }
        else if (Workspaces != null && Workspaces.Count > 0)
        {
            SelectedWorkspaceId = Workspaces[0].Id;
            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(SelectedWorkspaceId, Workspaces[0].Name);
        }

        if (SelectedWorkspaceId != Guid.Empty)
        {
            await LoadDiagnosticAsync();
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!TenantSessionStateProvider.IsAuthenticated)
            {
                var restored = await TenantSessionStateProvider.RestoreSessionAsync();
                if (restored)
                {
                    await WorkspaceContextStateProvider.RestoreActiveWorkspaceAsync();
                    await LoadWorkspacesAsync();

                    if (Workspaces != null && Workspaces.Count > 0)
                    {
                        if (WorkspaceContextStateProvider.CurrentWorkspaceId.HasValue &&
                            Workspaces.Any(w => w.Id == WorkspaceContextStateProvider.CurrentWorkspaceId.Value))
                        {
                            SelectedWorkspaceId = WorkspaceContextStateProvider.CurrentWorkspaceId.Value;
                        }
                        else
                        {
                            SelectedWorkspaceId = Workspaces[0].Id;
                            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(SelectedWorkspaceId, Workspaces[0].Name);
                        }
                    }

                    if (SelectedWorkspaceId != Guid.Empty)
                    {
                        await LoadDiagnosticAsync();
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private void HandleContextWorkspaceChanged()
    {
        InvokeAsync(async () =>
        {
            var contextWsId = WorkspaceContextStateProvider.CurrentWorkspaceId;
            if (contextWsId.HasValue && contextWsId.Value != Guid.Empty && contextWsId.Value != SelectedWorkspaceId)
            {
                SelectedWorkspaceId = contextWsId.Value;
                await LoadDiagnosticAsync();
                StateHasChanged();
            }
        });
    }

    private async Task LoadWorkspacesAsync()
    {
        try
        {
            var result = await WorkspaceService.GetWorkspacesAsync();
            if (result.IsSuccess)
            {
                Workspaces = result.Value;
            }
        }
        catch
        {
            // Silencioso ou fallback
        }
    }

    private async Task OnWorkspaceChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var wsId))
        {
            SelectedWorkspaceId = wsId;
            var wsName = Workspaces?.FirstOrDefault(w => w.Id == wsId)?.Name;
            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(wsId, wsName);
            await LoadDiagnosticAsync();
        }
    }

    private async Task LoadDiagnosticAsync()
    {
        if (SelectedWorkspaceId == Guid.Empty)
        {
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var result = await CopilotService.GetDailyDiagnosticAsync(SelectedWorkspaceId);
            if (result.IsSuccess)
            {
                DiagnosticReport = result.Value;
            }
            else
            {
                ErrorMessage = result.Error.Description;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Falha ao carregar auditoria: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleExecuteActionAsync(CopilotRecommendationActionDto action)
    {
        if (SelectedWorkspaceId == Guid.Empty || action == null)
        {
            return;
        }

        var result = await CopilotService.ExecuteActionAsync(SelectedWorkspaceId, action);
        if (!result.IsSuccess)
        {
            throw new InvalidOperationException(result.Error.Description);
        }
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadWorkspacesAsync();
            if (Workspaces != null && Workspaces.Count > 0)
            {
                if (WorkspaceContextStateProvider.CurrentWorkspaceId.HasValue &&
                    Workspaces.Any(w => w.Id == WorkspaceContextStateProvider.CurrentWorkspaceId.Value))
                {
                    SelectedWorkspaceId = WorkspaceContextStateProvider.CurrentWorkspaceId.Value;
                }
                else if (SelectedWorkspaceId == Guid.Empty || !Workspaces.Any(w => w.Id == SelectedWorkspaceId))
                {
                    SelectedWorkspaceId = Workspaces[0].Id;
                    await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(SelectedWorkspaceId, Workspaces[0].Name);
                }
            }
            if (SelectedWorkspaceId != Guid.Empty)
            {
                await LoadDiagnosticAsync();
            }
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public void Dispose()
    {
        TenantSessionStateProvider.OnSessionChanged -= HandleSessionChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged -= HandleContextWorkspaceChanged;
    }
}
