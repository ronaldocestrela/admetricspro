@using Analytics.Application.Reports.DTOs

@if (IsOpen)
{
    <div class="modal-backdrop fade show" style="background: rgba(15, 23, 42, 0.7); position: fixed; inset: 0; z-index: 1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; background: #ffffff;">
                <div class="modal-header border-bottom px-4 py-3" style="background: #f8fafc; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h5 class="modal-title fw-bold text-dark mb-0">
                        <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                        Gerar Relatório Executivo Sob Demanda
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @ErrorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Título do Relatório</label>
                        <input type="text" class="form-control" placeholder="ex: Relatório de Performance - Março" @bind="Title" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-muted">Data Inicial *</label>
                            <input type="date" class="form-control" @bind="StartDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-muted">Data Final *</label>
                            <input type="date" class="form-control" @bind="EndDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Observação Estratégica</label>
                        <textarea class="form-control" rows="2" placeholder="Comentários sobre a entrega de resultados..." @bind="CustomNotes"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Expiração do Link Interativo (dias)</label>
                        <input type="number" class="form-control" min="1" max="365" @bind="ExpirationDays" />
                    </div>

                    <div class="d-flex flex-column gap-2 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="genChkCopilot" @bind="IncludeCopilot">
                            <label class="form-check-label small" for="genChkCopilot">Incluir Diagnósticos do Copiloto IA</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="genChkCreatives" @bind="IncludeCreatives">
                            <label class="form-check-label small" for="genChkCreatives">Incluir Galeria de Top Criativos</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4" @onclick="GenerateAsync" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Compilando...</span>
                        }
                        else
                        {
                            <i class="bi bi-magic me-1"></i>
                            <span>Gerar Agora</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<GenerateReportRequest> OnGenerate { get; set; }

    public string Title { get; set; } = "Relatório de Desempenho";
    public DateTime StartDate { get; set; } = DateTime.UtcNow.AddDays(-14).Date;
    public DateTime EndDate { get; set; } = DateTime.UtcNow.Date;
    public string? CustomNotes { get; set; }
    public int ExpirationDays { get; set; } = 30;
    public bool IncludeCopilot { get; set; } = true;
    public bool IncludeCreatives { get; set; } = true;
    public string? ErrorMessage { get; set; }
    public bool IsSubmitting { get; set; }

    public void Open()
    {
        Title = "Relatório Executivo de Desempenho";
        StartDate = DateTime.UtcNow.AddDays(-14).Date;
        EndDate = DateTime.UtcNow.Date;
        CustomNotes = null;
        ExpirationDays = 30;
        IncludeCopilot = true;
        IncludeCreatives = true;
        ErrorMessage = null;
        IsSubmitting = false;
    }

    private async Task GenerateAsync()
    {
        if (EndDate < StartDate)
        {
            ErrorMessage = "A data final deve ser igual ou posterior à data inicial.";
            return;
        }

        var request = new GenerateReportRequest(
            Title: Title,
            StartDateUtc: StartDate,
            EndDateUtc: EndDate.AddDays(1).AddTicks(-1),
            CustomNotes: CustomNotes,
            IncludeCopilotInsights: IncludeCopilot,
            IncludeTopCreatives: IncludeCreatives,
            IncludeChannelBreakdown: true,
            IncludePacingSummary: true,
            ExpirationDays: ExpirationDays);

        IsSubmitting = true;
        ErrorMessage = null;
        try
        {
            await OnGenerate.InvokeAsync(request);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
