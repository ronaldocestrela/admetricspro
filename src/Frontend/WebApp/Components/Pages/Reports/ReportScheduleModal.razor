@using Analytics.Application.Reports.DTOs
@using BuildingBlocks.Domain.Reports
@using WebApp.Models

@if (IsOpen)
{
    <div class="modal-backdrop fade show" style="background: rgba(15, 23, 42, 0.7); position: fixed; inset: 0; z-index: 1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; background: #ffffff;">
                <div class="modal-header border-bottom px-4 py-3" style="background: #f8fafc; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h5 class="modal-title fw-bold text-dark mb-0">
                        <i class="bi bi-calendar2-week text-primary me-2"></i>
                        @(EditingScheduleId.HasValue ? "Editar Agendamento de Relatório" : "Novo Agendamento de Relatório White-Label")
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto;">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @ErrorMessage
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small text-muted">Nome do Agendamento *</label>
                            <input type="text" class="form-control" placeholder="ex: Relatório Semanal Executivo" @bind="FormModel.Name" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-muted">Periodicidade *</label>
                            <select class="form-select" @bind="FormModel.Frequency">
                                <option value="@ReportFrequency.Daily">Diário</option>
                                <option value="@ReportFrequency.Weekly">Semanal</option>
                                <option value="@ReportFrequency.Monthly">Mensal</option>
                            </select>
                        </div>

                        @if (FormModel.Frequency == ReportFrequency.Weekly)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-muted">Dia da Semana *</label>
                                <select class="form-select" @bind="FormModel.DayOfWeek">
                                    <option value="@DayOfWeek.Monday">Segunda-feira</option>
                                    <option value="@DayOfWeek.Tuesday">Terça-feira</option>
                                    <option value="@DayOfWeek.Wednesday">Quarta-feira</option>
                                    <option value="@DayOfWeek.Thursday">Quinta-feira</option>
                                    <option value="@DayOfWeek.Friday">Sexta-feira</option>
                                    <option value="@DayOfWeek.Saturday">Sábado</option>
                                    <option value="@DayOfWeek.Sunday">Domingo</option>
                                </select>
                            </div>
                        }

                        @if (FormModel.Frequency == ReportFrequency.Monthly)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-muted">Dia do Mês (1 a 31) *</label>
                                <input type="number" class="form-control" min="1" max="31" @bind="FormModel.DayOfMonth" />
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Horário UTC de Envio *</label>
                            <input type="text" class="form-control" placeholder="08:00" @bind="FormModel.ScheduledTime" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Janela de Métricas *</label>
                            <select class="form-select" @bind="FormModel.DateRangeType">
                                <option value="@ReportDateRangeType.Last7Days">Últimos 7 dias</option>
                                <option value="@ReportDateRangeType.Last14Days">Últimos 14 dias</option>
                                <option value="@ReportDateRangeType.Last30Days">Últimos 30 dias</option>
                                <option value="@ReportDateRangeType.PreviousMonth">Mês Anterior Fechado</option>
                                <option value="@ReportDateRangeType.MonthToDate">Mês Atual até Hoje</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Formatos de Saída</label>
                            <select class="form-select" @bind="FormModel.OutputFormat">
                                <option value="@ReportOutputFormat.Both">Link Web Interativo + PDF</option>
                                <option value="@ReportOutputFormat.InteractiveWebLink">Apenas Link Web Interativo</option>
                                <option value="@ReportOutputFormat.Pdf">Apenas Documento PDF</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Canais de Entrega</label>
                            <select class="form-select" @bind="FormModel.DeliveryChannels">
                                <option value="@ReportDeliveryChannel.Both">E-mail e WhatsApp</option>
                                <option value="@ReportDeliveryChannel.Email">Apenas E-mail</option>
                                <option value="@ReportDeliveryChannel.WhatsApp">Apenas WhatsApp</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-muted">Título Customizado no Relatório (Opcional)</label>
                            <input type="text" class="form-control" placeholder="ex: Performance de Tráfego - Loja Modelo" @bind="FormModel.CustomTitle" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-muted">Observação Estratégica da Agência (Opcional)</label>
                            <textarea class="form-control" rows="2" placeholder="Nota executiva que será exibida no relatório para o cliente..." @bind="FormModel.CustomNotes"></textarea>
                        </div>

                        <!-- Seções Habilitadas -->
                        <div class="col-12 mt-3">
                            <label class="form-label fw-semibold small text-muted d-block">Módulos Inclusos no Relatório</label>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkChannel" @bind="FormModel.IncludeChannelBreakdown">
                                    <label class="form-check-label small" for="chkChannel">Detalhamento por Canal</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkCreatives" @bind="FormModel.IncludeTopCreatives">
                                    <label class="form-check-label small" for="chkCreatives">Top Criativos &amp; Fadiga</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkCopilot" @bind="FormModel.IncludeCopilotInsights">
                                    <label class="form-check-label small" for="chkCopilot">Diagnóstico Copiloto IA</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkPacing" @bind="FormModel.IncludePacingSummary">
                                    <label class="form-check-label small" for="chkPacing">Budget Pacing</label>
                                </div>
                            </div>
                        </div>

                        <!-- Destinatários -->
                        <div class="col-12 mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold small text-muted mb-0">Destinatários do Relatório</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRecipient">
                                    <i class="bi bi-plus-circle me-1"></i> Adicionar Destinatário
                                </button>
                            </div>

                            @if (FormModel.Recipients.Count == 0)
                            {
                                <div class="text-muted small border rounded p-3 text-center bg-light">
                                    Nenhum destinatário adicionado. Clique em "Adicionar Destinatário" para configurar e-mails ou números de WhatsApp.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive border rounded">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light small">
                                            <tr>
                                                <th>Nome</th>
                                                <th>Canal</th>
                                                <th>Destino (E-mail ou Telefone)</th>
                                                <th style="width: 50px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < FormModel.Recipients.Count; i++)
                                            {
                                                var index = i;
                                                var r = FormModel.Recipients[index];
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm" placeholder="Nome do contato" @bind="r.Name" />
                                                    </td>
                                                    <td style="width: 130px;">
                                                        <select class="form-select form-select-sm" @bind="r.Channel">
                                                            <option value="@ReportDeliveryChannel.Email">E-mail</option>
                                                            <option value="@ReportDeliveryChannel.WhatsApp">WhatsApp</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm" placeholder="@(r.Channel == ReportDeliveryChannel.Email ? "cliente@empresa.com" : "+55 11 99999-8888")" @bind="r.Destination" />
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveRecipient(index)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4" @onclick="SaveAsync" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <span>@(EditingScheduleId.HasValue ? "Salvar Alterações" : "Criar Agendamento")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid? EditingScheduleId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CreateReportScheduleRequest> OnSave { get; set; }

    public ReportScheduleFormModel FormModel { get; set; } = new();
    public string? ErrorMessage { get; set; }
    public bool IsSubmitting { get; set; }

    public void OpenForCreate()
    {
        EditingScheduleId = null;
        ErrorMessage = null;
        FormModel = new ReportScheduleFormModel
        {
            Name = "Relatório Semanal de Desempenho",
            Frequency = ReportFrequency.Weekly,
            DayOfWeek = DayOfWeek.Monday,
            ScheduledTime = "08:00",
            DateRangeType = ReportDateRangeType.Last7Days,
            OutputFormat = ReportOutputFormat.Both,
            DeliveryChannels = ReportDeliveryChannel.Both,
            IncludeCopilotInsights = true,
            IncludeTopCreatives = true,
            IncludeChannelBreakdown = true,
            IncludePacingSummary = true,
            Recipients = new List<RecipientFormModel>
            {
                new() { Name = "Stakeholder Principal", Channel = ReportDeliveryChannel.Email, Destination = "" }
            }
        };
    }

    public void OpenForEdit(ReportScheduleDto dto)
    {
        EditingScheduleId = dto.Id;
        ErrorMessage = null;
        FormModel = new ReportScheduleFormModel
        {
            Name = dto.Name,
            Frequency = dto.Frequency,
            DayOfWeek = dto.DayOfWeek,
            DayOfMonth = dto.DayOfMonth,
            ScheduledTime = dto.ScheduledTimeUtc.ToString(@"hh\:mm"),
            DateRangeType = dto.DateRangeType,
            OutputFormat = dto.OutputFormat,
            DeliveryChannels = dto.DeliveryChannels,
            CustomTitle = dto.CustomTitle,
            CustomNotes = dto.CustomNotes,
            IncludeCopilotInsights = dto.IncludeCopilotInsights,
            IncludeTopCreatives = dto.IncludeTopCreatives,
            IncludeChannelBreakdown = dto.IncludeChannelBreakdown,
            IncludePacingSummary = dto.IncludePacingSummary,
            Recipients = dto.Recipients.Select(r => new RecipientFormModel { Name = r.Name, Channel = r.Channel, Destination = r.Destination }).ToList()
        };
    }

    private void AddRecipient()
    {
        FormModel.Recipients.Add(new RecipientFormModel { Name = "", Channel = ReportDeliveryChannel.Email, Destination = "" });
    }

    private void RemoveRecipient(int index)
    {
        if (index >= 0 && index < FormModel.Recipients.Count)
        {
            FormModel.Recipients.RemoveAt(index);
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(FormModel.Name))
        {
            ErrorMessage = "O nome do agendamento é obrigatório.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;
        try
        {
            var request = FormModel.ToRequest();
            await OnSave.InvokeAsync(request);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
