@page "/reports/shared/{Token}"
@page "/r/{Token}"
@layout EmptyLayout
@using Analytics.Application.Reports.DTOs
@using WebApp.Components.Layout
@using WebApp.Services.Reports
@inject IPublicReportClientService PublicReportClientService
@inject IJSRuntime JSRuntime

<PageTitle>@(Report?.ReportTitle ?? "Relatório Executivo")</PageTitle>

@if (IsLoading)
{
    <div class="d-flex flex-column align-items-center justify-content-center vh-100 bg-light">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        <div class="text-muted fw-semibold mt-3">Carregando relatório executivo...</div>
    </div>
}
else if (ErrorMessage != null || Report == null)
{
    <div class="d-flex align-items-center justify-content-center vh-100 bg-light px-3">
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center" style="max-width: 480px;">
            <div class="mb-3">
                <i class="bi bi-shield-x text-danger" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold">Relatório Indisponível</h4>
            <p class="text-muted small">
                O link que você tentou acessar não foi localizado ou não está mais ativo.
            </p>
        </div>
    </div>
}
else if (Report.IsExpired)
{
    <div class="d-flex align-items-center justify-content-center vh-100 bg-light px-3" id="shared-report-expired">
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center" style="max-width: 520px;">
            <div class="mb-3">
                <i class="bi bi-clock-history text-warning" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold">Este Relatório Expirou (Link Expirado)</h4>
            <p class="text-muted small">
                Este relatório interativo atingiu sua data limite de validade. Por motivos de segurança e governança de dados, o link de compartilhamento expirou.
            </p>
            <div class="alert alert-light border rounded-3 text-start small mt-3">
                <div class="fw-bold text-dark mb-1">Para solicitar uma nova via atualizada:</div>
                <div><strong>@Report.Branding.AgencyName</strong></div>
                @if (!string.IsNullOrWhiteSpace(Report.Branding.SupportEmail))
                {
                    <div>E-mail: @Report.Branding.SupportEmail</div>
                }
                @if (!string.IsNullOrWhiteSpace(Report.Branding.SupportPhone))
                {
                    <div>Telefone / WhatsApp: @Report.Branding.SupportPhone</div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="report-wrapper" id="shared-report-content" style="--brand-primary: @Report.Branding.PrimaryColor; --brand-secondary: @Report.Branding.SecondaryColor; background-color: #f8fafc; min-height: 100vh;">
        <!-- Top Agency Header -->
        <header class="border-bottom bg-white sticky-top shadow-sm">
            <div class="container py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(Report.Branding.LightLogoUrl))
                    {
                        <img src="@Report.Branding.LightLogoUrl" alt="@Report.Branding.AgencyName" style="max-height: 42px; object-fit: contain;" />
                    }
                    <div class="fw-bold fs-5 text-dark" id="header-agency-name" style="letter-spacing: -0.5px;">
                        <i class="bi bi-gem me-2" style="color: var(--brand-primary);"></i>
                        @Report.Branding.AgencyName
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-2" @onclick="DownloadPdfAsync" disabled="@IsDownloadingPdf">
                        @if (IsDownloadingPdf)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Baixando...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Baixar PDF</span>
                        }
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="container py-5">
            <!-- Hero Title -->
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));">
                <div class="position-relative" style="z-index: 2;">
                    <span class="badge bg-white bg-opacity-20 text-white fw-bold px-3 py-1 rounded-pill mb-2">Relatório Executivo</span>
                    <h1 class="fw-bold display-6 mb-2" id="header-report-title">@Report.ReportTitle</h1>
                    <h5 class="text-white-50 fw-normal mb-3">Cliente: <strong class="text-white">@Report.WorkspaceName</strong></h5>
                    <div class="d-flex flex-wrap gap-4 small text-white-50">
                        <div><i class="bi bi-calendar3 me-1 text-white"></i> @Report.DateRangeStart.ToString("dd/MM/yyyy") a @Report.DateRangeEnd.ToString("dd/MM/yyyy")</div>
                        <div><i class="bi bi-clock me-1 text-white"></i> Emitido em @Report.GeneratedAt.ToString("dd/MM/yyyy HH:mm") UTC</div>
                    </div>
                </div>
            </div>

            <!-- KPI Cards Grid -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                        <div class="text-muted small mb-1">Investimento</div>
                        <div class="fw-bold fs-5 text-dark" id="kpi-spend-value">R$ @Report.KpiSummary.TotalSpend.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                        <div class="text-muted small mb-1">Receita Gerada</div>
                        <div class="fw-bold fs-5 text-success">R$ @Report.KpiSummary.TotalRevenue.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                        <div class="text-muted small mb-1">ROAS Blended</div>
                        <div class="fw-bold fs-5 text-primary" id="kpi-roas-value" style="color: var(--brand-primary) !important;">@Report.KpiSummary.BlendedRoas.ToString("N2")x</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                        <div class="text-muted small mb-1">CPA Blended</div>
                        <div class="fw-bold fs-5 text-dark">R$ @Report.KpiSummary.BlendedCpa.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                        <div class="text-muted small mb-1">Conversões</div>
                        <div class="fw-bold fs-5 text-dark" id="kpi-conversions-value">@Report.KpiSummary.TotalConversions.ToString("N0")</div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                        <div class="text-muted small mb-1">Cliques / Impressões</div>
                        <div class="fw-bold fs-6 text-dark">@Report.KpiSummary.TotalClicks.ToString("N0") <span class="text-muted fw-normal small">/ @Report.KpiSummary.TotalImpressions.ToString("N0")</span></div>
                    </div>
                </div>
            </div>

            <!-- Notes from Manager (if any) -->
            @if (!string.IsNullOrWhiteSpace(Report.CustomNotes))
            {
                <div class="card border-0 shadow-sm rounded-3 p-4 mb-4 bg-white" style="border-left: 5px solid var(--brand-primary) !important;">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-chat-left-quote text-primary me-2" style="color: var(--brand-primary) !important;"></i>
                        Observação Estratégica da Gestão
                    </h6>
                    <p class="text-muted mb-0 small" style="white-space: pre-line;">@Report.CustomNotes</p>
                </div>
            }

            <!-- Channel Breakdown Table -->
            @if (Report.ChannelBreakdown.Count > 0)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-diagram-3 text-primary me-2" style="color: var(--brand-primary) !important;"></i>
                        Desempenho por Plataforma de Mídia
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th>Canal</th>
                                    <th>Investimento</th>
                                    <th>Receita</th>
                                    <th>ROAS</th>
                                    <th>Conversões</th>
                                    <th>Share de Verba</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ch in Report.ChannelBreakdown)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ch.Platform</td>
                                        <td>R$ @ch.Spend.ToString("N2")</td>
                                        <td class="text-success fw-semibold">R$ @ch.Revenue.ToString("N2")</td>
                                        <td><span class="badge bg-light text-dark border">@ch.Roas.ToString("N2")x</span></td>
                                        <td>@ch.Conversions</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar" style="width: @ch.SharePercentage%; background-color: var(--brand-primary);"></div>
                                                </div>
                                                <span class="small text-muted" style="min-width: 45px;">@ch.SharePercentage.ToString("N1")%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Top Creatives Showcase -->
            @if (Report.TopCreatives.Count > 0)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-images text-primary me-2" style="color: var(--brand-primary) !important;"></i>
                        Criativos de Maior Destaque
                    </h5>
                    <div class="row g-3">
                        @foreach (var creative in Report.TopCreatives)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card border rounded-3 p-3 h-100 bg-light">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-primary me-1">@creative.Platform</span>
                                        <span class="badge bg-success bg-opacity-10 text-success">@creative.FatigueStatus</span>
                                    </div>
                                    <div class="fw-semibold text-dark mb-2 text-truncate" title="@creative.AdName">@creative.AdName</div>
                                    <div class="small text-muted d-flex justify-content-between">
                                        <span>Gasto: <strong>R$ @creative.Spend.ToString("N2")</strong></span>
                                        <span>CTR: <strong>@creative.Ctr.ToString("N2")%</strong></span>
                                        <span>ROAS: <strong>@creative.Roas.ToString("N2")x</strong></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Copilot Diagnostics (if any) -->
            @if (Report.CopilotInsights.Count > 0)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-robot text-primary me-2" style="color: var(--brand-primary) !important;"></i>
                        Diagnósticos e Recomendações do Copiloto de IA
                    </h5>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var insight in Report.CopilotInsights)
                        {
                            <div class="p-3 rounded-3 bg-light border-start border-4" style="border-left-color: var(--brand-primary) !important;">
                                <div class="small text-dark fw-semibold">@insight</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </main>

        <!-- Agency Footer (Strict White-Label - zero mention of platform) -->
        <footer class="border-top bg-white py-4 mt-5">
            <div class="container text-center text-muted small">
                <div class="fw-bold text-dark mb-1">@Report.Branding.AgencyName</div>
                <div class="d-flex justify-content-center gap-3 flex-wrap" id="footer-agency-info">
                    @if (!string.IsNullOrWhiteSpace(Report.Branding.SupportEmail))
                    {
                        <span><i class="bi bi-envelope me-1"></i> @Report.Branding.SupportEmail</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Report.Branding.SupportPhone))
                    {
                        <span><i class="bi bi-telephone me-1"></i> @Report.Branding.SupportPhone</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Report.Branding.CustomDomain))
                    {
                        <span><i class="bi bi-globe me-1"></i> @Report.Branding.CustomDomain</span>
                    }
                </div>
                <div class="text-muted mt-2" style="font-size: 0.75rem;">
                    Relatório gerado com dados oficiais de campanhas em @Report.GeneratedAt.ToString("dd/MM/yyyy HH:mm") UTC.
                </div>
            </div>
        </footer>
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    public PublicSharedReportDto? Report { get; set; }
    public bool IsLoading { get; set; } = true;
    public bool IsDownloadingPdf { get; set; }
    public string? ErrorMessage { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await PublicReportClientService.GetSharedReportAsync(Token);
            if (result.IsSuccess)
            {
                Report = result.Value;
            }
            else
            {
                ErrorMessage = result.Error.Description;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        IsDownloadingPdf = true;
        try
        {
            var result = await PublicReportClientService.DownloadSharedReportPdfAsync(Token);
            if (result.IsSuccess)
            {
                var base64 = Convert.ToBase64String(result.Value);
                var url = $"data:application/pdf;base64,{base64}";
                await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            }
        }
        finally
        {
            IsDownloadingPdf = false;
        }
    }
}
