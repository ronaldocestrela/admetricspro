@page "/dashboard"
@layout TenantMainLayout
@namespace WebApp.Components.Pages
@implements IDisposable
@inject ITenantSessionStateProvider TenantSessionStateProvider
@inject ITenantStateProvider TenantStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Visão Geral — @AgencyName</PageTitle>

<div class="tenant-dashboard-container">
    <!-- Cabeçalho de Boas-Vindas e Ações Rápidas -->
    <header class="dashboard-header-section">
        <div class="dashboard-header-content">
            <h1 class="dashboard-welcome-title">Olá, @ManagerName! Bem-vindo à sua central de tráfego.</h1>
            <p class="dashboard-welcome-subtitle">
                Painel consolidado para <strong class="tenant-highlight">@AgencyName</strong>. Acompanhe o desempenho unificado de anúncios em tempo real.
            </p>
        </div>

        <div class="dashboard-header-actions">
            <a href="integrations" class="btn-action btn-primary" title="Conectar contas de anúncios">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
                <span>Conectar Contas</span>
            </a>
            <a href="workspaces" class="btn-action btn-secondary" title="Cadastrar novo cliente/workspace">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Novo Workspace</span>
            </a>
        </div>
    </header>

    <!-- Grid de Métricas Principais (Empty State / Zeradas no Primeiro Acesso) -->
    <section class="dashboard-metrics-section" aria-label="Métricas Consolidadas de Tráfego">
        <div class="metrics-grid">
            <!-- Card 1: Investimento Total -->
            <div class="metric-card">
                <div class="metric-card-header">
                    <span class="metric-title">Investimento Total</span>
                    <div class="metric-icon-box icon-spend">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                </div>
                <div class="metric-value">R$ 0,00</div>
                <div class="metric-footer">
                    <span class="metric-subtext">0,0% vs período anterior</span>
                    <span class="metric-status-badge">Aguardando dados</span>
                </div>
            </div>

            <!-- Card 2: Receita Atribuída -->
            <div class="metric-card">
                <div class="metric-card-header">
                    <span class="metric-title">Receita Atribuída</span>
                    <div class="metric-icon-box icon-revenue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="metric-value">R$ 0,00</div>
                <div class="metric-footer">
                    <span class="metric-subtext">Faturamento bruto via Pixel/CAPI</span>
                    <span class="metric-status-badge">Sem conversões</span>
                </div>
            </div>

            <!-- Card 3: ROAS Consolidado -->
            <div class="metric-card">
                <div class="metric-card-header">
                    <span class="metric-title">ROAS Consolidado</span>
                    <div class="metric-icon-box icon-roas">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="m16 12-4-4-4 4"></path>
                            <path d="M12 16V8"></path>
                        </svg>
                    </div>
                </div>
                <div class="metric-value">0,00x</div>
                <div class="metric-footer">
                    <span class="metric-subtext">Retorno unificado sobre ad spend</span>
                    <span class="metric-status-badge">Neutro</span>
                </div>
            </div>

            <!-- Card 4: MER Médio -->
            <div class="metric-card">
                <div class="metric-card-header">
                    <span class="metric-title">MER Médio</span>
                    <div class="metric-icon-box icon-mer">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="19" y1="5" x2="5" y2="19"></line>
                            <circle cx="6.5" cy="6.5" r="2.5"></circle>
                            <circle cx="17.5" cy="17.5" r="2.5"></circle>
                        </svg>
                    </div>
                </div>
                <div class="metric-value">0,00%</div>
                <div class="metric-footer">
                    <span class="metric-subtext">Marketing Efficiency Ratio global</span>
                    <span class="metric-status-badge">Meta: > 15%</span>
                </div>
            </div>

            <!-- Card 5: Cliques & Impressões -->
            <div class="metric-card">
                <div class="metric-card-header">
                    <span class="metric-title">Cliques &amp; Impressões</span>
                    <div class="metric-icon-box icon-reach">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </div>
                </div>
                <div class="metric-value">0 clics / 0 imp.</div>
                <div class="metric-footer">
                    <span class="metric-subtext">Alcance cross-network</span>
                    <span class="metric-status-badge">Sem tráfego</span>
                </div>
            </div>

            <!-- Card 6: CPA Médio -->
            <div class="metric-card">
                <div class="metric-card-header">
                    <span class="metric-title">CPA Médio</span>
                    <div class="metric-icon-box icon-cpa">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </div>
                </div>
                <div class="metric-value">R$ 0,00</div>
                <div class="metric-footer">
                    <span class="metric-subtext">Custo por aquisição consolidado</span>
                    <span class="metric-status-badge">Zero eventos</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Empty State Educativo & Guia de Primeiros Passos (FTUX) -->
    <section class="dashboard-empty-state" aria-label="Primeiros Passos da Agência">
        <div class="empty-state-banner">
            <div class="empty-state-visual">
                <div class="glow-orb"></div>
                <div class="empty-state-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                        <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                        <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                        <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                    </svg>
                </div>
            </div>

            <div class="empty-state-copy">
                <span class="empty-state-tag">Primeiro Acesso à Plataforma</span>
                <h2 class="empty-state-title">Sua central de tráfego unificada está pronta</h2>
                <p class="empty-state-desc">
                    Você ainda não possui dados consolidados porque nenhuma conta de anúncios foi vinculada e nenhum workspace foi configurado. Conecte suas contas (Meta Ads, Google Ads, TikTok Ads ou Bing Ads) para iniciar a sincronização automatizada em tempo real.
                </p>
            </div>
        </div>

        <!-- Trilha de Ações Rápidas -->
        <div class="ftux-steps-grid">
            <div class="ftux-step-card">
                <div class="step-badge">Etapa 1</div>
                <h3 class="step-title">Conectar Redes de Anúncios</h3>
                <p class="step-desc">Autentique Meta, Google, TikTok ou Bing Ads para importar métricas de campanhas e conjuntos.</p>
                <a href="integrations" class="btn-step-action">
                    <span>Conectar Fontes</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>

            <div class="ftux-step-card">
                <div class="step-badge">Etapa 2</div>
                <h3 class="step-title">Criar Primeiro Workspace</h3>
                <p class="step-desc">Agrupe contas de anúncios por cliente da agência, definindo orçamentos mensais e travas de segurança.</p>
                <a href="workspaces" class="btn-step-action">
                    <span>Criar Workspace</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>

            <div class="ftux-step-card">
                <div class="step-badge">Etapa 3</div>
                <h3 class="step-title">Organizar Squads e Membros</h3>
                <p class="step-desc">Convide gestores de tráfego e estruture times com isolamento estrito de carteira de clientes.</p>
                <a href="squads" class="btn-step-action">
                    <span>Configurar Equipe</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Painel de Redes de Anúncios Suportadas -->
    <section class="dashboard-platforms-section" aria-label="Plataformas de Anúncios Suportadas">
        <div class="section-header">
            <h2 class="section-title">Canais de Tráfego Suportados</h2>
            <p class="section-subtitle">Acompanhe a prontidão de sincronização das 4 redes nativas suportadas pelo AdMetricsPro.</p>
        </div>

        <div class="platforms-grid">
            <!-- Meta Ads -->
            <div class="ad-platform-card">
                <div class="platform-brand">
                    <div class="platform-logo meta-bg">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"/>
                        </svg>
                    </div>
                    <div class="platform-info">
                        <h4 class="platform-name">Meta Ads</h4>
                        <span class="platform-sub">Facebook &amp; Instagram</span>
                    </div>
                </div>
                <div class="platform-status-badge disconnected">
                    <span class="status-dot"></span>
                    <span>Desconectado</span>
                </div>
                <div class="platform-action">
                    <a href="integrations" class="btn-connect" title="Conectar Meta Ads">Conectar</a>
                </div>
            </div>

            <!-- Google Ads -->
            <div class="ad-platform-card">
                <div class="platform-brand">
                    <div class="platform-logo google-bg">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm3.882 14.542a5.556 5.556 0 1 1 0-7.084l2.122-2.122A8.556 8.556 0 1 0 17.5 12a8.77 8.77 0 0 0-.16-1.667H12v3.334h4.74a4.118 4.118 0 0 1-.858 2.875z"/>
                        </svg>
                    </div>
                    <div class="platform-info">
                        <h4 class="platform-name">Google Ads</h4>
                        <span class="platform-sub">Search, YouTube &amp; Display</span>
                    </div>
                </div>
                <div class="platform-status-badge disconnected">
                    <span class="status-dot"></span>
                    <span>Desconectado</span>
                </div>
                <div class="platform-action">
                    <a href="integrations" class="btn-connect" title="Conectar Google Ads">Conectar</a>
                </div>
            </div>

            <!-- TikTok Ads -->
            <div class="ad-platform-card">
                <div class="platform-brand">
                    <div class="platform-logo tiktok-bg">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                        </svg>
                    </div>
                    <div class="platform-info">
                        <h4 class="platform-name">TikTok Ads</h4>
                        <span class="platform-sub">TikTok For Business</span>
                    </div>
                </div>
                <div class="platform-status-badge disconnected">
                    <span class="status-dot"></span>
                    <span>Desconectado</span>
                </div>
                <div class="platform-action">
                    <a href="integrations" class="btn-connect" title="Conectar TikTok Ads">Conectar</a>
                </div>
            </div>

            <!-- Bing Ads -->
            <div class="ad-platform-card">
                <div class="platform-brand">
                    <div class="platform-logo bing-bg">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M5 3v18l5-3V7.5l5.5 3.5 3.5-2z"/>
                        </svg>
                    </div>
                    <div class="platform-info">
                        <h4 class="platform-name">Bing Ads</h4>
                        <span class="platform-sub">Microsoft Advertising</span>
                    </div>
                </div>
                <div class="platform-status-badge disconnected">
                    <span class="status-dot"></span>
                    <span>Desconectado</span>
                </div>
                <div class="platform-action">
                    <a href="integrations" class="btn-connect" title="Conectar Bing Ads">Conectar</a>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    /// <summary>
    /// Obtém o nome do gestor de tráfego autenticado ou retorna 'Gestor' por padrão.
    /// </summary>
    private string ManagerName
    {
        get
        {
            var fullName = TenantSessionStateProvider.CurrentSession?.FullName;
            return !string.IsNullOrWhiteSpace(fullName) ? fullName : "Gestor";
        }
    }

    /// <summary>
    /// Obtém o nome corporativo da agência ativa no contexto do circuito Blazor.
    /// </summary>
    private string AgencyName
    {
        get
        {
            var name = TenantStateProvider.CurrentTenant?.Name;
            return !string.IsNullOrWhiteSpace(name) ? name : "AdMetricsPro";
        }
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        TenantSessionStateProvider.OnSessionChanged += HandleStateChanged;
        TenantStateProvider.OnTenantChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        TenantSessionStateProvider.OnSessionChanged -= HandleStateChanged;
        TenantStateProvider.OnTenantChanged -= HandleStateChanged;
    }
}
