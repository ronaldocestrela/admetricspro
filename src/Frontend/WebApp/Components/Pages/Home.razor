@page "/"
@layout WebApp.Components.Landing.LandingLayout
@using WebApp.Components.Landing
@inject ITenantStateProvider TenantStateProvider

<PageTitle>AdMetric Pro — Escale seu tráfego pago com inteligência preditiva</PageTitle>

<!-- Banner contextual de tenant se houver tenant ativo na sessão -->
@if (TenantStateProvider.CurrentTenant is not null && TenantStateProvider.CurrentTenant.TenantId != Guid.Empty)
{
    <div style="background: rgba(79, 70, 229, 0.2); border-bottom: 1px solid rgba(79, 70, 229, 0.4); padding: 0.6rem 1rem; text-align: center; font-size: 0.85rem; color: #ffffff; z-index: 101; position: relative; margin-top: 4.25rem;">
        <span>Ambiente ativo: <strong>@TenantStateProvider.CurrentTenant.Name</strong></span>
        @if (!string.IsNullOrEmpty(TenantStateProvider.CurrentTenant.CustomDomain))
        {
            <span style="color: var(--lp-tertiary); margin-left: 0.5rem;">(@TenantStateProvider.CurrentTenant.CustomDomain)</span>
        }
        <a href="/dashboard" style="margin-left: 1rem; color: var(--lp-secondary); font-weight: 700; text-decoration: underline;">
            Acessar Painel do Workspace &rarr;
        </a>
    </div>
}

<LandingNavbar />

<main>
    <HeroSection />
    <LiveCockpitMockup />
    <IntegrationsSection />
    <BentoBenefitsSection />
    <SocialProofSection />
    <ConversionBannerSection />
</main>

<LandingFooter />

@code {
    // Página inicial oficial (Landing Page) do AdMetricsPro.
    // Renderiza a experiência de apresentação do produto e conversão baseada no Stitch.
}
