@using System.Text
@using System.Globalization
@using Analytics.Application.Dashboard.DTOs
@using WebApp.Models
@inject IJSRuntime JSRuntime
@namespace WebApp.Components.Dashboard

<div class="dashboard-export-actions">
    <button id="btn-export-csv" class="btn-export btn-export-csv" @onclick="ExportCsvAsync" disabled="@(Dashboard == null)" title="Exportar dados consolidados em planilha CSV">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Exportar CSV</span>
    </button>

    <button id="btn-export-image" class="btn-export btn-export-image" @onclick="ExportImageAsync" disabled="@(Dashboard == null)" title="Exportar visão executiva em alta resolução">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
            <circle cx="9" cy="9" r="2"></circle>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
        </svg>
        <span>Exportar Visão</span>
    </button>
</div>

@code {
    private static readonly CultureInfo PtBrCulture = CultureInfo.GetCultureInfo("pt-BR");

    /// <summary>
    /// Modelo consolidado do dashboard para exportação.
    /// </summary>
    [Parameter]
    public ExecutiveDashboardDto? Dashboard { get; set; }

    /// <summary>
    /// Filtros ativos no momento da exportação.
    /// </summary>
    [Parameter]
    public DashboardFiltersState? Filters { get; set; }

    /// <summary>
    /// Gera a planilha CSV estruturada e dispara o download no navegador.
    /// </summary>
    public async Task ExportCsvAsync()
    {
        if (Dashboard == null) return;

        var csvContent = BuildCsvContent(Dashboard);
        var fileName = $"dashboard_metricas_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";

        await JSRuntime.InvokeVoidAsync("dashboardExport.downloadCsv", fileName, csvContent);
    }

    /// <summary>
    /// Dispara a rotina de exportação ou impressão em alta resolução da visão atual.
    /// </summary>
    public async Task ExportImageAsync()
    {
        if (Dashboard == null) return;
        await JSRuntime.InvokeVoidAsync("dashboardExport.exportImageOrPrint", "executive-dashboard-container");
    }

    /// <summary>
    /// Compila o payload estruturado CSV em formato compatível com Excel brasileiro e internacional.
    /// </summary>
    /// <param name="dto">Dados executivos do dashboard.</param>
    /// <returns>String delimitada formatada.</returns>
    public static string BuildCsvContent(ExecutiveDashboardDto dto)
    {
        var sb = new StringBuilder();

        // Metadados
        sb.AppendLine($"# AdMetricsPro - Relatório Executivo Consolidado");
        sb.AppendLine($"# Período Corrente:;{dto.StartDateUtc:dd/MM/yyyy};a;{dto.EndDateUtc:dd/MM/yyyy}");
        sb.AppendLine($"# Período Anterior Comparativo:;{dto.PreviousStartDateUtc:dd/MM/yyyy};a;{dto.PreviousEndDateUtc:dd/MM/yyyy}");
        sb.AppendLine($"# Moeda:;{dto.Currency}");
        sb.AppendLine();

        // 1. Métricas Principais
        sb.AppendLine("METRICAS PRINCIPAIS");
        sb.AppendLine("Chave;Indicador;Valor Atual;Valor Anterior;Variacao %;Melhoria");
        foreach (var m in dto.Metrics)
        {
            var isPos = m.IsPositiveImprovement ? "Sim" : "Nao";
            sb.AppendLine($"{m.MetricKey};{m.Label};{m.CurrentValue.ToString("F2", PtBrCulture)};{m.PreviousValue.ToString("F2", PtBrCulture)};{m.PercentageChange.ToString("F2", PtBrCulture)}%;{isPos}");
        }
        sb.AppendLine();

        // 2. Série Temporal Diária
        sb.AppendLine("EVOLUCAO DIARIA");
        sb.AppendLine("Data;Investimento;Receita;ROAS;Cliques;Impressoes;Conversoes");
        foreach (var t in dto.TimeSeries)
        {
            sb.AppendLine($"{t.Date:dd/MM/yyyy};{t.Spend.ToString("F2", PtBrCulture)};{t.Revenue.ToString("F2", PtBrCulture)};{t.Roas.ToString("F2", PtBrCulture)};{t.Clicks};{t.Impressions};{t.Conversions.ToString("F2", PtBrCulture)}");
        }
        sb.AppendLine();

        // 3. Quebra por Plataforma
        sb.AppendLine("PARTICIPACAO POR CANAL");
        sb.AppendLine("Canal;Investimento;Share %;Receita;ROAS;Cliques;Conversoes");
        foreach (var p in dto.PlatformBreakdown)
        {
            sb.AppendLine($"{p.Platform};{p.Spend.ToString("F2", PtBrCulture)};{p.ShareOfSpendPercentage.ToString("F2", PtBrCulture)}%;{p.Revenue.ToString("F2", PtBrCulture)};{p.Roas.ToString("F2", PtBrCulture)};{p.Clicks};{p.Conversions.ToString("F2", PtBrCulture)}");
        }
        sb.AppendLine();

        // 4. Quebra por Dispositivo
        sb.AppendLine("PARTICIPACAO POR DISPOSITIVO");
        sb.AppendLine("Dispositivo;Investimento;Share %;Cliques;Conversoes;ROAS");
        foreach (var d in dto.DeviceBreakdown)
        {
            sb.AppendLine($"{d.Device};{d.Spend.ToString("F2", PtBrCulture)};{d.ShareOfSpendPercentage.ToString("F2", PtBrCulture)}%;{d.Clicks};{d.Conversions.ToString("F2", PtBrCulture)};{d.Roas.ToString("F2", PtBrCulture)}");
        }

        return sb.ToString();
    }
}
