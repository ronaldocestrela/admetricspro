@using System.Globalization
@using Analytics.Application.Dashboard.DTOs
@namespace WebApp.Components.Dashboard

<div class="metric-card" data-metric="@Metric.MetricKey">
    <div class="metric-card-header">
        <span class="metric-title">@Metric.Label</span>
        <div class="metric-icon-box icon-@Metric.MetricKey.ToLowerInvariant()">
            @RenderMetricIcon(Metric.MetricKey)
        </div>
    </div>

    <div class="metric-value">@FormatValue(Metric.CurrentValue, Metric.UnitFormat)</div>

    <div class="metric-footer">
        <span class="metric-trend-badge @GetTrendClass()">
            <svg class="trend-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                @if (Metric.PercentageChange >= 0)
                {
                    <polyline points="18 15 12 9 6 15"></polyline>
                }
                else
                {
                    <polyline points="6 9 12 15 18 9"></polyline>
                }
            </svg>
            <span>@(Metric.PercentageChange >= 0 ? "+" : "")@Metric.PercentageChange.ToString("F1", PtBrCulture)%</span>
        </span>

        <span class="metric-subtext">vs @FormatValue(Metric.PreviousValue, Metric.UnitFormat) anterior</span>
    </div>
</div>

@code {
    private static readonly CultureInfo PtBrCulture = CultureInfo.GetCultureInfo("pt-BR");

    /// <summary>
    /// Modelo de dados da métrica analítica.
    /// </summary>
    [Parameter, EditorRequired]
    public ExecutiveMetricItemDto Metric { get; set; } = default!;

    /// <summary>
    /// Código da moeda monetária de referência (padrão: BRL).
    /// </summary>
    [Parameter]
    public string Currency { get; set; } = "BRL";

    private string GetTrendClass()
    {
        if (Metric.PercentageChange == 0)
            return "trend-neutral";

        return Metric.IsPositiveImprovement ? "trend-positive" : "trend-negative";
    }

    private string FormatValue(decimal value, string unitFormat)
    {
        return unitFormat switch
        {
            "Currency" => value.ToString("C", PtBrCulture),
            "Percentage" => value.ToString("F2", PtBrCulture) + "%",
            "Multiplier" => value.ToString("F2", PtBrCulture) + "x",
            _ => value.ToString("N2", PtBrCulture)
        };
    }

    private RenderFragment RenderMetricIcon(string key) => builder =>
    {
        switch (key.ToLowerInvariant())
        {
            case "spend":
                builder.AddMarkupContent(0, "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>");
                break;
            case "cpc":
                builder.AddMarkupContent(0, "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6\"/><path d=\"M9 9h.01\"/><path d=\"M15 15h.01\"/></svg>");
                break;
            case "cpm":
                builder.AddMarkupContent(0, "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>");
                break;
            case "ctr":
                builder.AddMarkupContent(0, "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m3 3 7.07 16.97 2.51-7.39 7.39-2.51L3 3z\"/><path d=\"m13 13 6 6\"/></svg>");
                break;
            case "cpa":
                builder.AddMarkupContent(0, "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg>");
                break;
            case "roas":
            default:
                builder.AddMarkupContent(0, "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m16 12-4-4-4 4\"/><path d=\"M12 16V8\"/></svg>");
                break;
        }
    };
}
