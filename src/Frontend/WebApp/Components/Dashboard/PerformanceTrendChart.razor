@using System.Globalization
@using Analytics.Application.Dashboard.DTOs
@namespace WebApp.Components.Dashboard

<div class="chart-card">
    <div class="chart-card-header">
        <div class="chart-title-box">
            <h3 class="chart-title">Evolução de Desempenho (Spend vs Receita)</h3>
            <span class="chart-subtitle">Acompanhe a eficiência diária do investimento publicitário em tempo real</span>
        </div>
        <div class="chart-legend">
            <span class="legend-item">
                <span class="legend-dot dot-spend"></span>
                <span>Investimento</span>
            </span>
            <span class="legend-item">
                <span class="legend-dot dot-revenue"></span>
                <span>Receita Atribuída</span>
            </span>
        </div>
    </div>

    <div class="chart-body">
        @if (TimeSeries == null || TimeSeries.Count == 0)
        {
            <div class="chart-empty-state">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="1.5">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <p>Nenhum dado temporal disponível para o período filtrado.</p>
                <span class="empty-sub">Conecte uma conta de anúncios ou altere as datas do filtro.</span>
            </div>
        }
        else
        {
            <svg class="trend-svg" viewBox="0 0 @SvgWidth @SvgHeight" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="spendGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.0" />
                    </linearGradient>
                    <linearGradient id="revenueGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#10B981" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#10B981" stop-opacity="0.0" />
                    </linearGradient>
                </defs>

                <!-- Linhas Guia Horizontais -->
                @for (int i = 0; i <= 4; i++)
                {
                    var y = PaddingTop + (PlotHeight / 4) * i;
                    <line x1="@PaddingLeft" y1="@y" x2="@(SvgWidth - PaddingRight)" y2="@y" class="grid-line" />
                }

                <!-- Áreas preenchidas -->
                <path d="@BuildAreaPath(p => p.Revenue)" fill="url(#revenueGradient)" />
                <path d="@BuildAreaPath(p => p.Spend)" fill="url(#spendGradient)" />

                <!-- Linhas principais -->
                <path d="@BuildLinePath(p => p.Revenue)" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="@BuildLinePath(p => p.Spend)" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                <!-- Pontos interativos com Tooltip nativo SVG -->
                @for (int i = 0; i < TimeSeries.Count; i++)
                {
                    var point = TimeSeries[i];
                    var x = GetX(i);
                    var ySpend = GetY(point.Spend);
                    var yRev = GetY(point.Revenue);

                    <circle cx="@x" cy="@ySpend" r="4" class="chart-point point-spend">
                        <title>Data: @point.Date.ToString("dd/MM/yyyy")&#10;Investimento: @point.Spend.ToString("C", PtBrCulture)&#10;Cliques: @point.Clicks</title>
                    </circle>

                    <circle cx="@x" cy="@yRev" r="4" class="chart-point point-revenue">
                        <title>Data: @point.Date.ToString("dd/MM/yyyy")&#10;Receita: @point.Revenue.ToString("C", PtBrCulture)&#10;ROAS: @point.Roas.ToString("F2", PtBrCulture)x</title>
                    </circle>
                }
            </svg>

            <!-- Rótulos de datas no eixo horizontal -->
            <div class="chart-x-axis">
                @foreach (var p in TimeSeries)
                {
                    <span class="x-label">@p.Date.ToString("dd/MM")</span>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo PtBrCulture = CultureInfo.GetCultureInfo("pt-BR");

    private const int SvgWidth = 800;
    private const int SvgHeight = 220;
    private const int PaddingLeft = 20;
    private const int PaddingRight = 20;
    private const int PaddingTop = 15;
    private const int PaddingBottom = 25;

    private int PlotWidth => SvgWidth - PaddingLeft - PaddingRight;
    private int PlotHeight => SvgHeight - PaddingTop - PaddingBottom;

    /// <summary>
    /// Série temporal de desempenho diário.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ExecutiveTimeSeriesPointDto>? TimeSeries { get; set; }

    /// <summary>
    /// Código da moeda padrão.
    /// </summary>
    [Parameter]
    public string Currency { get; set; } = "BRL";

    private decimal GetMaxVal()
    {
        if (TimeSeries == null || TimeSeries.Count == 0) return 100m;
        var max = TimeSeries.Max(p => Math.Max(p.Spend, p.Revenue));
        return max > 0 ? max * 1.15m : 100m;
    }

    private double GetX(int index)
    {
        if (TimeSeries == null || TimeSeries.Count <= 1) return PaddingLeft + (PlotWidth / 2.0);
        return PaddingLeft + ((double)index / (TimeSeries.Count - 1)) * PlotWidth;
    }

    private double GetY(decimal val)
    {
        var max = (double)GetMaxVal();
        var normalized = Math.Clamp((double)val / max, 0.0, 1.0);
        return PaddingTop + (PlotHeight * (1.0 - normalized));
    }

    private string BuildLinePath(Func<ExecutiveTimeSeriesPointDto, decimal> selector)
    {
        if (TimeSeries == null || TimeSeries.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < TimeSeries.Count; i++)
        {
            var x = GetX(i).ToString("F1", CultureInfo.InvariantCulture);
            var y = GetY(selector(TimeSeries[i])).ToString("F1", CultureInfo.InvariantCulture);
            sb.Append(i == 0 ? $"M {x} {y}" : $" L {x} {y}");
        }
        return sb.ToString();
    }

    private string BuildAreaPath(Func<ExecutiveTimeSeriesPointDto, decimal> selector)
    {
        if (TimeSeries == null || TimeSeries.Count == 0) return "";
        var line = BuildLinePath(selector);
        var lastX = GetX(TimeSeries.Count - 1).ToString("F1", CultureInfo.InvariantCulture);
        var firstX = GetX(0).ToString("F1", CultureInfo.InvariantCulture);
        var bottomY = (PaddingTop + PlotHeight).ToString("F1", CultureInfo.InvariantCulture);

        return $"{line} L {lastX} {bottomY} L {firstX} {bottomY} Z";
    }
}
