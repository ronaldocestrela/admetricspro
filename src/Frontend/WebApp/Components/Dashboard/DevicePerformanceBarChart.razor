@using System.Globalization
@using Analytics.Application.Dashboard.DTOs
@namespace WebApp.Components.Dashboard

<div class="device-card">
    <div class="device-header">
        <h3 class="device-title">Desempenho por Dispositivo</h3>
        <span class="device-subtitle">Conversões e ROAS por tipo de hardware</span>
    </div>

    <div class="device-body">
        @if (DeviceBreakdown == null || DeviceBreakdown.Count == 0)
        {
            <div class="device-empty-state">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="1.5">
                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                    <path d="M12 18h.01"></path>
                </svg>
                <p>Nenhuma métrica de dispositivo disponível.</p>
            </div>
        }
        else
        {
            <div class="device-list">
                @foreach (var device in DeviceBreakdown)
                {
                    <div class="device-item">
                        <div class="device-meta">
                            <div class="device-info">
                                <span class="device-icon">@RenderDeviceIcon(device.Device)</span>
                                <span class="device-name">@device.Device</span>
                            </div>
                            <div class="device-stats">
                                <span class="device-spend">@device.Spend.ToString("C", PtBrCulture)</span>
                                <span class="device-roas">@device.Roas.ToString("F2", PtBrCulture)x ROAS</span>
                            </div>
                        </div>

                        <div class="device-progress-track">
                            <div class="device-progress-bar" style="width: @(Math.Clamp((double)device.ShareOfSpendPercentage, 0.0, 100.0).ToString("F1", CultureInfo.InvariantCulture))%;"></div>
                        </div>

                        <div class="device-substats">
                            <span>@device.Clicks.ToString("N0", PtBrCulture) cliques</span>
                            <span>@device.Conversions.ToString("N0", PtBrCulture) conversões</span>
                            <span class="device-share">@device.ShareOfSpendPercentage.ToString("F1", PtBrCulture)% da verba</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo PtBrCulture = CultureInfo.GetCultureInfo("pt-BR");

    /// <summary>
    /// Lista de quebra proporcional por dispositivo.
    /// </summary>
    [Parameter]
    public IReadOnlyList<DeviceShareDto>? DeviceBreakdown { get; set; }

    /// <summary>
    /// Código da moeda padrão.
    /// </summary>
    [Parameter]
    public string Currency { get; set; } = "BRL";

    private RenderFragment RenderDeviceIcon(string device) => builder =>
    {
        switch (device.ToLowerInvariant())
        {
            case "mobile":
                builder.AddMarkupContent(0, "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"14\" height=\"20\" x=\"5\" y=\"2\" rx=\"2\" ry=\"2\"/><path d=\"M12 18h.01\"/></svg>");
                break;
            case "desktop":
                builder.AddMarkupContent(0, "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"3\" rx=\"2\"/><line x1=\"8\" x2=\"16\" y1=\"21\" y2=\"21\"/><line x1=\"12\" x2=\"12\" y1=\"17\" y2=\"21\"/></svg>");
                break;
            case "tablet":
            default:
                builder.AddMarkupContent(0, "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"16\" height=\"20\" x=\"4\" y=\"2\" rx=\"2\"/><line x1=\"12\" x2=\"12.01\" y1=\"18\" y2=\"18\"/></svg>");
                break;
        }
    };
}
