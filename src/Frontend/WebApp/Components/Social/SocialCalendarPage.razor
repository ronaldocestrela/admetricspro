@page "/social/calendar"
@layout WebApp.Components.Layout.TenantMainLayout
@namespace WebApp.Components.Social
@using WebApp.Services.Social
@using WebApp.State
@using SocialPublishing.Application.Posts.DTOs
@inject IWorkspaceContextStateProvider WorkspaceContextStateProvider
@inject ISocialPublishingClient SocialClient
@inject ITenantStateProvider TenantStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Calendário orgânico</PageTitle>

<div class="social-calendar-page" data-testid="social-calendar-page">
    <header class="mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="h3">Calendário orgânico</h1>
            <p class="text-muted mb-0">Clique em um card para ver o post; arraste entre dias para reagendar (fuso @TimeZoneId).</p>
        </div>
        <div class="btn-group" role="group" aria-label="Modo de visualização">
            <button type="button"
                    class="btn @( _view == SocialCalendarView.Month ? "btn-primary" : "btn-outline-primary")"
                    data-testid="calendar-view-month"
                    @onclick="() => SetView(SocialCalendarView.Month)">
                Mês
            </button>
            <button type="button"
                    class="btn @( _view == SocialCalendarView.Week ? "btn-primary" : "btn-outline-primary")"
                    data-testid="calendar-view-week"
                    @onclick="() => SetView(SocialCalendarView.Week)">
                Semana
            </button>
        </div>
    </header>

    @if (!WorkspaceContextStateProvider.HasWorkspaceSelected)
    {
        <div class="alert alert-info" data-testid="social-calendar-select-workspace">
            Selecione um cliente ativo na barra lateral para ver o calendário orgânico.
        </div>
    }
    else
    {
        <div class="social-calendar-toolbar mb-3 d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="calendar-prev" @onclick="GoPrevious">Anterior</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="calendar-today" @onclick="GoToday">Hoje</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="calendar-next" @onclick="GoNext">Próximo</button>
            <span class="fw-semibold ms-2" data-testid="calendar-period-label">@PeriodLabel</span>
            <button type="button"
                    class="btn btn-primary btn-sm ms-auto"
                    data-testid="calendar-generate-plan"
                    @onclick="OpenGeneratePlanDialog">
                Gerar cronograma
            </button>
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    data-testid="calendar-create-approval-link"
                    disabled="@_isCreatingLink"
                    @onclick="CreateApprovalLinkAsync">
                @if (_isCreatingLink)
                {
                    <span>Gerando link…</span>
                }
                else
                {
                    <span>Link de aprovação</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_approvalLinkUrl))
        {
            <div class="alert alert-success d-flex flex-wrap align-items-center gap-2"
                 data-testid="calendar-approval-link-result">
                <span class="small text-muted">Compartilhe com o cliente:</span>
                <a href="@_approvalLinkUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-break"
                   data-testid="calendar-approval-link-anchor">@_approvalLinkUrl</a>
                <button type="button"
                        class="btn btn-sm btn-outline-success"
                        data-testid="calendar-approval-link-copy"
                        @onclick="CopyApprovalLinkAsync">
                    Copiar link
                </button>
            </div>
        }
        else if (!string.IsNullOrEmpty(_approvalLinkError))
        {
            <div class="alert alert-danger" data-testid="calendar-approval-link-error">@_approvalLinkError</div>
        }

        @if (_isLoading)
        {
            <p class="text-muted" data-testid="social-calendar-loading">Carregando calendário…</p>
        }
        else if (!string.IsNullOrEmpty(_loadError))
        {
            <div class="alert alert-danger" data-testid="social-calendar-load-error">@_loadError</div>
        }
        else
        {
            <SocialCalendarGrid WorkspaceId="@WorkspaceContextStateProvider.CurrentWorkspaceId!.Value"
                                View="_view"
                                AnchorDate="_anchorDate"
                                Posts="_posts"
                                TimeZone="@TimeZoneId" />
        }

        @if (_showGeneratePlan && WorkspaceContextStateProvider.HasWorkspaceSelected)
        {
            <GeneratePlanDialog IsOpen="_showGeneratePlan"
                                WorkspaceId="@WorkspaceContextStateProvider.CurrentWorkspaceId!.Value"
                                TimeZoneId="@TimeZoneId"
                                OnClose="CloseGeneratePlanDialog"
                                OnGenerationSucceeded="HandlePlanGenerationSucceeded" />
        }
    }
</div>

@code {
    private const string TimeZoneId = "America/Sao_Paulo";

    private SocialCalendarView _view = SocialCalendarView.Month;
    private DateOnly _anchorDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private IReadOnlyList<OrganicPostDto> _posts = Array.Empty<OrganicPostDto>();
    private bool _isLoading;
    private string? _loadError;
    private Guid? _loadedWorkspaceId;
    private bool _isCreatingLink;
    private string? _approvalLinkUrl;
    private string? _approvalLinkError;
    private bool _showGeneratePlan;

    private string PeriodLabel => _view switch
    {
        SocialCalendarView.Month => _anchorDate.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")),
        SocialCalendarView.Week => $"Semana de {SocialCalendarDateHelper.StartOfWeekMonday(_anchorDate):dd/MM/yyyy}",
        _ => _anchorDate.ToString("d"),
    };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        WorkspaceContextStateProvider.OnWorkspaceChanged += HandleWorkspaceChanged;
        await LoadPostsIfNeededAsync();
    }

    private void HandleWorkspaceChanged()
    {
        _posts = Array.Empty<OrganicPostDto>();
        _loadedWorkspaceId = null;
        _ = InvokeAsync(async () =>
        {
            await LoadPostsIfNeededAsync();
            StateHasChanged();
        });
    }

    private async Task LoadPostsIfNeededAsync()
    {
        if (!WorkspaceContextStateProvider.HasWorkspaceSelected)
        {
            _posts = Array.Empty<OrganicPostDto>();
            _loadedWorkspaceId = null;
            return;
        }

        var workspaceId = WorkspaceContextStateProvider.CurrentWorkspaceId!.Value;
        _isLoading = true;
        _loadError = null;
        StateHasChanged();

        var timeZone = TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId);
        var visibleDays = SocialCalendarDateHelper.GetVisibleDays(_view, _anchorDate);
        var (fromUtc, toUtc) = SocialCalendarDateHelper.GetUtcRangeForVisibleDays(visibleDays, timeZone);

        var result = await SocialClient.ListPostsAsync(workspaceId, fromUtc, toUtc);
        _isLoading = false;

        if (result.IsFailure)
        {
            _loadError = result.Error.Description;
            _posts = Array.Empty<OrganicPostDto>();
            _loadedWorkspaceId = workspaceId;
            return;
        }

        _posts = result.Value;
        _loadedWorkspaceId = workspaceId;
    }

    private async Task SetView(SocialCalendarView view)
    {
        _view = view;
        await LoadPostsIfNeededAsync();
    }

    private async Task GoPrevious()
    {
        _anchorDate = _view switch
        {
            SocialCalendarView.Month => _anchorDate.AddMonths(-1),
            SocialCalendarView.Week => _anchorDate.AddDays(-7),
            _ => _anchorDate,
        };
        await LoadPostsIfNeededAsync();
    }

    private async Task GoNext()
    {
        _anchorDate = _view switch
        {
            SocialCalendarView.Month => _anchorDate.AddMonths(1),
            SocialCalendarView.Week => _anchorDate.AddDays(7),
            _ => _anchorDate,
        };
        await LoadPostsIfNeededAsync();
    }

    private async Task GoToday()
    {
        _anchorDate = DateOnly.FromDateTime(DateTime.UtcNow);
        await LoadPostsIfNeededAsync();
    }

    private void OpenGeneratePlanDialog()
    {
        if (!WorkspaceContextStateProvider.HasWorkspaceSelected)
        {
            return;
        }

        _showGeneratePlan = true;
    }

    private Task CloseGeneratePlanDialog()
    {
        _showGeneratePlan = false;
        return Task.CompletedTask;
    }

    private async Task HandlePlanGenerationSucceeded()
    {
        await LoadPostsIfNeededAsync();
    }

    private async Task CreateApprovalLinkAsync()
    {
        if (!WorkspaceContextStateProvider.HasWorkspaceSelected)
        {
            return;
        }

        _isCreatingLink = true;
        _approvalLinkUrl = null;
        _approvalLinkError = null;
        StateHasChanged();

        var workspaceId = WorkspaceContextStateProvider.CurrentWorkspaceId!.Value;
        var expires = DateTime.UtcNow.AddDays(14);
        var result = await SocialClient.CreateApprovalLinkAsync(workspaceId, expires);
        _isCreatingLink = false;

        if (result.IsFailure)
        {
            _approvalLinkError = result.Error.Description;
            return;
        }

        _approvalLinkUrl = BuildApprovalShareUrl(result.Value.RelativePath);
    }

    /// <summary>
    /// Monta a URL absoluta do portal público conforme white-label (CNAME ou slug na rota do WebApp).
    /// </summary>
    /// <param name="relativePath">Caminho retornado pela API (<c>/approve/{token}</c>).</param>
    /// <returns>URL compartilhável com esquema e host.</returns>
    private string BuildApprovalShareUrl(string relativePath)
    {
        var path = string.IsNullOrWhiteSpace(relativePath) ? "/approve" : relativePath;
        if (!path.StartsWith('/'))
        {
            path = "/" + path;
        }

        var tenant = TenantStateProvider.CurrentTenant;
        if (!string.IsNullOrWhiteSpace(tenant?.CustomDomain))
        {
            return $"https://{tenant.CustomDomain.Trim()}{path}";
        }

        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        if (!string.IsNullOrWhiteSpace(tenant?.Slug) && tenant.Slug != "default")
        {
            return $"{baseUri}/t/{tenant.Slug}{path}";
        }

        return $"{baseUri}{path}";
    }

    /// <summary>
    /// Copia a URL absoluta do portal para a área de transferência do navegador.
    /// </summary>
    private async Task CopyApprovalLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_approvalLinkUrl))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _approvalLinkUrl);
        }
        catch
        {
            // Clipboard indisponível: o link permanece visível no alerta para cópia manual.
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        WorkspaceContextStateProvider.OnWorkspaceChanged -= HandleWorkspaceChanged;
    }
}
