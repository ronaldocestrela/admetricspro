@namespace WebApp.Components.Social
@using WebApp.Components.Shared.Components
@using WebApp.Services.Social
@using SocialPublishing.Application.Posts.DTOs
@using SocialPublishing.Domain.Connections
@using SocialPublishing.Domain.Posts
@inject ISocialPublishingClient SocialClient
@inject ISocialMediaPreviewCache MediaPreviewCache
@inject IJSRuntime JSRuntime

@if (Post is not null)
{
    var captionParts = OrganicPostCaptionDisplay.Parse(Post.Caption);
    <div class="modal-backdrop organic-post-detail-backdrop"
         data-testid="organic-post-detail-backdrop"
         @onclick="RequestClose"
         @onkeydown="HandleBackdropKeydown">
        <div class="modal-dialog organic-post-detail-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="organic-post-detail-title"
             data-testid="organic-post-detail-dialog"
             @onclick:stopPropagation="true"
             @onkeydown="HandleDialogKeydown"
             tabindex="-1">
            <div class="modal-header">
                <h2 class="h5 mb-0" id="organic-post-detail-title">Post orgânico</h2>
                <button type="button"
                        class="btn-close"
                        aria-label="Fechar"
                        data-testid="organic-post-detail-close"
                        @onclick="RequestClose"></button>
            </div>
            <div class="modal-body">
                <div class="organic-post-detail-badges mb-3">
                    <div class="organic-post-detail-badge-row"
                         data-testid="organic-post-detail-status-row">
                        <span class="organic-post-detail-badge-label">Status</span>
                        <OrganicPostStatusBadge Status="_displayedPost.Status"
                                                AdditionalCssClass="organic-post-detail-badge-pill" />
                    </div>
                    <div class="organic-post-detail-badge-row"
                         data-testid="organic-post-detail-pillar-row">
                        <span class="organic-post-detail-badge-label">Pilar</span>
                        <ContentPillarChip Pillar="Post.Pillar"
                                           AdditionalCssClass="organic-post-detail-badge-pill" />
                    </div>
                </div>
                <div class="organic-post-detail-meta-grid mb-3">
                    <div class="organic-post-detail-meta-item">
                        <span class="organic-post-detail-meta-label">Rede</span>
                        <span class="organic-post-detail-meta-value"
                              data-testid="organic-post-detail-meta-platform">@OrganicPostDisplayLabels.FormatPlatform(Post.Platform)</span>
                    </div>
                    <div class="organic-post-detail-meta-item">
                        <span class="organic-post-detail-meta-label">Formato</span>
                        <span class="organic-post-detail-meta-value"
                              data-testid="organic-post-detail-meta-format">@OrganicPostDisplayLabels.FormatPostFormat(Post.Format)</span>
                    </div>
                    <div class="organic-post-detail-meta-item organic-post-detail-meta-item-wide">
                        <span class="organic-post-detail-meta-label">Agendado para</span>
                        <span class="organic-post-detail-meta-value"
                              data-testid="organic-post-detail-meta-scheduled">@FormatScheduledLocal(Post.ScheduledAtUtc)</span>
                    </div>
                </div>
                <h3 class="h6 organic-post-detail-section-title">Legenda</h3>
                @if (CanReviseCaption)
                {
                    <label class="form-label visually-hidden" for="organic-post-caption-editor">Legenda do post</label>
                    <textarea id="organic-post-caption-editor"
                              class="form-control organic-post-detail-caption-editor"
                              rows="6"
                              data-testid="organic-post-detail-caption-editor"
                              disabled="@_isLifecycleBusy"
                              @bind="_editCaption"></textarea>
                    <button type="button"
                            class="btn btn-outline-primary mt-2"
                            data-testid="organic-post-detail-save-caption"
                            disabled="@_isLifecycleBusy"
                            @onclick="SaveCaptionAsync">
                        @if (_isSavingCaption)
                        {
                            <span>Salvando…</span>
                        }
                        else
                        {
                            <span>Salvar legenda</span>
                        }
                    </button>
                }
                else
                {
                    <p class="organic-post-detail-caption"
                       data-testid="organic-post-detail-caption-body">@captionParts.Body</p>
                    @if (captionParts.Hashtags.Count > 0)
                    {
                        <div class="organic-post-detail-hashtags"
                             data-testid="organic-post-detail-hashtags"
                             aria-label="Hashtags">
                            @foreach (var tag in captionParts.Hashtags)
                            {
                                <span class="organic-post-detail-hashtag"
                                      data-testid="organic-post-detail-hashtag">@tag</span>
                            }
                        </div>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(Post.ClientApprovalComment))
                {
                    <h3 class="h6 organic-post-detail-section-title mt-4">Alteração solicitada pelo cliente</h3>
                    <p class="organic-post-detail-client-change"
                       data-testid="organic-post-detail-client-change">@Post.ClientApprovalComment</p>
                }
                @if (!string.IsNullOrWhiteSpace(_previewSrc) || _isLoadingPreview)
                {
                    <h3 class="h6 organic-post-detail-section-title mt-4">Imagem</h3>
                    <div class="organic-post-detail-image-frame"
                         data-testid="organic-post-detail-image-frame">
                        @if (!string.IsNullOrWhiteSpace(_previewSrc))
                        {
                            <img class="organic-post-detail-image-preview rounded"
                                 data-testid="organic-post-detail-image-preview"
                                 src="@_previewSrc"
                                 alt="Prévia da imagem do post" />
                        }
                        else
                        {
                            <p class="organic-post-detail-image-loading"
                               data-testid="organic-post-detail-image-loading">Carregando prévia…</p>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_previewSrc))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary mt-2"
                                data-testid="organic-post-detail-download-image"
                                disabled="@(_isDownloadingImage || _isLifecycleBusy)"
                                @onclick="DownloadImageAsync">
                            <i class="bi bi-download me-1"></i>
                            @if (_isDownloadingImage)
                            {
                                <span>Baixando…</span>
                            }
                            else
                            {
                                <span>Baixar imagem</span>
                            }
                        </button>
                    }
                }
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success mt-3 mb-0" role="status" data-testid="organic-post-detail-success">@_successMessage</div>
                }
                @if (CanGenerateImage)
                {
                    <p class="small text-muted mt-3 mb-0" data-testid="organic-post-detail-ai-disclaimer">
                        Imagem gerada por IA (Gemini Nano Banana). Pode conter marca d&apos;água SynthID.
                    </p>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert" data-testid="organic-post-detail-error">@_errorMessage</div>
                }
            </div>
            <div class="modal-footer">
                @if (CanSubmitForApproval)
                {
                    <button type="button"
                            class="btn btn-primary me-auto"
                            data-testid="organic-post-detail-submit-for-approval"
                            disabled="@_isLifecycleBusy"
                            @onclick="SubmitForApprovalAsync">
                        @if (_isSubmitting)
                        {
                            <span>Enviando…</span>
                        }
                        else
                        {
                            <span>Enviar para aprovação</span>
                        }
                    </button>
                }
                @if (CanApproveInternal)
                {
                    <button type="button"
                            class="btn btn-success me-auto"
                            data-testid="organic-post-detail-approve"
                            disabled="@_isLifecycleBusy"
                            @onclick="ApproveInternalAsync">
                        @if (_isApproving)
                        {
                            <span>Aprovando…</span>
                        }
                        else
                        {
                            <span>Aprovar</span>
                        }
                    </button>
                }
                @if (CanGenerateImage)
                {
                    <button type="button"
                            class="btn btn-outline-primary me-auto"
                            data-testid="organic-post-detail-generate-image"
                            disabled="@_isLifecycleBusy"
                            @onclick="GenerateImageAsync">
                        @if (_isGeneratingImage)
                        {
                            <span>Gerando…</span>
                        }
                        else if (_displayedPost.Media is { Count: > 0 })
                        {
                            <span>Gerar outra imagem</span>
                        }
                        else
                        {
                            <span>Gerar imagem</span>
                        }
                    </button>
                }
                @if (CanSchedule)
                {
                    <button type="button"
                            class="btn btn-primary me-auto"
                            data-testid="organic-post-detail-schedule"
                            disabled="@_isLifecycleBusy"
                            @onclick="ScheduleAsync">
                        @if (_isScheduling)
                        {
                            <span>Agendando…</span>
                        }
                        else
                        {
                            <span>Agendar publicação</span>
                        }
                    </button>
                }
                <button type="button" class="btn btn-outline-secondary" data-testid="organic-post-detail-done" @onclick="RequestClose">Fechar</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Post selecionado para exibição; ausência oculta o diálogo.
    /// </summary>
    [Parameter]
    public OrganicPostDto? Post { get; set; }

    /// <summary>
    /// Workspace proprietário do post (mutações de lifecycle na API).
    /// </summary>
    [Parameter]
    public Guid WorkspaceId { get; set; }

    /// <summary>
    /// Identificador IANA do fuso para exibir o horário agendado.
    /// </summary>
    [Parameter]
    public string TimeZoneId { get; set; } = "America/Sao_Paulo";

    /// <summary>
    /// Notifica o host para fechar o painel de detalhe.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Notifica o host quando o post foi atualizado após aprovação, agendamento ou envio parcial.
    /// </summary>
    [Parameter]
    public EventCallback<OrganicPostDto> OnPostUpdated { get; set; }

    private OrganicPostDto _displayedPost = null!;
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isApproving;
    private bool _isScheduling;
    private bool _isSavingCaption;
    private bool _isGeneratingImage;
    private bool _isLoadingPreview;
    private bool _isDownloadingImage;
    private string _editCaption = string.Empty;
    private string? _successMessage;
    private string? _previewSrc;
    private Guid? _loadedPreviewAssetId;

    private bool _isLifecycleBusy =>
        _isSubmitting
        || _isApproving
        || _isScheduling
        || _isSavingCaption
        || _isGeneratingImage
        || _isDownloadingImage;

    private bool CanReviseCaption =>
        _displayedPost.Status is OrganicPostStatus.Draft or OrganicPostStatus.ChangesRequested;

    private bool CanSubmitForApproval =>
        _displayedPost.Status is OrganicPostStatus.Draft or OrganicPostStatus.ChangesRequested;

    private bool CanApproveInternal => _displayedPost.Status == OrganicPostStatus.PendingApproval;

    private bool CanSchedule => _displayedPost.Status == OrganicPostStatus.Approved;

    private bool CanGenerateImage =>
        _displayedPost.Status == OrganicPostStatus.Approved
        && _displayedPost.Format == OrganicPostFormat.FeedImage;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Post is null)
        {
            return;
        }

        if (_displayedPost?.Id != Post.Id)
        {
            _displayedPost = Post;
            _editCaption = Post.Caption;
            _errorMessage = null;
            _successMessage = null;
            _previewSrc = null;
            _loadedPreviewAssetId = null;
            _isSubmitting = false;
            _isApproving = false;
            _isScheduling = false;
            _isSavingCaption = false;
            _isGeneratingImage = false;
        }
        else if (HasPostContentChanged(Post, _displayedPost))
        {
            _displayedPost = Post;
            _editCaption = Post.Caption;
        }

        await RefreshPreviewAsync();
    }

    private static bool HasPostContentChanged(OrganicPostDto incoming, OrganicPostDto current) =>
        current.Status != incoming.Status
        || current.Caption != incoming.Caption
        || MediaSignature(current) != MediaSignature(incoming);

    private static string MediaSignature(OrganicPostDto post) =>
        post.Media is null || post.Media.Count == 0
            ? string.Empty
            : string.Join(
                '|',
                post.Media.Select(m => $"{m.Id}:{m.PublicUrl}:{m.Width}:{m.Height}"));

    /// <summary>
    /// Solicita geração de imagem via Gemini Nano Banana para post aprovado.
    /// </summary>
    private async Task GenerateImageAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanGenerateImage)
        {
            return;
        }

        _isGeneratingImage = true;
        _errorMessage = null;
        _successMessage = null;

        var generateResult = await SocialClient.GeneratePostImageAsync(WorkspaceId, _displayedPost.Id);
        _isGeneratingImage = false;

        if (generateResult is null || generateResult.IsFailure)
        {
            _errorMessage = generateResult?.Error.Description
                ?? "Não foi possível gerar a imagem. Tente novamente.";
            return;
        }

        _displayedPost = generateResult.Value;
        _successMessage = "Imagem gerada e anexada ao post.";
        _loadedPreviewAssetId = null;
        await RefreshPreviewAsync();
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    private async Task RefreshPreviewAsync()
    {
        var post = _displayedPost;
        var asset = post?.Media?.FirstOrDefault();
        if (post is null || asset is null)
        {
            _previewSrc = null;
            _loadedPreviewAssetId = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(asset.PublicUrl))
        {
            _previewSrc = asset.PublicUrl;
            _loadedPreviewAssetId = asset.Id;
            return;
        }

        if (_loadedPreviewAssetId == asset.Id && !string.IsNullOrWhiteSpace(_previewSrc))
        {
            return;
        }

        if (WorkspaceId == Guid.Empty)
        {
            return;
        }

        var postId = post.Id;
        _isLoadingPreview = true;
        var content = await SocialClient.GetPostMediaContentAsync(WorkspaceId, postId, asset.Id);
        _isLoadingPreview = false;

        if (content is null || content.IsFailure)
        {
            _errorMessage ??= content?.Error.Description ?? "Não foi possível carregar a prévia da imagem.";
            return;
        }

        if (string.IsNullOrWhiteSpace(content.Value.ContentBase64))
        {
            _errorMessage ??= "Não foi possível carregar a prévia da imagem.";
            return;
        }

        byte[] previewBytes;
        try
        {
            previewBytes = Convert.FromBase64String(content.Value.ContentBase64);
        }
        catch (FormatException)
        {
            _errorMessage ??= "Não foi possível carregar a prévia da imagem.";
            return;
        }

        var ticket = MediaPreviewCache.Store(previewBytes, content.Value.MimeType);
        _previewSrc = $"/social/media-preview/{ticket}";
        _loadedPreviewAssetId = asset.Id;
    }

    /// <summary>
    /// Obtém o conteúdo autenticado da primeira mídia e dispara o download no navegador.
    /// </summary>
    private async Task DownloadImageAsync()
    {
        if (WorkspaceId == Guid.Empty || _isDownloadingImage)
        {
            return;
        }

        var post = _displayedPost;
        var asset = post?.Media?.FirstOrDefault();
        if (post is null || asset is null)
        {
            return;
        }

        _isDownloadingImage = true;
        _errorMessage = null;

        var content = await SocialClient.GetPostMediaContentAsync(WorkspaceId, post.Id, asset.Id);
        _isDownloadingImage = false;

        if (content is null || content.IsFailure)
        {
            _errorMessage = content?.Error.Description ?? "Não foi possível baixar a imagem.";
            return;
        }

        if (string.IsNullOrWhiteSpace(content.Value.ContentBase64))
        {
            _errorMessage = "Não foi possível baixar a imagem.";
            return;
        }

        var fileName = OrganicPostMediaFileNames.BuildDownloadFileName(post.Id, content.Value.MimeType);
        await JSRuntime.InvokeVoidAsync(
            "fileDownload.downloadBase64",
            fileName,
            content.Value.MimeType,
            content.Value.ContentBase64);
    }

    private async Task RequestClose() => await OnClose.InvokeAsync();

    /// <summary>
    /// Persiste revisão da legenda via API.
    /// </summary>
    private async Task SaveCaptionAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanReviseCaption)
        {
            return;
        }

        _isSavingCaption = true;
        _errorMessage = null;

        var reviseResult = await SocialClient.ReviseCaptionAsync(WorkspaceId, _displayedPost.Id, _editCaption);
        _isSavingCaption = false;

        if (reviseResult.IsFailure)
        {
            _errorMessage = reviseResult.Error.Description;
            return;
        }

        _displayedPost = reviseResult.Value;
        _editCaption = _displayedPost.Caption;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    /// <summary>
    /// Envia post em rascunho ou com alterações solicitadas para o quadro de aprovação.
    /// </summary>
    private async Task SubmitForApprovalAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanSubmitForApproval)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var submitResult = await SocialClient.SubmitForApprovalAsync(WorkspaceId, _displayedPost.Id);
        _isSubmitting = false;

        if (submitResult.IsFailure)
        {
            _errorMessage = submitResult.Error.Description;
            return;
        }

        _displayedPost = submitResult.Value;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    /// <summary>
    /// Aprova internamente um post já enviado para aprovação.
    /// </summary>
    private async Task ApproveInternalAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanApproveInternal)
        {
            return;
        }

        _isApproving = true;
        _errorMessage = null;

        var approveResult = await SocialClient.ApprovePostAsync(WorkspaceId, _displayedPost.Id);
        _isApproving = false;

        if (approveResult.IsFailure)
        {
            _errorMessage = approveResult.Error.Description;
            await NotifyPostUpdatedAsync(_displayedPost);
            return;
        }

        _displayedPost = approveResult.Value;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    /// <summary>
    /// Agenda a publicação de um post já aprovado (outbox).
    /// </summary>
    private async Task ScheduleAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanSchedule)
        {
            return;
        }

        _isScheduling = true;
        _errorMessage = null;

        var scheduleResult = await SocialClient.SchedulePostAsync(WorkspaceId, _displayedPost.Id);
        _isScheduling = false;

        if (scheduleResult.IsFailure)
        {
            _errorMessage = scheduleResult.Error.Description;
            return;
        }

        _displayedPost = scheduleResult.Value;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    private async Task NotifyPostUpdatedAsync(OrganicPostDto updated)
    {
        if (OnPostUpdated.HasDelegate)
        {
            await OnPostUpdated.InvokeAsync(updated);
        }
    }

    private void HandleBackdropKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _ = RequestClose();
        }
    }

    private void HandleDialogKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _ = RequestClose();
        }
    }

    private string FormatScheduledLocal(DateTime scheduledAtUtc)
    {
        var tz = ResolveTimeZone(TimeZoneId);
        var local = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(scheduledAtUtc, DateTimeKind.Utc),
            tz);
        return local.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    }

    private static TimeZoneInfo ResolveTimeZone(string timeZoneId)
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
        }
        catch (InvalidTimeZoneException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
        }
    }
}