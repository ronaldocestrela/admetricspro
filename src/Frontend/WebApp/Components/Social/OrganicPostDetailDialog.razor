@namespace WebApp.Components.Social
@using WebApp.Components.Shared.Components
@using WebApp.Services.Social
@using SocialPublishing.Application.Posts.DTOs
@using SocialPublishing.Domain.Connections
@using SocialPublishing.Domain.Posts
@inject ISocialPublishingClient SocialClient

@if (Post is not null)
{
    var captionParts = OrganicPostCaptionDisplay.Parse(Post.Caption);
    <div class="modal-backdrop organic-post-detail-backdrop"
         data-testid="organic-post-detail-backdrop"
         @onclick="RequestClose"
         @onkeydown="HandleBackdropKeydown">
        <div class="modal-dialog organic-post-detail-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="organic-post-detail-title"
             data-testid="organic-post-detail-dialog"
             @onclick:stopPropagation="true"
             @onkeydown="HandleDialogKeydown"
             tabindex="-1">
            <div class="modal-header">
                <h2 class="h5 mb-0" id="organic-post-detail-title">Post orgânico</h2>
                <button type="button"
                        class="btn-close"
                        aria-label="Fechar"
                        data-testid="organic-post-detail-close"
                        @onclick="RequestClose"></button>
            </div>
            <div class="modal-body">
                <div class="organic-post-detail-badges mb-3">
                    <div class="organic-post-detail-badge-row"
                         data-testid="organic-post-detail-status-row">
                        <span class="organic-post-detail-badge-label">Status</span>
                        <OrganicPostStatusBadge Status="_displayedPost.Status"
                                                AdditionalCssClass="organic-post-detail-badge-pill" />
                    </div>
                    <div class="organic-post-detail-badge-row"
                         data-testid="organic-post-detail-pillar-row">
                        <span class="organic-post-detail-badge-label">Pilar</span>
                        <ContentPillarChip Pillar="Post.Pillar"
                                           AdditionalCssClass="organic-post-detail-badge-pill" />
                    </div>
                </div>
                <div class="organic-post-detail-meta-grid mb-3">
                    <div class="organic-post-detail-meta-item">
                        <span class="organic-post-detail-meta-label">Rede</span>
                        <span class="organic-post-detail-meta-value"
                              data-testid="organic-post-detail-meta-platform">@OrganicPostDisplayLabels.FormatPlatform(Post.Platform)</span>
                    </div>
                    <div class="organic-post-detail-meta-item">
                        <span class="organic-post-detail-meta-label">Formato</span>
                        <span class="organic-post-detail-meta-value"
                              data-testid="organic-post-detail-meta-format">@OrganicPostDisplayLabels.FormatPostFormat(Post.Format)</span>
                    </div>
                    <div class="organic-post-detail-meta-item organic-post-detail-meta-item-wide">
                        <span class="organic-post-detail-meta-label">Agendado para</span>
                        <span class="organic-post-detail-meta-value"
                              data-testid="organic-post-detail-meta-scheduled">@FormatScheduledLocal(Post.ScheduledAtUtc)</span>
                    </div>
                </div>
                <h3 class="h6 organic-post-detail-section-title">Legenda</h3>
                <p class="organic-post-detail-caption"
                   data-testid="organic-post-detail-caption-body">@captionParts.Body</p>
                @if (captionParts.Hashtags.Count > 0)
                {
                    <div class="organic-post-detail-hashtags"
                         data-testid="organic-post-detail-hashtags"
                         aria-label="Hashtags">
                        @foreach (var tag in captionParts.Hashtags)
                        {
                            <span class="organic-post-detail-hashtag"
                                  data-testid="organic-post-detail-hashtag">@tag</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert" data-testid="organic-post-detail-error">@_errorMessage</div>
                }
            </div>
            <div class="modal-footer">
                @if (CanSubmitForApproval)
                {
                    <button type="button"
                            class="btn btn-primary me-auto"
                            data-testid="organic-post-detail-submit-for-approval"
                            disabled="@_isLifecycleBusy"
                            @onclick="SubmitForApprovalAsync">
                        @if (_isSubmitting)
                        {
                            <span>Enviando…</span>
                        }
                        else
                        {
                            <span>Enviar para aprovação</span>
                        }
                    </button>
                }
                @if (CanApproveInternal)
                {
                    <button type="button"
                            class="btn btn-success me-auto"
                            data-testid="organic-post-detail-approve"
                            disabled="@_isLifecycleBusy"
                            @onclick="ApproveInternalAsync">
                        @if (_isApproving)
                        {
                            <span>Aprovando…</span>
                        }
                        else
                        {
                            <span>Aprovar</span>
                        }
                    </button>
                }
                @if (CanSchedule)
                {
                    <button type="button"
                            class="btn btn-primary me-auto"
                            data-testid="organic-post-detail-schedule"
                            disabled="@_isLifecycleBusy"
                            @onclick="ScheduleAsync">
                        @if (_isScheduling)
                        {
                            <span>Agendando…</span>
                        }
                        else
                        {
                            <span>Agendar publicação</span>
                        }
                    </button>
                }
                <button type="button" class="btn btn-outline-secondary" data-testid="organic-post-detail-done" @onclick="RequestClose">Fechar</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Post selecionado para exibição; ausência oculta o diálogo.
    /// </summary>
    [Parameter]
    public OrganicPostDto? Post { get; set; }

    /// <summary>
    /// Workspace proprietário do post (mutações de lifecycle na API).
    /// </summary>
    [Parameter]
    public Guid WorkspaceId { get; set; }

    /// <summary>
    /// Identificador IANA do fuso para exibir o horário agendado.
    /// </summary>
    [Parameter]
    public string TimeZoneId { get; set; } = "America/Sao_Paulo";

    /// <summary>
    /// Notifica o host para fechar o painel de detalhe.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Notifica o host quando o post foi atualizado após aprovação, agendamento ou envio parcial.
    /// </summary>
    [Parameter]
    public EventCallback<OrganicPostDto> OnPostUpdated { get; set; }

    private OrganicPostDto _displayedPost = null!;
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isApproving;
    private bool _isScheduling;

    private bool _isLifecycleBusy => _isSubmitting || _isApproving || _isScheduling;

    private bool CanSubmitForApproval => _displayedPost.Status == OrganicPostStatus.Draft;

    private bool CanApproveInternal => _displayedPost.Status == OrganicPostStatus.PendingApproval;

    private bool CanSchedule => _displayedPost.Status == OrganicPostStatus.Approved;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Post is null)
        {
            return;
        }

        if (_displayedPost?.Id != Post.Id)
        {
            _displayedPost = Post;
            _errorMessage = null;
            _isSubmitting = false;
            _isApproving = false;
            _isScheduling = false;
        }
        else if (_displayedPost.Status != Post.Status)
        {
            _displayedPost = Post;
        }
    }

    private async Task RequestClose() => await OnClose.InvokeAsync();

    /// <summary>
    /// Envia post em rascunho para o quadro de aprovação (cliente e interno).
    /// </summary>
    private async Task SubmitForApprovalAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanSubmitForApproval)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var submitResult = await SocialClient.SubmitForApprovalAsync(WorkspaceId, _displayedPost.Id);
        _isSubmitting = false;

        if (submitResult.IsFailure)
        {
            _errorMessage = submitResult.Error.Description;
            return;
        }

        _displayedPost = submitResult.Value;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    /// <summary>
    /// Aprova internamente um post já enviado para aprovação.
    /// </summary>
    private async Task ApproveInternalAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanApproveInternal)
        {
            return;
        }

        _isApproving = true;
        _errorMessage = null;

        var approveResult = await SocialClient.ApprovePostAsync(WorkspaceId, _displayedPost.Id);
        _isApproving = false;

        if (approveResult.IsFailure)
        {
            _errorMessage = approveResult.Error.Description;
            await NotifyPostUpdatedAsync(_displayedPost);
            return;
        }

        _displayedPost = approveResult.Value;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    /// <summary>
    /// Agenda a publicação de um post já aprovado (outbox).
    /// </summary>
    private async Task ScheduleAsync()
    {
        if (WorkspaceId == Guid.Empty || !CanSchedule)
        {
            return;
        }

        _isScheduling = true;
        _errorMessage = null;

        var scheduleResult = await SocialClient.SchedulePostAsync(WorkspaceId, _displayedPost.Id);
        _isScheduling = false;

        if (scheduleResult.IsFailure)
        {
            _errorMessage = scheduleResult.Error.Description;
            return;
        }

        _displayedPost = scheduleResult.Value;
        await NotifyPostUpdatedAsync(_displayedPost);
    }

    private async Task NotifyPostUpdatedAsync(OrganicPostDto updated)
    {
        if (OnPostUpdated.HasDelegate)
        {
            await OnPostUpdated.InvokeAsync(updated);
        }
    }

    private void HandleBackdropKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _ = RequestClose();
        }
    }

    private void HandleDialogKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _ = RequestClose();
        }
    }

    private string FormatScheduledLocal(DateTime scheduledAtUtc)
    {
        var tz = ResolveTimeZone(TimeZoneId);
        var local = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(scheduledAtUtc, DateTimeKind.Utc),
            tz);
        return local.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    }

    private static TimeZoneInfo ResolveTimeZone(string timeZoneId)
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
        }
        catch (InvalidTimeZoneException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
        }
    }
}