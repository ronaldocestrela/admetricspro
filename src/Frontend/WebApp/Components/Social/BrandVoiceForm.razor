@namespace WebApp.Components.Social
@using BuildingBlocks.Domain.Primitives
@using SocialPublishing.Application.Brand.DTOs
@using SocialPublishing.Domain
@using SocialPublishing.Domain.Brand
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Services.Social
@inject ISocialPublishingClient SocialClient

<div class="brand-voice-form" data-testid="brand-voice-form">
    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger" data-testid="brand-voice-load-error">@_loadError</div>
    }

    @if (!string.IsNullOrEmpty(_saveError))
    {
        <div class="alert alert-danger" data-testid="brand-voice-save-error">@_saveError</div>
    }

    @if (_isLoading)
    {
        <p class="text-muted" data-testid="brand-voice-loading">Carregando DNA de marca…</p>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label" for="brand-voice-tone">Tom de voz</label>
            <input id="brand-voice-tone" class="form-control" data-testid="brand-voice-tone" @bind="_tone" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="brand-voice-persona">Persona</label>
            <input id="brand-voice-persona" class="form-control" data-testid="brand-voice-persona" @bind="_persona" />
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">Informações do negócio</legend>
            <p class="small text-muted">Usadas pela IA para contextualizar legendas e criativos deste cliente.</p>
            <div class="mb-3">
                <label class="form-label" for="brand-voice-business-summary">Resumo do negócio</label>
                <textarea id="brand-voice-business-summary" class="form-control" rows="3" maxlength="2000" data-testid="brand-voice-business-summary" @bind="_businessSummary"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="brand-voice-target-audience">Público-alvo</label>
                <textarea id="brand-voice-target-audience" class="form-control" rows="2" maxlength="1000" data-testid="brand-voice-target-audience" @bind="_targetAudience"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="brand-voice-main-offer">Oferta principal</label>
                <textarea id="brand-voice-main-offer" class="form-control" rows="2" maxlength="1000" data-testid="brand-voice-main-offer" @bind="_mainOffer"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="brand-voice-differentiators">Diferenciais</label>
                <textarea id="brand-voice-differentiators" class="form-control" rows="2" maxlength="2000" data-testid="brand-voice-differentiators" @bind="_differentiators"></textarea>
            </div>
        </fieldset>

        <fieldset class="mb-3">
            <legend class="form-label">Identidade visual</legend>
            <p class="small text-muted">Use o seletor ou digite o hex (#RGB, #RRGGBB ou #RRGGBBAA).</p>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small" for="brand-voice-primary-color-picker">Primária</label>
                    <div class="brand-voice-color-picker-wrapper">
                        <input id="brand-voice-primary-color-picker"
                               type="color"
                               class="brand-voice-color-input"
                               title="Selecionar cor primária"
                               data-testid="brand-voice-primary-color-picker"
                               value="@GetColorPickerValue(_primaryColor, "#2563EB")"
                               @onchange="e => OnColorPicked(e, value => _primaryColor = value)" />
                        <input id="brand-voice-primary-color"
                               type="text"
                               class="form-control text-uppercase"
                               maxlength="9"
                               data-testid="brand-voice-primary-color"
                               @bind="_primaryColor"
                               placeholder="#2563EB" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small" for="brand-voice-secondary-color-picker">Secundária</label>
                    <div class="brand-voice-color-picker-wrapper">
                        <input id="brand-voice-secondary-color-picker"
                               type="color"
                               class="brand-voice-color-input"
                               title="Selecionar cor secundária"
                               data-testid="brand-voice-secondary-color-picker"
                               value="@GetColorPickerValue(_secondaryColor, "#FFFFFF")"
                               @onchange="e => OnColorPicked(e, value => _secondaryColor = value)" />
                        <input id="brand-voice-secondary-color"
                               type="text"
                               class="form-control text-uppercase"
                               maxlength="9"
                               data-testid="brand-voice-secondary-color"
                               @bind="_secondaryColor"
                               placeholder="#FFFFFF" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small" for="brand-voice-accent-color-picker">Destaque</label>
                    <div class="brand-voice-color-picker-wrapper">
                        <input id="brand-voice-accent-color-picker"
                               type="color"
                               class="brand-voice-color-input"
                               title="Selecionar cor de destaque"
                               data-testid="brand-voice-accent-color-picker"
                               value="@GetColorPickerValue(_accentColor, "#F59E0B")"
                               @onchange="e => OnColorPicked(e, value => _accentColor = value)" />
                        <input id="brand-voice-accent-color"
                               type="text"
                               class="form-control text-uppercase"
                               maxlength="9"
                               data-testid="brand-voice-accent-color"
                               @bind="_accentColor"
                               placeholder="#F59E0B" />
                    </div>
                </div>
            </div>
            @if (!_colorsValid)
            {
                <p class="small text-danger mt-2 mb-0" data-testid="brand-voice-colors-invalid">Informe cores válidas ou deixe os campos vazios.</p>
            }

            <div class="brand-voice-logo-section mt-3" data-testid="brand-voice-logo-section">
                <label class="form-label" for="brand-voice-logo-file">Logo do cliente</label>
                <p class="small text-muted mb-2">Usada como referência visual na geração de criativos (PNG, JPEG ou WebP, até 2 MB).</p>
                @if (_brandVoicePersisted)
                {
                    <InputFile id="brand-voice-logo-file"
                               data-testid="brand-voice-logo-file"
                               class="form-control"
                               accept=".png,.jpg,.jpeg,.webp"
                               OnChange="HandleLogoSelectedAsync" />
                    @if (!string.IsNullOrEmpty(_logoError))
                    {
                        <p class="small text-danger mt-2 mb-0" data-testid="brand-voice-logo-error">@_logoError</p>
                    }
                    @if (!string.IsNullOrEmpty(_logoSuccess))
                    {
                        <p class="small text-success mt-2 mb-0" data-testid="brand-voice-logo-success">@_logoSuccess</p>
                    }
                    @if (!string.IsNullOrEmpty(_logoPreviewDataUrl))
                    {
                        <div class="brand-voice-logo-preview mt-2" data-testid="brand-voice-logo-preview">
                            <img src="@_logoPreviewDataUrl" alt="Logo do cliente" class="brand-voice-logo-img" />
                        </div>
                    }
                    @if (_hasLogo)
                    {
                        <button type="button"
                                class="btn btn-outline-danger btn-sm mt-2"
                                data-testid="brand-voice-logo-remove"
                                disabled="@_logoBusy"
                                @onclick="RemoveLogoAsync">
                            Remover logo
                        </button>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0" data-testid="brand-voice-logo-blocked">Salve o DNA de marca antes de enviar a logo.</p>
                }
            </div>
        </fieldset>

        <div class="mb-3">
            <label class="form-label" for="brand-voice-mandatory-links">Links obrigatórios (um por linha)</label>
            <textarea id="brand-voice-mandatory-links" class="form-control" rows="2" data-testid="brand-voice-mandatory-links" @bind="_mandatoryLinksText"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label" for="brand-voice-forbidden-terms">Termos proibidos (um por linha)</label>
            <textarea id="brand-voice-forbidden-terms" class="form-control" rows="2" data-testid="brand-voice-forbidden-terms" @bind="_forbiddenTermsText"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label" for="brand-voice-emoji">Política de emoji</label>
            <select id="brand-voice-emoji" class="form-select" data-testid="brand-voice-emoji" @bind="_emojiPolicy">
                <option value="@EmojiPolicy.Allowed">Permitidos</option>
                <option value="@EmojiPolicy.Sparingly">Com moderação</option>
                <option value="@EmojiPolicy.Forbidden">Proibidos</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="brand-voice-hashtag-limit">Teto de hashtags</label>
            <input id="brand-voice-hashtag-limit" type="number" class="form-control" data-testid="brand-voice-hashtag-limit" @bind="_hashtagLimit" min="1" />
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">Pesos dos pilares (%)</legend>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <label class="form-label small">Autoridade</label>
                    <input type="number" class="form-control" data-testid="brand-voice-weight-authority" @bind="_authorityWeight" min="0" max="100" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">Venda</label>
                    <input type="number" class="form-control" data-testid="brand-voice-weight-sale" @bind="_saleWeight" min="0" max="100" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">Conexão</label>
                    <input type="number" class="form-control" data-testid="brand-voice-weight-connection" @bind="_connectionWeight" min="0" max="100" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">Prova social</label>
                    <input type="number" class="form-control" data-testid="brand-voice-weight-social-proof" @bind="_socialProofWeight" min="0" max="100" />
                </div>
            </div>
            <p class="small mt-2 mb-0" data-testid="brand-voice-weights-sum">Soma: @_weightsSum % @( _weightsSum == 100 ? "" : "(deve ser 100)")</p>
        </fieldset>

        <input type="hidden" data-testid="brand-voice-language" value="@_languageCode" />

        <button type="button"
                class="btn btn-primary"
                data-testid="brand-voice-save"
                disabled="@(!CanSave)"
                @onclick="SaveAsync">
            @if (_isSaving)
            {
                <span>Salvando…</span>
            }
            else
            {
                <span>Salvar DNA de marca</span>
            }
        </button>

        @if (!string.IsNullOrEmpty(_saveSuccess))
        {
            <div class="alert alert-success mt-3" data-testid="brand-voice-save-success">@_saveSuccess</div>
        }
    }
</div>

@using System.Text.RegularExpressions

@code {
    /// <summary>
    /// Workspace proprietário do perfil de voz de marca.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;
    private string? _loadError;
    private string? _saveError;
    private string? _saveSuccess;

    private string _tone = string.Empty;
    private string _persona = string.Empty;
    private string _mandatoryLinksText = string.Empty;
    private string _forbiddenTermsText = string.Empty;
    private EmojiPolicy _emojiPolicy = EmojiPolicy.Sparingly;
    private int _hashtagLimit = 20;
    private int _authorityWeight = 25;
    private int _saleWeight = 25;
    private int _connectionWeight = 25;
    private int _socialProofWeight = 25;
    private string _languageCode = "pt-BR";
    private string _businessSummary = string.Empty;
    private string _targetAudience = string.Empty;
    private string _mainOffer = string.Empty;
    private string _differentiators = string.Empty;
    private string _primaryColor = string.Empty;
    private string _secondaryColor = string.Empty;
    private string _accentColor = string.Empty;
    private bool _brandVoicePersisted;
    private bool _hasLogo;
    private string? _logoContentType;
    private string? _logoPreviewDataUrl;
    private string? _logoError;
    private string? _logoSuccess;
    private bool _logoBusy;

    private const long BrandLogoMaxBytes = 2_097_152;

    private static readonly Regex HexColorRegex = new(
        @"^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        RegexOptions.Compiled);

    private int _weightsSum => _authorityWeight + _saleWeight + _connectionWeight + _socialProofWeight;

    private bool _colorsValid =>
        IsOptionalColorValid(_primaryColor)
        && IsOptionalColorValid(_secondaryColor)
        && IsOptionalColorValid(_accentColor);

    private bool CanSave => !_isSaving && !_isLoading && _weightsSum == 100 && _colorsValid;

    private Guid _loadedForWorkspace;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (WorkspaceId == Guid.Empty)
        {
            return;
        }

        if (_loadedForWorkspace == WorkspaceId && !_isLoading)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        _saveError = null;
        _saveSuccess = null;
        StateHasChanged();

        var result = await SocialClient.GetBrandVoiceAsync(WorkspaceId);
        _isLoading = false;
        _loadedForWorkspace = WorkspaceId;

        if (result.IsSuccess)
        {
            ApplyDto(result.Value);
            _brandVoicePersisted = true;
            await LoadLogoPreviewAsync();
            return;
        }

        if (result.Error.Code == SocialErrors.BrandVoiceNotFound.Code)
        {
            ResetToEmptyDefaults();
            _brandVoicePersisted = false;
            return;
        }

        _loadError = result.Error.Description;
    }

    private void ApplyDto(BrandVoiceDto dto)
    {
        _tone = dto.Tone;
        _persona = dto.Persona;
        _mandatoryLinksText = string.Join(Environment.NewLine, dto.MandatoryLinks);
        _forbiddenTermsText = string.Join(Environment.NewLine, dto.ForbiddenTerms);
        _emojiPolicy = dto.EmojiPolicy;
        _hashtagLimit = dto.HashtagLimit;
        _authorityWeight = dto.AuthorityWeight;
        _saleWeight = dto.SaleWeight;
        _connectionWeight = dto.ConnectionWeight;
        _socialProofWeight = dto.SocialProofWeight;
        _languageCode = dto.LanguageCode;
        _businessSummary = dto.BusinessSummary ?? string.Empty;
        _targetAudience = dto.TargetAudience ?? string.Empty;
        _mainOffer = dto.MainOffer ?? string.Empty;
        _differentiators = dto.Differentiators ?? string.Empty;
        _primaryColor = dto.PrimaryColor ?? string.Empty;
        _secondaryColor = dto.SecondaryColor ?? string.Empty;
        _accentColor = dto.AccentColor ?? string.Empty;
        _hasLogo = dto.HasLogo;
        _logoContentType = dto.LogoContentType;
    }

    private void ResetToEmptyDefaults()
    {
        _tone = string.Empty;
        _persona = string.Empty;
        _mandatoryLinksText = string.Empty;
        _forbiddenTermsText = string.Empty;
        _emojiPolicy = EmojiPolicy.Sparingly;
        _hashtagLimit = 20;
        _authorityWeight = 25;
        _saleWeight = 25;
        _connectionWeight = 25;
        _socialProofWeight = 25;
        _languageCode = "pt-BR";
        _businessSummary = string.Empty;
        _targetAudience = string.Empty;
        _mainOffer = string.Empty;
        _differentiators = string.Empty;
        _primaryColor = string.Empty;
        _secondaryColor = string.Empty;
        _accentColor = string.Empty;
        _hasLogo = false;
        _logoContentType = null;
        _logoPreviewDataUrl = null;
        _logoError = null;
        _logoSuccess = null;
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _isSaving = true;
        _saveError = null;
        _saveSuccess = null;
        StateHasChanged();

        var mandatoryLinks = SplitLines(_mandatoryLinksText);
        var forbiddenTerms = SplitLines(_forbiddenTermsText);

        var result = await SocialClient.UpsertBrandVoiceAsync(
            WorkspaceId,
            _tone,
            _persona,
            mandatoryLinks,
            forbiddenTerms,
            _emojiPolicy,
            _hashtagLimit,
            _authorityWeight,
            _saleWeight,
            _connectionWeight,
            _socialProofWeight,
            _languageCode,
            NullIfWhiteSpace(_businessSummary),
            NullIfWhiteSpace(_targetAudience),
            NullIfWhiteSpace(_mainOffer),
            NullIfWhiteSpace(_differentiators),
            NullIfWhiteSpace(_primaryColor),
            NullIfWhiteSpace(_secondaryColor),
            NullIfWhiteSpace(_accentColor));

        _isSaving = false;

        if (result.IsFailure)
        {
            _saveError = result.Error.Description;
            return;
        }

        ApplyDto(result.Value);
        _brandVoicePersisted = true;
        _saveSuccess = "DNA de marca salvo com sucesso.";
    }

    private async Task LoadLogoPreviewAsync()
    {
        _logoPreviewDataUrl = null;
        if (!_hasLogo)
        {
            return;
        }

        var preview = await SocialClient.GetBrandVoiceLogoDataUrlAsync(WorkspaceId);
        if (preview.IsSuccess)
        {
            _logoPreviewDataUrl = preview.Value;
        }
    }

    private async Task HandleLogoSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        _logoError = null;
        _logoSuccess = null;

        if (file.Size > BrandLogoMaxBytes)
        {
            _logoError = "A logo excede 2 MB.";
            return;
        }

        _logoBusy = true;
        StateHasChanged();

        await using var stream = file.OpenReadStream(BrandLogoMaxBytes);
        var result = await SocialClient.UploadBrandVoiceLogoAsync(
            WorkspaceId,
            file.Name,
            file.ContentType,
            stream);

        _logoBusy = false;

        if (result.IsFailure)
        {
            _logoError = result.Error.Description;
            return;
        }

        ApplyDto(result.Value);
        _logoSuccess = "Logo enviada com sucesso.";
        await LoadLogoPreviewAsync();
    }

    private async Task RemoveLogoAsync()
    {
        _logoError = null;
        _logoSuccess = null;
        _logoBusy = true;
        StateHasChanged();

        var result = await SocialClient.DeleteBrandVoiceLogoAsync(WorkspaceId);
        _logoBusy = false;

        if (result.IsFailure)
        {
            _logoError = result.Error.Description;
            return;
        }

        ApplyDto(result.Value);
        _logoPreviewDataUrl = null;
        _logoSuccess = "Logo removida.";
    }

    private static IReadOnlyList<string> SplitLines(string text) =>
        text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string? NullIfWhiteSpace(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool IsOptionalColorValid(string value) =>
        string.IsNullOrWhiteSpace(value) || HexColorRegex.IsMatch(value.Trim());

    private static string GetColorPickerValue(string value, string fallbackWhenEmpty) =>
        ToSixDigitHex(value) ?? fallbackWhenEmpty;

    private static string? ToSixDigitHex(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        if (!HexColorRegex.IsMatch(trimmed))
        {
            return null;
        }

        return trimmed.Length switch
        {
            4 => $"#{trimmed[1]}{trimmed[1]}{trimmed[2]}{trimmed[2]}{trimmed[3]}{trimmed[3]}".ToUpperInvariant(),
            7 => trimmed.ToUpperInvariant(),
            9 => trimmed[..7].ToUpperInvariant(),
            _ => null,
        };
    }

    private static void OnColorPicked(ChangeEventArgs args, Action<string> assign)
    {
        var picked = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(picked))
        {
            return;
        }

        assign(picked.Trim().ToUpperInvariant());
    }
}
