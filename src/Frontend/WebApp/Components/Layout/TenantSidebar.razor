            </ul>
        </nav>
    </div>

    <div class="sidebar-footer">
        <div class="sidebar-user-identity">
            <div class="sidebar-user-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(UserName) ? "G" : UserName[..1].ToUpperInvariant())</div>
            <div class="sidebar-user-meta"><span class="sidebar-user-name">@UserName</span><span class="sidebar-user-role">@UserRole</span></div>
        </div>
        <button type="button" class="sidebar-logout-btn" disabled="@_isLoggingOut" @onclick="HandleLogout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M9 12h12m-5-5 5 5-5 5" /></svg>
            <span>@(_isLoggingOut ? "Saindo…" : "Sair da conta")</span>
        </button>
        <div class="tenant-status-pill">
            <span class="status-indicator"></span>
            <span class="status-text">Ambiente Isolado</span>
        </div>
    </div>
</aside>

@if (IsOpen)
{
    <div class="sidebar-backdrop" @onclick="HandleClose"></div>
}

@code {
    private IReadOnlyList<WorkspaceDto> _workspaces = Array.Empty<WorkspaceDto>();
    private bool _isLoadingWorkspaces;
    private string? _workspaceError;
    private int _requestVersion;
    private bool _disposed;
    private bool _isLoggingOut;
    private string UserName => TenantSessionStateProvider.CurrentSession?.FullName ?? "Gestor";
    private string UserRole => TenantSessionStateProvider.CurrentSession?.Role switch
    {
        "Owner" => "Administrador", "Manager" => "Gestor", "Operator" => "Operador", "Guest" => "Convidado", _ => "Gestor"
    };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        TenantSessionStateProvider.OnSessionChanged += HandleSessionChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged += HandleContextChanged;
        await LoadWorkspacesAsync();
    }

    private void HandleContextChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void HandleSessionChanged()
    {
        if (!_disposed) _ = InvokeAsync(async () => { await LoadWorkspacesAsync(); if (!_disposed) StateHasChanged(); });
    }

    private async Task LoadWorkspacesAsync()
    {
        var request = ++_requestVersion;
        if (!TenantSessionStateProvider.IsAuthenticated && TenantStateProvider.CurrentTenant.TenantId == Guid.Empty)
        {
            _workspaces = Array.Empty<WorkspaceDto>();
            _workspaceError = null;
            _isLoadingWorkspaces = false;
            return;
        }
        _isLoadingWorkspaces = true;
        _workspaceError = null;
        var result = await WorkspaceClientService.GetWorkspacesAsync(true);
        if (_disposed || request != _requestVersion) return;
        _isLoadingWorkspaces = false;
        if (result.IsSuccess) _workspaces = result.Value;
        else { _workspaces = Array.Empty<WorkspaceDto>(); _workspaceError = "Não foi possível carregar seus clientes."; }
    }

    private async Task HandleWorkspaceChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            var workspace = _workspaces.FirstOrDefault(item => item.Id == id);
            if (workspace is not null) await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(workspace.Id, workspace.Name);
        }
        else await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(null, null);
    }

    private async Task HandleLogout()
    {
        if (_isLoggingOut) return;
        _isLoggingOut = true;
        await WorkspaceContextStateProvider.ClearAsync();
        await TenantSessionStateProvider.ClearSessionAsync();
        NavigationManager.NavigateTo("/login");
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _disposed = true;
        _requestVersion++;
        TenantSessionStateProvider.OnSessionChanged -= HandleSessionChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged -= HandleContextChanged;
    }

    /// <summary>
    /// Indica se a barra lateral está aberta em modo móvel/responsivo.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Callback disparado para fechar a barra lateral.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "AD";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
