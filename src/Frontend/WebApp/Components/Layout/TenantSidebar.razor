@namespace WebApp.Components.Layout
@inject ITenantStateProvider TenantStateProvider
@inject ITenantSessionStateProvider TenantSessionStateProvider
@inject IWorkspaceContextStateProvider WorkspaceContextStateProvider
@inject IWorkspaceClientService WorkspaceClientService
@inject NavigationManager NavigationManager
@using Tenants.Application.Workspaces.DTOs
@implements IDisposable

<aside id="tenant-sidebar" class="tenant-sidebar @(IsOpen ? "open" : "")">
    <div class="sidebar-header">
        <a class="sidebar-brand" href="/dashboard">
            @if (!string.IsNullOrEmpty(TenantStateProvider.CurrentTenant.Branding.LogoUrl))
            {
                <img src="@TenantStateProvider.CurrentTenant.Branding.LogoUrl" 
                     alt="@TenantStateProvider.CurrentTenant.Name" 
                     class="sidebar-logo" />
            }
            else
            {
                <div class="sidebar-initials-badge">
                    @GetInitials(TenantStateProvider.CurrentTenant.Name)
                </div>
            }
            <span class="sidebar-brand-name" title="@TenantStateProvider.CurrentTenant.Name">
                @TenantStateProvider.CurrentTenant.Name
            </span>
        </a>

        <button type="button" class="sidebar-close-btn" @onclick="HandleClose" aria-label="Fechar menu de navegação">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <div class="sidebar-scroll-area">
        <div class="sidebar-workspace-wrapper">
            <label for="sidebar-workspace-select" class="sidebar-workspace-label">Cliente ativo</label>
            <select id="sidebar-workspace-select" class="sidebar-workspace-select"
                    value="@(WorkspaceContextStateProvider.CurrentWorkspaceId?.ToString() ?? "")"
                    @onchange="HandleWorkspaceChanged" disabled="@_isLoadingWorkspaces">
                <option value="">Todos os clientes</option>
                @foreach (var workspace in _workspaces)
                {
                    <option value="@workspace.Id">@workspace.Name</option>
                }
            </select>
            @if (_isLoadingWorkspaces) { <span class="sidebar-workspace-hint" role="status">Carregando clientes…</span> }
            @if (!string.IsNullOrWhiteSpace(_workspaceError)) { <span class="sidebar-workspace-hint" role="status">@_workspaceError</span> }
        </div>
        <nav class="sidebar-navigation" aria-label="Navegação da área do cliente">
            <div class="nav-section-label">Central Operacional</div>
            <ul class="nav-links-list">
                <li>
                    <NavLink @onclick="HandleClose" href="dashboard" Match="NavLinkMatch.All" class="nav-link-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span class="nav-link-text">Visão Geral</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink @onclick="HandleClose" href="workspaces" class="nav-link-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span class="nav-link-text">Clientes (Workspaces)</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink @onclick="HandleClose" href="squads" class="nav-link-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span class="nav-link-text">Times (Squads)</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink @onclick="HandleClose" href="ad-management" class="nav-link-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 18 22 12 16 6"></polyline>
                            <polyline points="8 6 2 12 8 18"></polyline>
                        </svg>
                        <span class="nav-link-text">Gerenciamento de Anúncios</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink @onclick="HandleClose" href="integrations" class="nav-link-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
