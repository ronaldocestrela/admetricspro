@namespace WebApp.Components.Layout
@using Tenants.Application.Workspaces.DTOs
@implements IDisposable
@inject ITenantStateProvider TenantStateProvider
@inject ITenantSessionStateProvider TenantSessionStateProvider
@inject IWorkspaceContextStateProvider WorkspaceContextStateProvider
@inject IWorkspaceClientService WorkspaceClientService
@inject NavigationManager NavigationManager

<header class="tenant-top-header">
    <div class="header-left-section">
        <button type="button" class="tenant-mobile-toggle" @onclick="HandleToggle" aria-label="Alternar navegação móvel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <a href="dashboard" class="tenant-brand-wrapper">
            @if (!string.IsNullOrEmpty(TenantStateProvider.CurrentTenant.Branding.LogoUrl))
            {
                <img src="@TenantStateProvider.CurrentTenant.Branding.LogoUrl" 
                     alt="@TenantStateProvider.CurrentTenant.Name" 
                     class="tenant-brand-logo" />
            }
            else
            {
                <span class="tenant-brand-initials">
                    @GetInitials(TenantStateProvider.CurrentTenant.Name)
                </span>
            }
            <span class="tenant-brand-title">@TenantStateProvider.CurrentTenant.Name</span>
        </a>

        <!-- Seletor Global de Cliente Ativo (Workspace) -->
        <div class="header-workspace-wrapper" title="Cliente / Workspace Ativo">
            <div class="header-workspace-box">
                <svg class="workspace-box-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                </svg>
                <span class="workspace-box-label">Cliente:</span>
                <select class="header-workspace-select" 
                        id="header-workspace-select"
                        value="@(WorkspaceContextStateProvider.CurrentWorkspaceId?.ToString() ?? "")"
                        @onchange="HandleWorkspaceChanged">
                    <option value="">Todos os Clientes (Consolidado)</option>
                    @if (_workspaces != null)
                    {
                        @foreach (var ws in _workspaces)
                        {
                            <option value="@ws.Id">@ws.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="header-right-section">
        <div class="user-identity-widget">
            <div class="user-avatar-circle" title="@UserName">
                @GetUserInitial()
            </div>
            <div class="user-meta-info">
                <span class="user-full-name">@UserName</span>
                <span class="user-role-badge">@UserRole</span>
            </div>
        </div>

        <button type="button" class="logout-btn" @onclick="HandleLogout" title="Encerrar Sessão">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
        </button>
    </div>
</header>

@code {
    /// <summary>
    /// EventCallback acionado ao clicar no botão de alternância da barra lateral.
    /// </summary>
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private string UserName => TenantSessionStateProvider.CurrentSession?.FullName ?? "Gestor";
    private string UserRole => TenantSessionStateProvider.CurrentSession?.Role ?? "Gestor";
    private IReadOnlyList<WorkspaceDto>? _workspaces;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        WorkspaceContextStateProvider.OnWorkspaceChanged += HandleStateChanged;
        TenantSessionStateProvider.OnSessionChanged += HandleSessionChanged;
        await LoadWorkspacesAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadWorkspacesAsync();
            StateHasChanged();
        });
    }

    private async Task LoadWorkspacesAsync()
    {
        try
        {
            var res = await WorkspaceClientService.GetWorkspacesAsync(true);
            if (res.IsSuccess)
            {
                _workspaces = res.Value;
            }
        }
        catch
        {
            // Silencioso se chamada for feita antes de autenticar
        }
    }

    private async Task HandleWorkspaceChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var wsId) && wsId != Guid.Empty)
        {
            var ws = _workspaces?.FirstOrDefault(w => w.Id == wsId);
            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(wsId, ws?.Name);
        }
        else
        {
            await WorkspaceContextStateProvider.SetActiveWorkspaceAsync(null, null);
        }
    }

    private async Task HandleToggle()
    {
        if (OnToggleSidebar.HasDelegate)
        {
            await OnToggleSidebar.InvokeAsync();
        }
    }

    private void HandleLogout()
    {
        TenantSessionStateProvider.ClearSession();
        WorkspaceContextStateProvider.Clear();
        NavigationManager.NavigateTo("/login");
    }

    private string GetUserInitial()
    {
        if (string.IsNullOrWhiteSpace(UserName))
            return "U";

        return UserName[0].ToString().ToUpperInvariant();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "AD";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        WorkspaceContextStateProvider.OnWorkspaceChanged -= HandleStateChanged;
        TenantSessionStateProvider.OnSessionChanged -= HandleSessionChanged;
    }
}
