@inherits LayoutComponentBase
@implements IDisposable
@namespace WebApp.Components.Layout
@inject ITenantStateProvider TenantStateProvider
@inject ITenantSessionStateProvider TenantSessionStateProvider
@inject IWorkspaceContextStateProvider WorkspaceContextStateProvider
@inject NavigationManager NavigationManager

<HeadContent>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/tenant-workspace.css" />
    <title>@(string.IsNullOrWhiteSpace(TenantStateProvider.CurrentTenant.Name) ? "AdMetricsPro" : TenantStateProvider.CurrentTenant.Name)</title>
    @if (!string.IsNullOrWhiteSpace(TenantStateProvider.CurrentTenant.Branding.FaviconUrl))
    {
        <link rel="icon" type="image/x-icon" href="@TenantStateProvider.CurrentTenant.Branding.FaviconUrl" />
    }
</HeadContent>

<div class="tenant-app-shell @(_isSidebarOpen ? "sidebar-is-open" : "")" @onkeydown="HandleKeyDown" style="@TenantStateProvider.CurrentTenant.Branding.ToCssVariables()">
    <button type="button" class="tenant-mobile-toggle" aria-label="Alternar navegação móvel"
            aria-controls="tenant-sidebar" aria-expanded="@(_isSidebarOpen ? "true" : "false")" @onclick="ToggleSidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        <span>Menu</span>
    </button>
    <TenantTrialBanner DaysRemaining="@TenantStateProvider.CurrentTenant.TrialDaysRemaining" IsTrial="@TenantStateProvider.CurrentTenant.IsTrial" />

    <div class="tenant-layout-body">
        <TenantSidebar IsOpen="_isSidebarOpen" OnClose="CloseSidebar" />

        <main class="tenant-main-content">
            @if (_isRestoringSession)
            {
                <div class="tenant-session-loading-shell text-center py-5" data-testid="tenant-session-loading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-3 text-muted small fw-semibold">Restaurando sessão corporativa segura...</p>
                </div>
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado no processamento da página.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isSidebarOpen;
    private bool _isRestoringSession;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        TenantStateProvider.OnTenantChanged += HandleStateChanged;
        TenantSessionStateProvider.OnSessionChanged += HandleStateChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged += HandleStateChanged;

        _isRestoringSession = !TenantSessionStateProvider.IsAuthenticated &&
                              TenantStateProvider.CurrentTenant.TenantId == Guid.Empty;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var needsStateHasChanged = false;

            if (!TenantSessionStateProvider.IsAuthenticated)
            {
                var restoredSession = await TenantSessionStateProvider.RestoreSessionAsync();
                if (restoredSession)
                {
                    needsStateHasChanged = true;
                }
            }

            if (!WorkspaceContextStateProvider.HasWorkspaceSelected)
            {
                var restoredWs = await WorkspaceContextStateProvider.RestoreActiveWorkspaceAsync();
                if (restoredWs.HasValue)
                {
                    needsStateHasChanged = true;
                }
            }

            if (_isRestoringSession)
            {
                _isRestoringSession = false;
                needsStateHasChanged = true;
            }

            if (needsStateHasChanged)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseSidebar();
    }

    private void ToggleSidebar()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }

    private void CloseSidebar()
    {
        _isSidebarOpen = false;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        TenantStateProvider.OnTenantChanged -= HandleStateChanged;
        TenantSessionStateProvider.OnSessionChanged -= HandleStateChanged;
        WorkspaceContextStateProvider.OnWorkspaceChanged -= HandleStateChanged;
    }
}
