@* <summary>Seção pública do AdMetricsPro, preservando a composição e as interações da referência.</summary> *@
<section class="relative z-10 w-full py-space-2xl bg-surface-container-lowest/60 backdrop-blur-md">
    <div class="max-w-[1200px] mx-auto px-gutter-mobile lg:px-gutter flex flex-col items-center text-center">
        <p class="font-headline-card text-headline-card text-on-surface max-w-[800px] mb-space-xl font-medium">
            “Quatro redes de anúncios. Uma visão para decidir onde investir.”
        </p>

        <!-- 4 Elementos Conectados em Linha Horizontal -->
        <div class="w-full max-w-[880px] grid grid-cols-2 md:grid-cols-4 gap-space-md items-center justify-center">
            <div class="flex items-center justify-center gap-space-sm p-space-md rounded-xl bg-surface-container shadow-sm">
                <span aria-hidden="true" class="material-symbols-outlined text-primary text-[24px]">campaign</span>
                <span class="font-body-md font-semibold text-on-surface">Meta Ads</span>
            </div>
            <div class="flex items-center justify-center gap-space-sm p-space-md rounded-xl bg-surface-container shadow-sm">
                <span aria-hidden="true" class="material-symbols-outlined text-secondary text-[24px]">search</span>
                <span class="font-body-md font-semibold text-on-surface">Google Ads</span>
            </div>
            <div class="flex items-center justify-center gap-space-sm p-space-md rounded-xl bg-surface-container shadow-sm">
                <span aria-hidden="true" class="material-symbols-outlined text-secondary-fixed-dim text-[24px]">travel_explore</span>
                <span class="font-body-md font-semibold text-on-surface">Bing Ads</span>
            </div>
            <div class="flex items-center justify-center gap-space-sm p-space-md rounded-xl bg-surface-container shadow-sm">
                <span aria-hidden="true" class="material-symbols-outlined text-tertiary text-[24px]">play_circle</span>
                <span class="font-body-md font-semibold text-on-surface">TikTok Ads</span>
            </div>
        </div>
    </div>
</section>
