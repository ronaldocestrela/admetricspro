@namespace WebApp.Components.Landing

<!--
    HeroSection: Apresentação principal do AdMetricsPro com tags de release, headline de alto impacto, CTAs e trust badges.
-->
<section class="hero-section">
    <div class="hero-ambient-glow"></div>
    <div class="hero-ambient-glow-secondary"></div>

    <div class="landing-container hero-content">
        <!-- Feature Announcement Pill -->
        <div class="release-pill">
            <span class="pill-dot"></span>
            <span class="pill-tag">Novo Release</span>
            <span style="color: var(--lp-outline);">•</span>
            <span>IA Preditiva de ROAS 3.0 disponível</span>
            <span class="material-symbols-outlined" style="font-size: 16px; color: var(--lp-tertiary);">arrow_forward</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title">
            Escale seu tráfego pago com <span class="text-gradient">inteligência preditiva</span> e ROAS máximo
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle">
            Centralize campanhas do Meta, Google, Bing e TikTok em um só cockpit. Automatize regras de otimização, corte gastos com criativos ruins e multiplique suas conversões em tempo real.
        </p>

        <!-- CTA Row -->
        <div class="hero-cta-group">
            <a href="/register" class="cta-trial">
                <span>Iniciar Teste Grátis de 14 Dias</span>
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
            </a>
            <a href="#demo" class="cta-demo">
                <span class="material-symbols-outlined" style="color: var(--lp-tertiary);">play_circle</span>
                <span>Agendar Demonstração ao Vivo</span>
            </a>
        </div>

        <!-- Trust Badges -->
        <div class="hero-trust-badges">
            <div class="trust-badge">
                <span class="material-symbols-outlined" style="color: var(--lp-secondary); font-size: 18px;">verified</span>
                <span>Sem cartão de crédito</span>
            </div>
            <span style="color: var(--lp-outline-variant);">•</span>
            <div class="trust-badge">
                <span class="material-symbols-outlined" style="color: var(--lp-tertiary); font-size: 18px;">bolt</span>
                <span>Integração em 2 minutos</span>
            </div>
            <span style="color: var(--lp-outline-variant);">•</span>
            <div class="trust-badge">
                <span class="material-symbols-outlined" style="color: var(--lp-primary); font-size: 18px;">query_stats</span>
                <span style="color: #ffffff; font-weight: 600;">+R$ 180M gerenciados em ads</span>
            </div>
        </div>
    </div>
</section>

@code {
    // Componente Hero principal da Landing Page do AdMetricsPro.
    // Contém a proposta de valor essencial, chamada para ação (CTA) e selos de confiança.
}
