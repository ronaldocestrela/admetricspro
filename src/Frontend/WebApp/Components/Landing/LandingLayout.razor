@inherits LayoutComponentBase
@namespace WebApp.Components.Landing

<!--
    LandingLayout: Layout dedicado full-width para a Landing Page institucional, sem barras laterais de aplicação interna.
-->
<div class="landing-shell">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro no processamento da página.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Layout mestre da Landing Page do AdMetricsPro.
    // Provê container estrutural full-width e isolamento visual em relação ao dashboard interno.
}
