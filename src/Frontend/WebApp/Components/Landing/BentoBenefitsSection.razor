@namespace WebApp.Components.Landing

<!--
    BentoBenefitsSection: Apresentação dos pilares tecnológicos fundamentais da plataforma em grade Bento.
-->
<section class="bento-section" id="recursos">
    <div class="landing-container">
        <div class="section-title-group">
            <span class="section-category">Engenharia de Alta Performance</span>
            <h2 class="section-title">O cockpit definitivo para gestores que escalam orçamentos reais</h2>
            <p class="section-description">
                Substitua dezenas de planilhas desatualizadas e decisões por intuição por uma infraestrutura orientada a dados em tempo real.
            </p>
        </div>

        <div class="bento-grid">
            <!-- Feature Card 1 -->
            <div class="bento-card">
                <div>
                    <div class="bento-icon-box" style="background: rgba(79, 70, 229, 0.15); color: var(--lp-primary);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">bolt</span>
                    </div>
                    <h3 class="bento-title">Regras Automatizadas &amp; Anti-Overspending</h3>
                    <p class="bento-desc">
                        Crie gatilhos customizados com limites rígidos de orçamento. Se o CPA disparar ou a taxa de rejeição subir, a regra pausa conjuntos em segundos.
                    </p>
                </div>
            </div>

            <!-- Feature Card 2 -->
            <div class="bento-card">
                <div>
                    <div class="bento-icon-box" style="background: rgba(16, 185, 129, 0.15); color: var(--lp-secondary);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">psychology</span>
                    </div>
                    <h3 class="bento-title">Detector de Fadiga de Criativos</h3>
                    <p class="bento-desc">
                        Algoritmos preditivos monitoram a curva de frequência e queda de CTR para alertar sua equipe exatamente quando um criativo perde eficiência.
                    </p>
                </div>
            </div>

            <!-- Feature Card 3 -->
            <div class="bento-card">
                <div>
                    <div class="bento-icon-box" style="background: rgba(6, 182, 212, 0.15); color: var(--lp-tertiary);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">hub</span>
                    </div>
                    <h3 class="bento-title">Atribuição Multi-Toque &amp; MER Unificado</h3>
                    <p class="bento-desc">
                        Tenha clareza cirúrgica sobre a contribuição de cada canal na jornada de compra. Acompanhe o Marketing Efficiency Ratio consolidado.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    // Componente de apresentação das funcionalidades chave em formato Bento Grid.
}
