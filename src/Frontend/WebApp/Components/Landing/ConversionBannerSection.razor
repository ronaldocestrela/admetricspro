@namespace WebApp.Components.Landing

<!--
    ConversionBannerSection: Banner de conversão final de alta visibilidade incentivando o teste gratuito.
-->
<section class="conversion-section" id="precos">
    <div class="landing-container">
        <div class="conversion-box">
            <h2 class="conversion-title">Pronto para assumir o controle absoluto do seu tráfego?</h2>
            <p class="conversion-desc">
                Junte-se a centenas de empresas que reduziram o desperdício de ad spend e escalaram com previsibilidade matemática.
            </p>

            <div class="hero-cta-group" style="margin-left: auto; margin-right: auto; margin-bottom: 0;">
                <a href="/register" class="cta-trial">
                    <span>Começar Agora Gratuitamente</span>
                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                </a>
                <a href="#demo" class="cta-demo">
                    <span class="material-symbols-outlined" style="color: var(--lp-tertiary);">headset_mic</span>
                    <span>Falar com um Especialista</span>
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    // Componente com banner de chamada final para cadastro e conversão da Landing Page.
}
