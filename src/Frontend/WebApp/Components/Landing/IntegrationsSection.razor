@namespace WebApp.Components.Landing

<!--
    IntegrationsSection: Fita contínua de plataformas de mídia paga e e-commerce integradas ao AdMetricsPro.
-->
<section class="integrations-section" id="integracoes">
    <div class="landing-container">
        <div class="integrations-label">Integrado nativamente com as principais plataformas do ecossistema</div>

        <div class="integrations-tape">
            <!-- Meta Ads -->
            <div class="integration-item">
                <div class="platform-badge-icon bg-meta">M</div>
                <span>Meta Ads</span>
            </div>

            <!-- Google Ads -->
            <div class="integration-item">
                <div class="platform-badge-icon bg-google">G</div>
                <span>Google Ads</span>
            </div>

            <!-- TikTok Ads -->
            <div class="integration-item">
                <div class="platform-badge-icon bg-tiktok">TT</div>
                <span>TikTok Ads</span>
            </div>

            <!-- Bing Ads -->
            <div class="integration-item">
                <div class="platform-badge-icon bg-bing">B</div>
                <span>Bing Ads</span>
            </div>

            <!-- Shopify -->
            <div class="integration-item">
                <div class="platform-badge-icon bg-shopify">S</div>
                <span>Shopify</span>
            </div>

            <!-- Hotmart -->
            <div class="integration-item">
                <div class="platform-badge-icon bg-hotmart">H</div>
                <span>Hotmart</span>
            </div>
        </div>
    </div>
</section>

@code {
    // Componente de exibição dos conectores e plataformas integradas à plataforma.
}
