@code {
    private int ActiveTab { get; set; } = 1;
    private int renderedTab;
    private ElementReference featureGrid, featureLine;
    private IJSObjectReference? lineModule, lineController;

    /// <summary>Inicializa as interações após a renderização interativa.</summary>
    /// <param name="firstRender">Indica a primeira renderização do componente.</param>
    /// <returns>Tarefa de inicialização dos módulos visuais.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            lineModule = await JS.InvokeAsync<IJSObjectReference>("import", "./landing/js/feature-line.js");
            lineController = await lineModule.InvokeAsync<IJSObjectReference>("initialize", featureGrid, featureLine, ActiveTab);
            renderedTab = ActiveTab;
        }
        else if (lineController is not null && renderedTab != ActiveTab)
        {
            renderedTab = ActiveTab;
            await lineController.InvokeVoidAsync("select", ActiveTab);
        }
    }

    /// <summary>Libera os módulos, referências e observadores visuais.</summary>
    /// <returns>Tarefa de liberação dos recursos.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (lineController is not null) { await lineController.InvokeVoidAsync("dispose"); await lineController.DisposeAsync(); }
            if (lineModule is not null) await lineModule.DisposeAsync();

        }
        catch (JSDisconnectedException) { /* O circuito já foi encerrado. */ }
    }

    private void SetActiveTab(int tab)
    {
        ActiveTab = tab;
    }

}
