@using Analytics.Application.Copilot.DTOs

<div class="copilot-anomaly-card @(Severity?.ToLowerInvariant())" id="anomaly-card-@(Action?.ActionId)">
    <div class="card-top-row">
        <div class="anomaly-type-badge">
            <span class="severity-tag @(Severity?.ToLowerInvariant())">@Severity</span>
            <span class="type-name">@Title</span>
        </div>
        @if (IsApplied || (Action?.IsApplied ?? false))
        {
            <span class="applied-badge" id="badge-applied-@Action?.ActionId">✅ Executado</span>
        }
    </div>

    <p class="anomaly-description">@Description</p>

    @if (OverlapAnomaly != null)
    {
        <AudienceOverlapVisualizer Anomaly="@OverlapAnomaly" />
    }
    else if (CannibalizationAnomaly != null)
    {
        <SearchCannibalizationCompare Anomaly="@CannibalizationAnomaly" />
    }

    @if (Action != null)
    {
        <div class="action-footer">
            <div class="action-info">
                <span class="action-label">Ação Recomendada (1 Clique):</span>
                <span class="action-title">@Action.Title</span>
                <span class="action-detail">@Action.Description</span>
            </div>

            <button class="btn-one-click @(IsApplied || Action.IsApplied ? "applied" : "")"
                    id="btn-execute-@Action.ActionId"
                    disabled="@(IsExecuting || IsApplied || Action.IsApplied)"
                    @onclick="HandleExecuteClick">
                @if (IsExecuting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Executando...</span>
                }
                else if (IsApplied || Action.IsApplied)
                {
                    <span>✅ Aplicado</span>
                }
                else
                {
                    <span class="bolt-icon">⚡</span>
                    <span>Executar em 1 Clique</span>
                }
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ExecutionFeedback))
    {
        <div class="execution-feedback alert @(ExecutionFeedbackSuccess ? "alert-success" : "alert-danger")" id="feedback-@Action?.ActionId">
            @ExecutionFeedback
        </div>
    }
</div>



@code {
    /// <summary>
    /// Título do tipo de anomalia.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Nível de severidade (Critical, High, Medium, Low).
    /// </summary>
    [Parameter]
    public string Severity { get; set; } = "High";

    /// <summary>
    /// Descrição técnica do diagnóstico.
    /// </summary>
    [Parameter]
    public string Description { get; set; } = string.Empty;

    /// <summary>
    /// Dados opcionais de sobreposição de públicos no Meta Ads.
    /// </summary>
    [Parameter]
    public AudienceOverlapAnomalyDto? OverlapAnomaly { get; set; }

    /// <summary>
    /// Dados opcionais de canibalização de busca.
    /// </summary>
    [Parameter]
    public SearchCannibalizationAnomalyDto? CannibalizationAnomaly { get; set; }

    /// <summary>
    /// Ação sugerida para execução em 1 clique.
    /// </summary>
    [Parameter]
    public CopilotRecommendationActionDto? Action { get; set; }

    /// <summary>
    /// Callback disparado ao acionar o botão de execução em 1 clique.
    /// </summary>
    [Parameter]
    public EventCallback<CopilotRecommendationActionDto> OnExecuteAction { get; set; }

    /// <summary>
    /// Indica se a ação já foi executada.
    /// </summary>
    [Parameter]
    public bool IsApplied { get; set; }

    private bool IsExecuting { get; set; }
    private string? ExecutionFeedback { get; set; }
    private bool ExecutionFeedbackSuccess { get; set; }

    private async Task HandleExecuteClick()
    {
        if (Action == null || IsExecuting || IsApplied || Action.IsApplied)
        {
            return;
        }

        IsExecuting = true;
        ExecutionFeedback = null;

        try
        {
            if (OnExecuteAction.HasDelegate)
            {
                await OnExecuteAction.InvokeAsync(Action);
                IsApplied = true;
                ExecutionFeedbackSuccess = true;
                ExecutionFeedback = $"Recomendação '{Action.Title}' executada com sucesso!";
            }
        }
        catch (Exception ex)
        {
            ExecutionFeedbackSuccess = false;
            ExecutionFeedback = $"Erro na execução da ação: {ex.Message}";
        }
        finally
        {
            IsExecuting = false;
        }
    }
}
