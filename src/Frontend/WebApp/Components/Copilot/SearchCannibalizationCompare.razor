@using Analytics.Application.Copilot.DTOs

<div class="cannibalization-compare" id="cannibalization-comp-@Anomaly?.SearchTerm?.Replace(" ", "-")">
    <div class="cannibalization-header">
        <div class="term-badge">
            <span class="term-icon">🔍</span>
            <span class="term-text">"@Anomaly?.SearchTerm"</span>
        </div>
        <div class="disparity-badge">
            Disparidade: @(Anomaly?.DisparityRatio.ToString("F1") ?? "0.0")x
        </div>
    </div>

    <div class="channels-grid">
        <div class="channel-card channel-a">
            <div class="channel-card-header">
                <span class="channel-name">@Anomaly?.ChannelA</span>
                <span class="campaign-name" title="@Anomaly?.CampaignNameA">@Anomaly?.CampaignNameA</span>
            </div>
            <div class="channel-metrics">
                <div class="metric-item">
                    <span class="metric-label">CPC</span>
                    <span class="metric-val">R$ @(Anomaly?.CpcA.ToString("N2") ?? "0,00")</span>
                </div>
                <div class="metric-item highlight">
                    <span class="metric-label">CPA</span>
                    <span class="metric-val">R$ @(Anomaly?.CpaA.ToString("N2") ?? "0,00")</span>
                </div>
                <div class="metric-item">
                    <span class="metric-label">Gasto</span>
                    <span class="metric-val">R$ @(Anomaly?.SpendA.ToString("N2") ?? "0,00")</span>
                </div>
            </div>
        </div>

        <div class="channel-card channel-b">
            <div class="channel-card-header">
                <span class="channel-name">@Anomaly?.ChannelB</span>
                <span class="campaign-name" title="@Anomaly?.CampaignNameB">@Anomaly?.CampaignNameB</span>
            </div>
            <div class="channel-metrics">
                <div class="metric-item">
                    <span class="metric-label">CPC</span>
                    <span class="metric-val">R$ @(Anomaly?.CpcB.ToString("N2") ?? "0,00")</span>
                </div>
                <div class="metric-item highlight">
                    <span class="metric-label">CPA</span>
                    <span class="metric-val">R$ @(Anomaly?.CpaB.ToString("N2") ?? "0,00")</span>
                </div>
                <div class="metric-item">
                    <span class="metric-label">Gasto</span>
                    <span class="metric-val">R$ @(Anomaly?.SpendB.ToString("N2") ?? "0,00")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="waste-estimate-row">
        <span class="waste-label">💸 Desperdício Estimado:</span>
        <span class="waste-val">R$ @(Anomaly?.EstimatedMonthlyWastedSpend.ToString("N2") ?? "0,00")</span>
    </div>
</div>



@code {
    /// <summary>
    /// Dados da anomalia de canibalização entre canais de busca.
    /// </summary>
    [Parameter]
    public SearchCannibalizationAnomalyDto? Anomaly { get; set; }
}
