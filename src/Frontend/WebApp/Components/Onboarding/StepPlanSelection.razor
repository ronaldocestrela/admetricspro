@namespace WebApp.Components.Onboarding
@using Master.Domain.Tenants
@using System.Globalization

<section class="trial-guarantee" aria-labelledby="trial-title">
    <span class="trial-eyebrow"><span aria-hidden="true">✦</span> COMECE COM TRANQUILIDADE</span>
    <h2 id="trial-title">14 dias gratuitos.<br /><span>Seu próximo passo custa R$ 0.</span></h2>
    <p>Sem cartão de crédito. Sem dados de pagamento. Agora, você só precisa criar sua conta e aproveitar os recursos do plano escolhido.</p>
    <blockquote>“Use agora. Deixe o pagamento para quando perceber que está fazendo a melhor escolha para o seu negócio.”</blockquote>
    <p class="trial-confidence">Criamos o AdMetricsPro para trazer clareza às decisões e apoiar o crescimento da sua operação. Explore durante os 14 dias; ao fim do teste, você decide se quer ativar uma assinatura.</p>
    <div class="trial-assurances"><span>✓ 14 dias para experimentar</span><span>✓ Nenhum cartão agora</span><span>✓ Você decide depois</span></div>
</section>

<div class="step-heading">
    <h2>Plano & Recursos</h2>
    <p>Escolha a estrutura da sua operação. Os valores abaixo são referências para a assinatura após o teste; as condições vigentes serão confirmadas no checkout.</p>
</div>
<div class="billing-cycle-selector" role="group" aria-label="Periodicidade da assinatura após o teste">
    <button type="button" class="billing-cycle-option @(Model.BillingCycle == "Monthly" ? "is-active" : "")"
        aria-pressed="@(Model.BillingCycle == "Monthly" ? "true" : "false")" @onclick='() => SetBillingCycle("Monthly")'>Mensal</button>
    <button type="button" class="billing-cycle-option @(Model.BillingCycle == "Annual" ? "is-active" : "")"
        aria-pressed="@(Model.BillingCycle == "Annual" ? "true" : "false")" @onclick='() => SetBillingCycle("Annual")'>Anual <span class="annual-discount">20% de desconto</span></button>
</div>

<div class="plans-grid">
    @foreach (var plan in Plans)
    {
        <article class="pricing-card plan-card @(plan.Tier == SubscriptionTier.Pro ? "pricing-card-featured popular" : "") @(Model.Tier == plan.Tier ? "selected" : "")">
            @if (plan.Tier == SubscriptionTier.Pro) { <span class="plan-popular-badge">PARA AGÊNCIAS</span> }
            <span class="plan-category">@plan.Category</span>
            <h3 class="plan-name">@plan.Name</h3>
            <p class="plan-description">@plan.Description</p>
            <div class="plan-price">@FormatPrice(plan.MonthlyPrice * (Model.BillingCycle == "Annual" ? 0.8m : 1m))<span>/mês</span></div>
            <p class="plan-billing-note">@(Model.BillingCycle == "Annual" ? $"Referência anual: {FormatPrice(plan.MonthlyPrice * 12m * 0.8m)} após o teste." : "Referência mensal após o teste gratuito.")</p>
            <ul class="plan-features-list">
                @foreach (var feature in plan.Features) { <li class="check"><span aria-hidden="true">✓</span>@feature</li> }
            </ul>
            <button type="button" class="plan-select-button @(Model.Tier == plan.Tier ? "is-selected" : "")" data-plan="@plan.Name"
                    aria-pressed="@(Model.Tier == plan.Tier ? "true" : "false")" @onclick="() => SelectPlan(plan.Tier)">
                @(Model.Tier == plan.Tier ? "✓ Plano selecionado" : "Experimentar este plano")
            </button>
        </article>
    }
</div>

@code {
    /// <summary>Dados compartilhados da assinatura selecionada no cadastro.</summary>
    [Parameter, EditorRequired] public TenantOnboardingFormModel Model { get; set; } = null!;

    /// <summary>Notifica mudanças de plano e periodicidade.</summary>
    [Parameter] public EventCallback OnStateChanged { get; set; }

    private static readonly (SubscriptionTier Tier, string Name, string Category, string Description, decimal MonthlyPrice, string[] Features)[] Plans =
    [
        (SubscriptionTier.Starter, "Starter", "ENTRADA", "Para gestores e operações enxutas que querem centralizar suas primeiras contas.", 197m,
            ["2 assentos de usuário", "Até 3 workspaces", "Até R$ 50 mil em mídia", "Meta Ads e Google Ads", "Contas e campanhas centralizadas", "Relatórios padrão"]),
        (SubscriptionTier.Pro, "Pro", "CRESCIMENTO", "Para agências que precisam organizar vários clientes e controlar o investimento.", 497m,
            ["8 assentos de usuário", "Até 15 workspaces", "Até R$ 300 mil em mídia", "Meta, Google, Bing e TikTok", "Pacing e proteção de orçamento", "White-label conforme o plano", "Relatórios para sua carteira"]),
        (SubscriptionTier.Enterprise, "Enterprise", "ALTO VOLUME", "Para operações com múltiplas equipes e necessidades avançadas de gestão.", 1497m,
            ["Assentos conforme contratação", "Workspaces conforme contratação", "As quatro redes de anúncios", "Gestão de equipes e carteiras", "Domínio próprio conforme o plano", "Condições confirmadas no checkout"])
    ];

    private static string FormatPrice(decimal amount) => amount.ToString("C", CultureInfo.GetCultureInfo("pt-BR"));
    private async Task SelectPlan(SubscriptionTier tier) { Model.Tier = tier; await NotifyChanged(); }
    private async Task SetBillingCycle(string cycle) { Model.BillingCycle = cycle; await NotifyChanged(); }
    private async Task NotifyChanged() { if (OnStateChanged.HasDelegate) await OnStateChanged.InvokeAsync(); }
}
