@namespace WebApp.Components.Onboarding
@using BuildingBlocks.Domain.Tenants
@using WebApp.Models
@using WebApp.Services
@inject ITenantOnboardingClientService OnboardingClientService

<div class="step-heading">
    <h2>Dados Corporativos & Fiscais</h2>
    <p>Identifique sua organização para dimensionamento da infraestrutura dedicada do AdMetricsPro.</p>
</div>

<div class="form-group">
    <label class="form-label" for="company-name">Razão Social ou Nome Fantasia *</label>
    <div class="input-with-icon">
        <span class="input-icon">🏢</span>
        <input id="company-name"
               type="text"
               class="custom-input"
               placeholder="Ex.: Agência Vanguarda Digital Ltda"
               @bind="Model.CompanyName"
               @bind:after="OnFieldChanged" />
    </div>
</div>

<div class="form-row">
    <div class="form-group">
        <label class="form-label" for="company-cnpj">CPF ou CNPJ da Empresa / Gestor *</label>
        <div class="input-with-icon">
            <span class="input-icon">📋</span>
            <input id="company-cnpj"
                   type="text"
                   class="custom-input"
                   placeholder="000.000.000-00 ou 00.000.000/0000-00"
                   maxlength="18"
                   @bind="Model.Cnpj"
                   @bind:after="OnDocumentChangedAsync" />
        </div>

        @if (_isCheckingDocument)
        {
            <div class="status-pill warning" style="margin-top: 0.5rem;">
                <span>Checando disponibilidade do documento...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_documentStatusMessage))
        {
            <div class="status-pill @(_isDocumentValid && _isDocumentAvailable ? "success" : "error")" style="margin-top: 0.5rem;">
                <span>@(_isDocumentValid && _isDocumentAvailable ? "✓" : "⚠") @_documentStatusMessage</span>
            </div>
        }
    </div>

    <div class="form-group">
        <label class="form-label" for="company-segment">Segmento de Mercado</label>
        <select id="company-segment"
                class="custom-input no-icon"
                @bind="Model.Segment"
                @bind:after="OnFieldChanged">
            <option value="Agência de Performance">Agência de Tráfego / Performance</option>
            <option value="E-commerce / D2C">E-commerce / D2C</option>
            <option value="Infoprodutos / Lançamentos">Infoprodutos / Lançamentos</option>
            <option value="Empresa B2B / SaaS">Empresa B2B / SaaS</option>
            <option value="Outro">Outro Segmento</option>
        </select>
    </div>
</div>

<div class="form-group">
    <label class="form-label" for="ad-spend-range">Investimento Mensal Médio em Tráfego Pago</label>
    <select id="ad-spend-range"
            class="custom-input no-icon"
            @bind="Model.MonthlyAdSpendRange"
            @bind:after="OnFieldChanged">
        <option value="Até R$ 20.000 / mês">Até R$ 20.000 / mês</option>
        <option value="R$ 20.000 a R$ 100.000 / mês">R$ 20.000 a R$ 100.000 / mês</option>
        <option value="R$ 100.000 a R$ 500.000 / mês">R$ 100.000 a R$ 500.000 / mês</option>
        <option value="Acima de R$ 500.000 / mês">Acima de R$ 500.000 / mês</option>
    </select>
</div>

@code {
    /// <summary>
    /// Modelo de dados compartilhado do formulário de onboarding.
    /// </summary>
    [Parameter, EditorRequired]
    public TenantOnboardingFormModel Model { get; set; } = null!;

    /// <summary>
    /// Callback disparado quando campos são atualizados para sincronizar com o live preview.
    /// </summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    private bool _isCheckingDocument;
    private bool _isDocumentValid = true;
    private bool _isDocumentAvailable = true;
    private string? _documentStatusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Model.Cnpj))
        {
            await OnDocumentChangedAsync();
        }
    }

    private async Task OnDocumentChangedAsync()
    {
        var sanitized = Model.GetSanitizedCnpj();

        if (string.IsNullOrWhiteSpace(sanitized))
        {
            _documentStatusMessage = null;
            _isDocumentValid = true;
            _isDocumentAvailable = true;
            await OnFieldChanged();
            return;
        }

        // Aplica formatação de máscara dinâmica (CPF ou CNPJ)
        Model.Cnpj = TaxDocumentValidator.Format(sanitized);

        // Validação de comprimento
        if (sanitized.Length != 11 && sanitized.Length != 14)
        {
            _isDocumentValid = false;
            _isDocumentAvailable = false;
            _documentStatusMessage = "Informe um CPF (11 dígitos) ou CNPJ (14 dígitos) completo.";
            await OnFieldChanged();
            return;
        }

        // Validação algorítmica matemática (dígitos verificadores)
        var isAlgorithmicValid = TaxDocumentValidator.IsValid(sanitized);
        var docType = sanitized.Length == 11 ? "CPF" : "CNPJ";

        if (!isAlgorithmicValid)
        {
            _isDocumentValid = false;
            _isDocumentAvailable = false;
            _documentStatusMessage = $"{docType} inválido: dígitos verificadores incorretos.";
            await OnFieldChanged();
            return;
        }

        // Consulta de unicidade e disponibilidade em tempo real na Web API
        _isCheckingDocument = true;
        _documentStatusMessage = null;
        await OnFieldChanged();

        var checkResult = await OnboardingClientService.CheckTaxDocumentAvailabilityAsync(sanitized);
        _isCheckingDocument = false;

        if (checkResult.IsSuccess && checkResult.Value.IsAvailable)
        {
            _isDocumentValid = true;
            _isDocumentAvailable = true;
            _documentStatusMessage = $"{checkResult.Value.DocumentType} válido e disponível para registro!";
        }
        else
        {
            _isDocumentValid = checkResult.IsSuccess && checkResult.Value.IsValid;
            _isDocumentAvailable = false;
            _documentStatusMessage = checkResult.IsSuccess 
                ? checkResult.Value.Reason 
                : "Não foi possível validar o documento fiscal.";
        }

        await OnFieldChanged();
    }

    private async Task OnFieldChanged()
    {
        if (OnStateChanged.HasDelegate)
        {
            await OnStateChanged.InvokeAsync();
        }
    }
}
