@implements IDisposable
@inject IImpersonationStateProvider ImpersonationStateProvider
@inject IImpersonationClientService ImpersonationClientService
@inject NavigationManager NavigationManager

@if (ImpersonationStateProvider.CurrentSession.IsActive)
{
    <aside class="impersonation-banner" role="alert" aria-live="assertive">
        <div class="banner-content">
            <div class="banner-left">
                <span class="pulsing-indicator" aria-hidden="true"></span>
                <span class="banner-badge">🛡️ MODO SHADOW ATIVO (ACESSO AUDITADO)</span>
                
                <div class="banner-details">
                    <span class="ticket-info">
                        Chamado: <strong>@ImpersonationStateProvider.CurrentSession.SupportTicketId</strong>
                    </span>
                    <span class="admin-info">
                        Operador: <code>@ImpersonationStateProvider.CurrentSession.SuperAdminId</code>
                    </span>
                    @if (ImpersonationStateProvider.CurrentSession.ExpiresAtUtc.HasValue)
                    {
                        <span class="expires-info">
                            Expira em: <strong>@GetRemainingTimeDescription()</strong>
                        </span>
                    }
                </div>
            </div>

            <div class="banner-right">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <span class="banner-error">@_errorMessage</span>
                }

                <button class="terminate-btn" @onclick="HandleTerminateAsync" disabled="@_isTerminating" aria-label="Encerrar sessão de suporte e sair do Shadow Mode">
                    @if (_isTerminating)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>Encerrando...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                        </svg>
                        <span>Encerrar Sessão</span>
                    }
                </button>
            </div>
        </div>
    </aside>
}

@code {
    private bool _isTerminating;
    private string? _errorMessage;

    /// <summary>
    /// EventCallback opcional disparado quando o encerramento da sessão é concluído com sucesso.
    /// </summary>
    [Parameter]
    public EventCallback OnTerminated { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        ImpersonationStateProvider.OnSessionChanged += HandleSessionChanged;
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleTerminateAsync()
    {
        var session = ImpersonationStateProvider.CurrentSession;
        if (!session.IsActive || !session.TenantId.HasValue || !session.SessionId.HasValue)
        {
            ImpersonationStateProvider.ClearSession();
            return;
        }

        _isTerminating = true;
        _errorMessage = null;

        try
        {
            var result = await ImpersonationClientService.TerminateSessionAsync(
                session.TenantId.Value,
                session.SessionId.Value,
                "Encerramento manual acionado via ImpersonationBanner");

            if (result.IsFailure)
            {
                _errorMessage = result.Error.Description;
                return;
            }

            ImpersonationStateProvider.ClearSession();

            if (OnTerminated.HasDelegate)
            {
                await OnTerminated.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            _isTerminating = false;
        }
    }

    private string GetRemainingTimeDescription()
    {
        if (!ImpersonationStateProvider.CurrentSession.ExpiresAtUtc.HasValue)
        {
            return "Indeterminado";
        }

        var remaining = ImpersonationStateProvider.CurrentSession.ExpiresAtUtc.Value - DateTime.UtcNow;
        if (remaining.TotalMinutes <= 0)
        {
            return "Expirado";
        }

        if (remaining.TotalHours >= 1)
        {
            return $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
        }

        return $"{Math.Max(1, (int)remaining.TotalMinutes)} min";
    }

    /// <inheritdoc />
    public void Dispose()
    {
        ImpersonationStateProvider.OnSessionChanged -= HandleSessionChanged;
    }
}
