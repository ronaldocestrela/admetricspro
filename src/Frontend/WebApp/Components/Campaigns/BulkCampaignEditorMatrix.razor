@using BuildingBlocks.Application.Campaigns.Commands
@using BuildingBlocks.Domain.Campaigns
@using global::Integrations.Application.Campaigns.DTOs
@using WebApp.Services

<div class="bulk-matrix-container" data-testid="bulk-campaign-matrix">
    <div class="matrix-header">
        <div class="header-titles">
            <h2 class="matrix-title">Edição & Operações em Massa</h2>
            <p class="matrix-subtitle">Gerencie orçamentos e status simultaneamente em campanhas Meta, Google, TikTok e Bing.</p>
        </div>
        <div class="matrix-controls">
            <div class="filter-group">
                <label for="platform-filter">Plataforma:</label>
                <select id="platform-filter" class="filter-select" @bind="SelectedPlatform" @bind:after="ApplyFilters">
                    <option value="">Todas as Plataformas</option>
                    <option value="MetaAds">Meta Ads</option>
                    <option value="GoogleAds">Google Ads</option>
                    <option value="TikTokAds">TikTok Ads</option>
                    <option value="BingAds">Bing Ads</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="status-filter">Status:</label>
                <select id="status-filter" class="filter-select" @bind="SelectedStatus" @bind:after="ApplyFilters">
                    <option value="">Todos os Status</option>
                    <option value="Active">Ativas</option>
                    <option value="Paused">Pausadas</option>
                </select>
            </div>
        </div>
    </div>

    @if (SelectedCampaignIds.Count > 0)
    {
        <div class="bulk-action-bar" data-testid="bulk-action-bar">
            <div class="selection-summary">
                <span class="selection-badge">@SelectedCampaignIds.Count</span>
                <span class="selection-text">campanha(s) selecionada(s)</span>
            </div>

            <div class="action-buttons">
                <button type="button" class="btn btn-action btn-pause" data-testid="btn-bulk-pause" @onclick="() => OpenPreviewForAction(BulkCampaignActionType.Pause)">
                    <i class="bi bi-pause-circle"></i> Pausar Selecionadas
                </button>
                <button type="button" class="btn btn-action btn-activate" data-testid="btn-bulk-activate" @onclick="() => OpenPreviewForAction(BulkCampaignActionType.Activate)">
                    <i class="bi bi-play-circle"></i> Ativar Selecionadas
                </button>

                <div class="budget-adjust-group">
                    <select class="budget-type-select" @bind="AdjustmentMode">
                        <option value="percentage">Reajuste (%)</option>
                        <option value="fixed">Novo Valor (R$)</option>
                    </select>
                    <input type="number" step="0.01" class="budget-input" data-testid="input-budget-value" @bind="AdjustmentValue" placeholder="@(AdjustmentMode == "percentage" ? "+15 ou -10" : "250.00")" />
                    <button type="button" class="btn btn-action btn-adjust" data-testid="btn-bulk-adjust" @onclick="() => OpenPreviewForAction(BulkCampaignActionType.AdjustBudget)">
                        <i class="bi bi-graph-up-arrow"></i> Aplicar Orçamento
                    </button>
                </div>
            </div>
        </div>
    }

    @if (ExecutionResult is not null)
    {
        <div class="execution-report-card @(ExecutionResult.TotalFailed > 0 ? "has-failures" : "all-success")" data-testid="execution-report">
            <div class="report-header">
                <h4><i class="bi bi-clipboard-check"></i> Resultado da Operação em Lote</h4>
                <button type="button" class="btn-close-report" @onclick="() => ExecutionResult = null">×</button>
            </div>
            <div class="report-metrics">
                <span class="metric-pill pill-requested">Solicitadas: <strong>@ExecutionResult.TotalRequested</strong></span>
                <span class="metric-pill pill-success">Sucesso: <strong>@ExecutionResult.TotalSucceeded</strong></span>
                @if (ExecutionResult.TotalFailed > 0)
                {
                    <span class="metric-pill pill-failed">Falhas: <strong>@ExecutionResult.TotalFailed</strong></span>
                }
            </div>
            @if (ExecutionResult.FailedItems.Count > 0)
            {
                <div class="failed-items-table-wrapper">
                    <h5>Itens com Falha Individual (Tolerância Parcial)</h5>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Campanha ID</th>
                                <th>Ação</th>
                                <th>Código</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fail in ExecutionResult.FailedItems)
                            {
                                <tr>
                                    <td><code>@fail.CampaignId.ToString()[..8]...</code></td>
                                    <td>@fail.Action</td>
                                    <td><span class="badge-error-code">@fail.ErrorCode</span></td>
                                    <td>@fail.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="matrix-table-container">
        <table class="matrix-table" data-testid="matrix-table">
            <thead>
                <tr>
                    <th class="col-checkbox">
                        <input type="checkbox" data-testid="select-all-checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                    </th>
                    <th class="col-platform">Plataforma</th>
                    <th class="col-name">Nome da Campanha</th>
                    <th class="col-status">Status</th>
                    <th class="col-budget">Orçamento Diário</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredCampaigns.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="empty-state">Nenhuma campanha localizada para os filtros selecionados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var camp in FilteredCampaigns)
                    {
                        var isSelected = SelectedCampaignIds.Contains(camp.Id);
                        <tr class="@(isSelected ? "row-selected" : "")" data-testid="row-@camp.Id">
                            <td class="col-checkbox">
                                <input type="checkbox" data-testid="checkbox-@camp.Id" checked="@isSelected" @onchange="() => ToggleSelection(camp.Id)" />
                            </td>
                            <td class="col-platform">
                                <span class="platform-badge platform-@camp.Platform.ToLowerInvariant()">@camp.Platform</span>
                            </td>
                            <td class="col-name">
                                <div class="campaign-name-title">@camp.Name</div>
                                <div class="campaign-ext-id">ID: @camp.ExternalCampaignId</div>
                            </td>
                            <td class="col-status">
                                <span class="status-badge status-@camp.Status.ToLowerInvariant()">@camp.Status</span>
                            </td>
                            <td class="col-budget">
                                <span class="budget-value">@((camp.DailyBudget ?? 0m).ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ShowPreviewModal)
    {
        <div class="modal-backdrop-custom" data-testid="preview-modal">
            <div class="modal-dialog-custom">
                <div class="modal-header-custom">
                    <h3><i class="bi bi-shield-check"></i> Pré-visualização de Impacto em Massa</h3>
                    <button type="button" class="btn-close-modal" @onclick="ClosePreview">×</button>
                </div>
                <div class="modal-body-custom">
                    <p class="preview-description">
                        Você está prestes a aplicar a ação <strong>@PreviewActionLabel</strong> em <strong>@SelectedCampaignIds.Count</strong> campanha(s).
                    </p>

                    @if (PendingAction == BulkCampaignActionType.AdjustBudget)
                    {
                        <div class="impact-cards-grid">
                            <div class="impact-card">
                                <span class="impact-label">Investimento Atual / dia</span>
                                <span class="impact-value">@CurrentTotalDailyBudget.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span>
                            </div>
                            <div class="impact-card">
                                <span class="impact-label">Novo Investimento / dia</span>
                                <span class="impact-value highlight">@ProjectedTotalDailyBudget.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span>
                            </div>
                            <div class="impact-card">
                                <span class="impact-label">Variação Projetada</span>
                                <span class="impact-value @(BudgetVariance >= 0 ? "positive" : "negative")">
                                    @(BudgetVariance >= 0 ? "+" : "")@BudgetVariance.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                    (@(BudgetVariancePercentage >= 0 ? "+" : "")@BudgetVariancePercentage.ToString("F1")%)
                                </span>
                            </div>
                            <div class="impact-card">
                                <span class="impact-label">Impacto Mensal (30 dias)</span>
                                <span class="impact-value">@((BudgetVariance * 30m).ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))</span>
                            </div>
                        </div>
                    }

                    <div class="preview-table-wrapper">
                        <h4>Campanhas que serão modificadas:</h4>
                        <table class="preview-table">
                            <thead>
                                <tr>
                                    <th>Plataforma</th>
                                    <th>Nome</th>
                                    <th>Status Atual</th>
                                    <th>Orçamento Atual</th>
                                    <th>Novo Orçamento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var camp in GetSelectedCampaigns())
                                {
                                    <tr>
                                        <td>@camp.Platform</td>
                                        <td>@camp.Name</td>
                                        <td>@camp.Status</td>
                                        <td>@((camp.DailyBudget ?? 0m).ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))</td>
                                        <td>
                                            @if (PendingAction == BulkCampaignActionType.AdjustBudget)
                                            {
                                                <strong>@CalculateNewBudgetFor(camp).ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" data-testid="btn-cancel-preview" @onclick="ClosePreview">Cancelar</button>
                    <button type="button" class="btn btn-primary" data-testid="btn-confirm-bulk" disabled="@IsSubmitting" @onclick="ConfirmAndExecuteBulk">
                        @if (IsSubmitting)
                        {
                            <span>Processando...</span>
                        }
                        else
                        {
                            <span>Confirmar e Aplicar em Lote</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Identificador do Workspace em contexto.
    /// </summary>
    [Parameter]
    public Guid WorkspaceId { get; set; }

    /// <summary>
    /// Lista inicial de campanhas disponíveis para edição.
    /// </summary>
    [Parameter]
    public IReadOnlyList<CampaignHierarchyDto> Campaigns { get; set; } = Array.Empty<CampaignHierarchyDto>();

    /// <summary>
    /// Callback disparado após execução bem-sucedida de operações em lote.
    /// </summary>
    [Parameter]
    public EventCallback OnBulkOperationCompleted { get; set; }

    [Inject]
    public IBulkCampaignClientService BulkClientService { get; set; } = default!;

    public string SelectedPlatform { get; set; } = string.Empty;
    public string SelectedStatus { get; set; } = string.Empty;
    public HashSet<Guid> SelectedCampaignIds { get; } = new();

    public string AdjustmentMode { get; set; } = "percentage";
    public decimal? AdjustmentValue { get; set; } = 15m;

    public bool ShowPreviewModal { get; set; }
    public BulkCampaignActionType PendingAction { get; set; }
    public bool IsSubmitting { get; set; }
    public BulkCampaignOperationResultDto? ExecutionResult { get; set; }

    public IReadOnlyList<CampaignHierarchyDto> FilteredCampaigns => Campaigns
        .Where(c => string.IsNullOrEmpty(SelectedPlatform) || c.Platform.Equals(SelectedPlatform, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(SelectedStatus) || c.Status.Equals(SelectedStatus, StringComparison.OrdinalIgnoreCase))
        .ToList();

    public bool IsAllSelected => FilteredCampaigns.Count > 0 && FilteredCampaigns.All(c => SelectedCampaignIds.Contains(c.Id));

    public string PreviewActionLabel => PendingAction switch
    {
        BulkCampaignActionType.Activate => "ATIVAR",
        BulkCampaignActionType.Pause => "PAUSAR",
        BulkCampaignActionType.AdjustBudget => $"REAJUSTAR ORÇAMENTO ({(AdjustmentMode == "percentage" ? $"{AdjustmentValue}%" : $"R$ {AdjustmentValue}")})",
        _ => "EXECUTAR"
    };

    public decimal CurrentTotalDailyBudget => GetSelectedCampaigns().Sum(c => c.DailyBudget ?? 0m);

    public decimal ProjectedTotalDailyBudget => PendingAction == BulkCampaignActionType.AdjustBudget
        ? GetSelectedCampaigns().Sum(c => CalculateNewBudgetFor(c))
        : CurrentTotalDailyBudget;

    public decimal BudgetVariance => ProjectedTotalDailyBudget - CurrentTotalDailyBudget;

    public decimal BudgetVariancePercentage => CurrentTotalDailyBudget > 0
        ? (BudgetVariance / CurrentTotalDailyBudget) * 100m
        : 0m;

    public void ToggleSelection(Guid campaignId)
    {
        if (!SelectedCampaignIds.Add(campaignId))
        {
            SelectedCampaignIds.Remove(campaignId);
        }
    }

    public void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            foreach (var camp in FilteredCampaigns)
            {
                SelectedCampaignIds.Add(camp.Id);
            }
        }
        else
        {
            foreach (var camp in FilteredCampaigns)
            {
                SelectedCampaignIds.Remove(camp.Id);
            }
        }
    }

    public void ApplyFilters()
    {
        // Limpa seleções que não estão visíveis nos filtros se desejado ou mantém
    }

    public void OpenPreviewForAction(BulkCampaignActionType action)
    {
        if (SelectedCampaignIds.Count == 0) return;
        PendingAction = action;
        ShowPreviewModal = true;
    }

    public void ClosePreview()
    {
        ShowPreviewModal = false;
    }

    public decimal CalculateNewBudgetFor(CampaignHierarchyDto camp)
    {
        var current = camp.DailyBudget ?? 0m;
        if (AdjustmentMode == "fixed")
        {
            return Math.Max(0m, AdjustmentValue ?? current);
        }

        var percent = AdjustmentValue ?? 0m;
        var multiplier = 1m + (percent / 100m);
        return Math.Max(0m, Math.Round(current * multiplier, 2));
    }

    public IEnumerable<CampaignHierarchyDto> GetSelectedCampaigns()
    {
        return Campaigns.Where(c => SelectedCampaignIds.Contains(c.Id));
    }

    public async Task ConfirmAndExecuteBulk()
    {
        if (SelectedCampaignIds.Count == 0) return;

        IsSubmitting = true;
        try
        {
            var operations = new List<BulkCampaignOperationItem>();
            foreach (var id in SelectedCampaignIds)
            {
                if (PendingAction == BulkCampaignActionType.AdjustBudget)
                {
                    if (AdjustmentMode == "fixed")
                    {
                        operations.Add(new BulkCampaignOperationItem(id, PendingAction, DailyBudget: AdjustmentValue));
                    }
                    else
                    {
                        operations.Add(new BulkCampaignOperationItem(id, PendingAction, PercentageChange: AdjustmentValue));
                    }
                }
                else
                {
                    operations.Add(new BulkCampaignOperationItem(id, PendingAction));
                }
            }

            var result = await BulkClientService.ExecuteBulkOperationsAsync(WorkspaceId, operations);
            if (result.IsSuccess)
            {
                ExecutionResult = result.Value;
                SelectedCampaignIds.Clear();
                ShowPreviewModal = false;
                await OnBulkOperationCompleted.InvokeAsync();
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
