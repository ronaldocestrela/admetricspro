@inherits LayoutComponentBase

<div class="backoffice-shell">
    <BackofficeSidebar />

    <div class="backoffice-main">
        <BackofficeHeader />

        <main class="backoffice-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet style="display: none; position: fixed; bottom: 0; width: 100%; z-index: 1000; background: #EF4444; color: white; padding: 12px; text-align: center;">
    Ocorreu uma falha no processamento.
    <a href="." class="reload" style="color: white; font-weight: bold; margin-left: 8px;">Recarregar</a>
</div>
