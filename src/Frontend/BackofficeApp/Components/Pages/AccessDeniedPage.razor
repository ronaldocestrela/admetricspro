@page "/access-denied"
@layout EmptyLayout

<PageTitle>Acesso Negado — Backoffice</PageTitle>

<div class="login-container">
    <div class="login-card" style="text-align: center;">
        <div style="width: 56px; height: 56px; margin: 0 auto 16px auto; border-radius: 12px; background: rgba(239, 68, 68, 0.15); color: #EF4444; display: flex; align-items: center; justify-content: center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
        </div>

        <h1 class="login-title">Acesso Restrito</h1>
        <p class="login-subtitle" style="margin-bottom: 24px;">
            Sua conta de operador não possui as permissões necessárias (Papel SuperAdmin) para acessar este recurso.
        </p>

        <div style="display: flex; gap: 12px; justify-content: center;">
            <a href="/" class="btn-primary-block" style="text-decoration: none; display: inline-block; width: auto; padding: 10px 20px;">
                Ir para o Dashboard
            </a>
            <a href="/api/auth/logout" class="btn-logout" style="text-decoration: none; display: inline-flex; align-items: center; padding: 10px 16px;">
                Trocar de Conta
            </a>
        </div>
    </div>
</div>
