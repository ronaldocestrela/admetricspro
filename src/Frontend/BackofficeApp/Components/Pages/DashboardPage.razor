@page "/"
@page "/dashboard"
@attribute [Authorize(Policy = "RequireBackofficeAccess")]
@inject ITenantDirectoryService TenantDirectoryService
@inject IApiHealthClientService ApiHealthClientService

<PageTitle>Dashboard Geral — Backoffice AdMetricsPro</PageTitle>

<div class="dashboard-header" style="margin-bottom: 24px;">
    <h1 style="font-size: 24px; font-weight: 700; color: #F9FAFB; margin-bottom: 4px;">Console Executivo Global</h1>
    <p style="font-size: 14px; color: var(--text-secondary);">Visão unificada de governança, saúde da infraestrutura e diretório de tenants.</p>
</div>

@if (_isLoading)
{
    <div style="padding: 40px; text-align: center; color: var(--text-muted);">
        <p>Carregando telemetria do catálogo Master...</p>
    </div>
}
else
{
    <!-- Stat Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px;">
            <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Total de Tenants</div>
            <div style="font-size: 28px; font-weight: 700; color: #FFFFFF;">@_totalTenants</div>
            <div style="font-size: 12px; color: #10B981; margin-top: 4px;">@_activeTenants Ativos no Catálogo</div>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px;">
            <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Plataformas de Anúncios</div>
            <div style="font-size: 28px; font-weight: 700; color: #FFFFFF;">4 / 4</div>
            <div style="font-size: 12px; color: #6366F1; margin-top: 4px;">Meta, Google, Bing e TikTok</div>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px;">
            <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Status do Catálogo Master</div>
            <div style="font-size: 28px; font-weight: 700; color: #10B981;">Online</div>
            <div style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">Database-per-Tenant Ativo</div>
        </div>
    </div>

    <!-- Quick Navigation Cards -->
    <h2 style="font-size: 18px; font-weight: 600; color: #FFFFFF; margin-bottom: 16px;">Módulos de Gestão</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <a href="tenants" style="text-decoration: none; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; display: block; transition: all 0.2s ease;">
            <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(99, 102, 241, 0.15); color: #6366F1; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 600; color: #FFFFFF; margin-bottom: 6px;">Diretório de Tenants 360º</h3>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.4;">Gerenciamento completo do ciclo de vida, suspensão, reativação e shadow mode.</p>
        </a>

        <a href="plans" style="text-decoration: none; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; display: block; transition: all 0.2s ease;">
            <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(16, 185, 129, 0.15); color: #10B981; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 600; color: #FFFFFF; margin-bottom: 6px;">Planos &amp; Precificação</h3>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.4;">Configuração de limites de assentos, workspaces, teto de gastos e features liberadas.</p>
        </a>

        <a href="api-health" style="text-decoration: none; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; display: block; transition: all 0.2s ease;">
            <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(245, 158, 11, 0.15); color: #F59E0B; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 600; color: #FFFFFF; margin-bottom: 6px;">Saúde de APIs &amp; Quotas</h3>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.4;">Monitoramento de consumo de rate limits (80% / 95%), tokens revogados e falhas.</p>
        </a>

        <a href="feature-flags" style="text-decoration: none; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; display: block; transition: all 0.2s ease;">
            <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(239, 68, 68, 0.15); color: #EF4444; display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 600; color: #FFFFFF; margin-bottom: 6px;">Feature Flags &amp; Kill Switches</h3>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.4;">Disjuntores operacionais para contenção de falhas e rollout controlado.</p>
        </a>
    </div>
}

@code {
    private bool _isLoading = true;
    private int _totalTenants;
    private int _activeTenants;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenantsResult = await TenantDirectoryService.GetTenantsAsync();
            if (tenantsResult.IsSuccess)
            {
                _totalTenants = tenantsResult.Value.Count;
                _activeTenants = tenantsResult.Value.Count(t => t.Status.Equals("Active", StringComparison.OrdinalIgnoreCase));
            }
        }
        catch
        {
            // Silencioso no overview
        }
        finally
        {
            _isLoading = false;
        }
    }
}
