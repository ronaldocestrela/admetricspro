@using Microsoft.AspNetCore.Components.Forms
@using Master.Domain.Tenants
@using BackofficeApp.Models
@using BackofficeApp.Services
@inject IPlanManagementService PlanService

<div class="plan-builder-container card shadow-sm border-0">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-sliders me-2 text-primary"></i>
                @(CurrentModel.IsEditMode ? "Editar Plano de Assinatura" : "Construtor de Novo Plano")
            </h5>
            <small class="text-muted">Parametrize limites de assentos, workspaces, ad spend cap e flags funcionais do tier.</small>
        </div>
        <span class="badge @(CurrentModel.IsEditMode ? "bg-warning text-dark" : "bg-primary")">
            @(CurrentModel.IsEditMode ? "Modo Edição" : "Novo Cadastro")
        </span>
    </div>

    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger plan-error-banner d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                <div>
                    <strong>Erro na operação:</strong> @_errorMessage
                </div>
            </div>
        }

        <EditForm Model="CurrentModel" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <!-- Seção 1: Identificação Comercial & Tier -->
            <div class="mb-4">
                <h6 class="text-uppercase fw-semibold text-secondary small mb-3 tracking-wide">
                    <i class="bi bi-tag me-1"></i> Identificação Comercial & Classificação
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Nome Comercial do Plano <span class="text-danger">*</span></label>
                        <input type="text"
                               name="Name"
                               class="form-control"
                               placeholder="Ex: Agência Pro, Escala Ilimitada"
                               @bind="CurrentModel.Name" />
                        <ValidationMessage For="@(() => CurrentModel.Name)" class="text-danger small" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">Classificação de Tier <span class="text-danger">*</span></label>
                        <select name="Tier" class="form-select" @bind="CurrentModel.Tier">
                            @foreach (var tier in Enum.GetValues<SubscriptionTier>())
                            {
                                <option value="@tier">@tier</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium">Descrição do Valor & Público-Alvo</label>
                        <textarea class="form-control"
                                  rows="2"
                                  placeholder="Descreva o propósito do plano, restrições ou benefícios destacados..."
                                  @bind="CurrentModel.Description"></textarea>
                        <ValidationMessage For="@(() => CurrentModel.Description)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Seção 2: Precificação & Faturamento -->
            <div class="mb-4">
                <h6 class="text-uppercase fw-semibold text-secondary small mb-3 tracking-wide">
                    <i class="bi bi-currency-dollar me-1"></i> Precificação & Modelo Recorrente
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Preço Mensal (R$)</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input type="number"
                                   name="MonthlyPrice"
                                   step="0.01"
                                   class="form-control"
                                   @bind="CurrentModel.MonthlyPrice" />
                        </div>
                        <ValidationMessage For="@(() => CurrentModel.MonthlyPrice)" class="text-danger small" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">Desconto no Ciclo Anual (%)</label>
                        <div class="input-group">
                            <input type="number"
                                   name="AnnualDiscountPercentage"
                                   class="form-control"
                                   min="0"
                                   max="100"
                                   @bind="CurrentModel.AnnualDiscountPercentage" />
                            <span class="input-group-text">%</span>
                        </div>
                        <ValidationMessage For="@(() => CurrentModel.AnnualDiscountPercentage)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Seção 3: Cotas & Limites Operacionais -->
            <div class="mb-4">
                <h6 class="text-uppercase fw-semibold text-secondary small mb-3 tracking-wide">
                    <i class="bi bi-speedometer2 me-1"></i> Cotas Estruturais & Limites de Consumo
                </h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Assentos Máximos (Seats)</label>
                        <input type="number"
                               name="MaxSeats"
                               class="form-control"
                               min="1"
                               @bind="CurrentModel.MaxSeats" />
                        <small class="text-muted">Total de operadores e gestores simultâneos.</small>
                        <ValidationMessage For="@(() => CurrentModel.MaxSeats)" class="text-danger small" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-medium">Workspaces / Clientes Máximos</label>
                        <input type="number"
                               name="MaxWorkspaces"
                               class="form-control"
                               min="1"
                               @bind="CurrentModel.MaxWorkspaces" />
                        <small class="text-muted">Contas ou clientes isolados no tenant.</small>
                        <ValidationMessage For="@(() => CurrentModel.MaxWorkspaces)" class="text-danger small" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-medium">Teto de Ad Spend Mensal (R$)</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input type="number"
                                   name="MonthlyAdSpendCap"
                                   step="1000"
                                   class="form-control"
                                   @bind="CurrentModel.MonthlyAdSpendCap" />
                        </div>
                        <small class="text-muted">Limite de investimento sincronizado/mês.</small>
                        <ValidationMessage For="@(() => CurrentModel.MonthlyAdSpendCap)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Seção 4: Chaveamento Funcional (Feature Flags) -->
            <div class="mb-4">
                <h6 class="text-uppercase fw-semibold text-secondary small mb-3 tracking-wide">
                    <i class="bi bi-toggles me-1"></i> Liberação Seletiva de Recursos (Feature Flags)
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch p-3 bg-light rounded border">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="HasWhiteLabel"
                                   role="switch"
                                   id="switchWhiteLabel"
                                   @bind="CurrentModel.HasWhiteLabel" />
                            <label class="form-check-label fw-medium ms-2" for="switchWhiteLabel">
                                White-Label Completo
                            </label>
                            <div class="small text-muted ms-2">Permite customizar logomarca, cores e remover 'Powered-By'.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch p-3 bg-light rounded border">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="HasCustomCname"
                                   role="switch"
                                   id="switchCustomCname"
                                   @bind="CurrentModel.HasCustomCname" />
                            <label class="form-check-label fw-medium ms-2" for="switchCustomCname">
                                Domínio Personalizado (CNAME)
                            </label>
                            <div class="small text-muted ms-2">Mapeamento para domínio próprio do cliente.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch p-3 bg-light rounded border">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="HasAiCopilot"
                                   role="switch"
                                   id="switchAiCopilot"
                                   @bind="CurrentModel.HasAiCopilot" />
                            <label class="form-check-label fw-medium ms-2" for="switchAiCopilot">
                                Copiloto de Inteligência Artificial
                            </label>
                            <div class="small text-muted ms-2">Sugestões automatizadas de orçamento e otimização criativa.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch p-3 bg-light rounded border">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="HasCrossNetworkAutomations"
                                   role="switch"
                                   id="switchAutomations"
                                   @bind="CurrentModel.HasCrossNetworkAutomations" />
                            <label class="form-check-label fw-medium ms-2" for="switchAutomations">
                                Automações Cross-Network
                            </label>
                            <div class="small text-muted ms-2">Regras automáticas para Meta, Google, Bing e TikTok Ads.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <button type="button" class="btn btn-outline-secondary btn-cancel px-4" @onclick="HandleCancel">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary px-4 fw-semibold" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Salvar Plano</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    /// <summary>
    /// Modelo de dados a ser vinculado ao formulário.
    /// </summary>
    [Parameter]
    public PlanFormViewModel? Model { get; set; }

    /// <summary>
    /// Callback disparado com sucesso após persistência do plano.
    /// </summary>
    [Parameter]
    public EventCallback<PlanFormViewModel> OnSaveSuccess { get; set; }

    /// <summary>
    /// Callback disparado quando o usuário clica no botão cancelar.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private PlanFormViewModel CurrentModel { get; set; } = new();
    private bool _isSaving;
    private string? _errorMessage;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        CurrentModel = Model ?? new PlanFormViewModel();
        _errorMessage = null;
    }

    private async Task HandleSubmitAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (CurrentModel.IsEditMode)
            {
                var updateResult = await PlanService.UpdatePlanAsync(CurrentModel);
                if (updateResult.IsFailure)
                {
                    _errorMessage = updateResult.Error.Description;
                    return;
                }
            }
            else
            {
                var createResult = await PlanService.CreatePlanAsync(CurrentModel);
                if (createResult.IsFailure)
                {
                    _errorMessage = createResult.Error.Description;
                    return;
                }

                CurrentModel.PlanId = createResult.Value;
            }

            if (OnSaveSuccess.HasDelegate)
            {
                await OnSaveSuccess.InvokeAsync(CurrentModel);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
