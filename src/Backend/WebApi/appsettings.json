{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MasterDb": "Server=localhost;Database=MasterCatalog;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "DatabaseMigrations": {
    "ApplyMasterMigrationsOnStartup": false
  },
  "Email": {
    "Provider": "InMemory",
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SecureSocket": "StartTls",
    "FromEmail": "noreply@admetricspro.com.br",
    "FromDisplayName": "AdMetricsPro",
    "TimeoutSeconds": 10,
    "MaxRetryAttempts": 1
  },
  "AllowedHosts": "*"
}
