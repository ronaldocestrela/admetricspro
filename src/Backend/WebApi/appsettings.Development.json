{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Email": {
    "Provider": "InMemory",
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SecureSocket": "StartTls",
    "FromEmail": "noreply@admetricspro.com.br",
    "FromDisplayName": "AdMetricsPro",
    "TimeoutSeconds": 10,
    "MaxRetryAttempts": 1
  },
  "Tenants": {
    "Invitations": {
      "WebAppBaseUrl": "http://localhost:5001",
      "TokenValidityHours": 72
    }
  }
}
