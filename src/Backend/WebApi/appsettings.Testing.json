{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseMigrations": {
    "ApplyMasterMigrationsOnStartup": false
  },
  "Email": {
    "Provider": "InMemory",
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SecureSocket": "StartTls",
    "FromEmail": "noreply@admetricspro.com.br",
    "FromDisplayName": "AdMetricsPro",
    "TimeoutSeconds": 10,
    "MaxRetryAttempts": 1
  },
  "SocialPublishing": {
    "OAuth": {
      "StateSigningKey": "testing-social-oauth-state-signing-key-32chars!"
    }
  }
}
