# ==============================================================================
# AdMetricsPro - Variáveis de Ambiente & Informações Sensíveis (.env)
# ==============================================================================
# Copie este arquivo para '.env' na raiz do projeto e ajuste os valores conforme
# o seu ambiente local:
#   cp .env.example .env
#
# AVISO DE SEGURANÇA:
# NUNCA comite o arquivo '.env' no Git. O arquivo '.env' está registrado no .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRAESTRUTURA SQL SERVER (Docker & Conexão Local)
# ------------------------------------------------------------------------------
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!
MSSQL_PORT=1433

# Cadeia de conexão do banco Master (Catálogo central de Tenants e Governança)
ConnectionStrings__MasterDb="Server=localhost,1433;Database=MasterCatalog;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;"

# Aplicar migrações do MasterDb automaticamente no startup da WebApi (defina como true apenas após subir o SQL Server via docker compose)
DatabaseMigrations__ApplyMasterMigrationsOnStartup=false

# ------------------------------------------------------------------------------
# 2. SEGURANÇA & TOKENS JWT DE SHADOW MODE (IMPERSONAÇÃO DE TENANTS)
# ------------------------------------------------------------------------------
# Chave simétrica HMAC-SHA256 para assinatura do token de impersonação (mínimo 32 caracteres / 256 bits)
ImpersonationJwt__SecretKey="AdMetricsPro_Secret_Key_For_Tenant_Impersonation_Security_2026_Minimum_32_Chars!"
ImpersonationJwt__Issuer="AdMetricsPro.Master"
ImpersonationJwt__Audience="AdMetricsPro.Tenants"
ImpersonationJwt__DefaultExpirationMinutes=30

# ------------------------------------------------------------------------------
# 3. COMUNICAÇÃO WEBAPP (BLAZOR SERVER) -> WEBAPI (BACKEND)
# ------------------------------------------------------------------------------
# URL base onde o WebApi está escutando para chamadas HTTP tipadas do Frontend
Api__BaseUrl="https://localhost:7001"

# ------------------------------------------------------------------------------
# 4. MOTOR DE COBRANÇA & DUNNING ENGINE (BACKGROUND SERVICE)
# ------------------------------------------------------------------------------
Dunning__IsEnabled=true
Dunning__GracePeriodDays=5
Dunning__RetryIntervalHours=24

# ------------------------------------------------------------------------------
# 5. CREDENCIAIS DO SUPER ADMIN DO BACKOFFICE (IDENTITY SEED)
# ------------------------------------------------------------------------------
SuperAdmin__Email="admin@admetricspro.internal"
SuperAdmin__Password="SuperAdmin@Secure2026!"
SuperAdmin__FullName="Administrador Global AdMetricsPro"
SuperAdmin__Role="SuperAdmin"

# ------------------------------------------------------------------------------
# 6. SEGURANÇA & TOKENS JWT DO INQUILINO (TENANT AUTH)
# ------------------------------------------------------------------------------
TenantJwt__SecretKey="tenants_super_secret_jwt_key_minimum_32_characters_admetricspro_2026!"
TenantJwt__Issuer="AdMetricsPro.Tenants"
TenantJwt__Audience="AdMetricsPro.ClientApp"
TenantJwt__ExpirationMinutes=480

# ------------------------------------------------------------------------------
# 7. META ADS — SOMENTE NO BACKEND (valores reais nunca devem ser versionados)
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# Deve coincidir exatamente com a URL do navegador e com os callbacks permitidos no backend.
# Na Meta, http://localhost é permitido automaticamente no modo Em desenvolvimento.
# Para URL pública, cadastre o callback exato em URIs de redirecionamento do OAuth válidos.
META_OAUTH_REDIRECT_URI=http://localhost:7000/integrations
# Para dotnet run, use a URL real do navegador (o perfil HTTP usa 5130).
# Se houver encaminhamento de porta para 5131, autorize o endereço explicitamente:
# Integrations__OAuth__Meta__AdditionalRedirectUris__0=http://localhost:5131/integrations
Integrations__OAuth__Meta__DefaultScopes=ads_read,ads_management
# Gere uma chave aleatória própria de pelo menos 32 caracteres.
Integrations__OAuth__StateSigningKey=
# Chave aleatória AES-256 (32 bytes) em Base64. Persistir e compartilhar entre réplicas.
Integrations__OAuth__TokenEncryptionKey=
Integrations__OAuth__Meta__TimeoutSeconds=60
# Só habilitar leitura periódica após configurar credenciais e contas autorizadas.
Integrations__MetaSynchronization__Enabled=false
Integrations__MetaSynchronization__IntervalMinutes=60
Integrations__MetaSynchronization__LookbackDays=7
